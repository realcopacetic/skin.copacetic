msgctxt "#31400"
msgid "General"
msgstr "Obecné"

# /16x9/Content_Settings.xml
msgctxt "#31500"
msgid "Configure your Copacetic theme, menus and background artwork service."
msgstr "Nastavte motiv Copacetic, nabídky a službu grafiky na pozadí."

# /16x9/Content_Settings.xml
msgctxt "#31416"
msgid "Menus"
msgstr "Nabídky"

# /16x9/Content_Settings.xml
msgctxt "#31516"
msgid "Choose the shortcuts you wish to add to your home and shutdown menus"
msgstr "Vyberte zkratky, které chcete přidat do domovské nabídky a nabídky vypnutí"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31432"
msgid "Background"
msgstr "Pozadí"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31532"
msgid "Customise background slideshows, brightness and panel opacity"
msgstr "Přizpůsobte prezentace na pozadí, jas a neprůhlednost panelů"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31401"
msgid "Home"
msgstr "Domovská obrazovka"

# /16x9/Content_Settings.xml
msgctxt "#31501"
msgid "Get your home screen looking just the way you want it."
msgstr "Upravte domovskou obrazovku přesně podle svých představ."

# /16x9/Content_Settings.xml
msgctxt "#31402"
msgid "Widgets"
msgstr "Widgety"

# /16x9/Content_Settings.xml
msgctxt "#31502"
msgid "Build out your home screen with up to nine fully customisable widgets."
msgstr "Doplňte domovskou obrazovku až o devět plně přizpůsobitelných widgetů."

# /16x9/Content_Settings.xml
msgctxt "#31403"
msgid "Views"
msgstr "Zobrazení"

# /16x9/Content_Settings.xml
msgctxt "#31503"
msgid "Choose which views to enable for different parts of Kodi. Views can be customised for each individual content type from the options menu when browsing your media."
msgstr "Vyberte, která zobrazení mají být povolena v jednotlivých částech Kodi. Zobrazení lze přizpůsobit pro každý typ obsahu zvlášť z nabídky možností při procházení médií."

# /16x9/Content_Settings.xml
msgctxt "#31404"
msgid "Customisations"
msgstr "Přizpůsobení"

# /16x9/Content_Settings.xml
msgctxt "#31504"
msgid "Make Copacetic your own with tweaks that change the functionality of the skin."
msgstr "Přizpůsobte si Copacetic úpravami, které mění funkce vzhledu."

# /16x9/Content_Settings.xml
msgctxt "#31405"
msgid "Extras"
msgstr "Extra funkce"

# /16x9/Content_Settings.xml
msgctxt "#31505"
msgid "Configure exclusive Copacetic features including embedded lists, the music player widget, in-view multiart slideshows and automatic trailer playback."
msgstr "Nastavte specifické funkce Copacetic včetně vložených seznamů, widgetu hudebního přehrávače, prezentací multiart v zobrazeních a automatického přehrávání upoutávek."

# /16x9/Content_Settings.xml
msgctxt "#31406"
msgid "Experiments"
msgstr "Experimenty"

# /16x9/Content_Settings.xml
msgctxt "#31506"
msgid "New features being tested or those requested by users that don't necessarily meet the desisgn ethos of the rest of Copacetic. It's recommended to leave these off for optimal user experience."
msgstr "Nové testované funkce nebo funkce vyžádané uživateli, které nemusí nutně odpovídat celkové návrhové filozofii Copacetic. Pro optimální uživatelský zážitek se doporučuje ponechat je vypnuté."

# General
# /16x9/Content.xml
# /16x9/Variables_Labels_Media.xml
msgctxt "#31407"
msgid "Night"
msgstr "Noční"

# /16x9/Content_Settings.xml
msgctxt "#31507"
msgid "Select 'Night' or 'Light' theme. Switch between themes on the fly via the shutdown menu."
msgstr "Vyberte motiv „Noční“ nebo „Světlý“. Mezi motivy lze za běhu přepínat z nabídky vypnutí."

# /16x9/Content.xml
# /16x9/Variables_Labels_Media.xml
msgctxt "#31408"
msgid "Light"
msgstr "Světlý"

# /16x9/Content_Settings.xml
msgctxt "#31409"
msgid "Accent colour"
msgstr "Barva zvýraznění"

# /16x9/Content_Settings.xml
msgctxt "#31509"
msgid "Personalise Copacetic with your own accent colour. Where info is displayed on top of this colour, such as the episodes count icon in Grid view, Copacetic will automatically select between white and black text to maximise contrast."
msgstr "Přizpůsobte Copacetic vlastní barvou zvýraznění. Pokud se informace zobrazují nad touto barvou, například ikona počtu epizod v zobrazení Mřížka, Copacetic automaticky vybere bílý nebo černý text, aby byl kontrast co nejvyšší."

# /16x9/Content_Settings.xml
msgctxt "#31410"
msgid "Choose accent colour"
msgstr "Vybrat barvu zvýraznění"

# /16x9/Content_Settings.xml
msgctxt "#31411"
msgid "Reset accent colour"
msgstr "Obnovit barvu zvýraznění"

# /16x9/Content_Settings.xml
msgctxt "#31720"
msgid "Speed up animations and window transitions [BETA]"
msgstr "Zrychlit animace a přechody oken [BETA]"

# /16x9/Content_Settings.xml
msgctxt "#31820"
msgid "Reduces the default animation times for transitioning between windows and visibility fades. Removes delays on certain animations and disabled others entirely."
msgstr "Zkracuje výchozí časy animací při přechodech mezi okny a prolínání viditelnosti. U některých animací odstraňuje prodlevy a jiné zcela vypíná."

# /16x9/Content_Settings.xml
msgctxt "#31721"
msgid "Disable all viewtype scroll animations [BETA]"
msgstr "Vypnout všechny animace posouvání v typech zobrazení [BETA]"

# /16x9/Content_Settings.xml
msgctxt "#31821"
msgid "Further speeds up browsing by setting the scrolltime for views to 0, removing the transitionary animations when navigating between listitems."
msgstr "Dále zrychluje procházení tím, že nastaví čas posouvání zobrazení na 0 a odstraní přechodové animace při navigaci mezi položkami seznamu."

# /16x9/Content_Settings.xml
msgctxt "#31412"
msgid "Recommended Kodi settings for Copacetic"
msgstr "Doporučená nastavení Kodi pro Copacetic"

# /16x9/Content_Settings.xml
msgctxt "#31512"
msgid "Highlights the Kodi settings recommended to change for optimal Copacetic user experience. Toggle each proposed change on/off to your liking, then accept the changes you wish to keep."
msgstr "Zvýrazní nastavení Kodi, která se doporučuje změnit pro optimální používání Copacetic. Každou navrženou změnu můžete podle potřeby zapnout nebo vypnout a potom přijmout změny, které chcete zachovat."

# /16x9/Content_Settings.xml
msgctxt "#31413"
msgid "Copacetic recommends changing the following Kodi settings for optimal user experience. Disable settings if you wish to keep their current value. Faded settings are disabled and show the current value."
msgstr "Copacetic doporučuje pro optimální uživatelský zážitek změnit následující nastavení Kodi. Pokud chcete zachovat jejich současnou hodnotu, příslušná nastavení vypněte. Zašedlá nastavení jsou vypnutá a zobrazují současnou hodnotu."

# /16x9/Content_Settings.xml
msgctxt "#31414"
msgid "These will not be changed."
msgstr "Tyto položky se nezmění."

# /16x9/Content_Settings.xml
msgctxt "#31421"
msgid "Enable clearlogo cropper"
msgstr "Povolit ořezávání ClearLogo"

# /16x9/Content_Settings.xml
msgctxt "#31521"
msgid "Clearlogos cached in Kodi's texture library will be cropped as they are required. Cropped versions are saved to a separate cache. Once a cropped clearlogo is cached, performance impact should be minimal. No changes are made to the original artwork. This process is run by Copacetic as a background service. Disable to improve performance."
msgstr "Položky ClearLogo uložené v knihovně textur Kodi se budou podle potřeby ořezávat. Oříznuté verze se ukládají do samostatné mezipaměti. Jakmile je oříznuté ClearLogo uloženo do mezipaměti, dopad na výkon by měl být minimální. Původní grafika se nijak nemění. Tento proces spouští Copacetic jako službu na pozadí. Vypnutím zlepšíte výkon."

# /16x9/Content_Settings.xml
msgctxt "#31422"
msgid "Clear cache"
msgstr "Vymazat mezipaměť"

# /16x9/Content_Settings.xml
msgctxt "#31522"
msgid "This will delete the cropped clearlogo cache. To prevent cropped clearlogos from being cached, make sure to disable the clearlogo cropping background service above."
msgstr "Tím se odstraní mezipaměť oříznutých verzí ClearLogo. Pokud chcete zabránit ukládání oříznutých verzí ClearLogo do mezipaměti, vypněte výše uvedenou službu ořezávání ClearLogo na pozadí."

# /16x9/Content_Settings.xml
msgctxt "#31423"
msgid "Colourise media flags"
msgstr "Obarvit mediální příznaky"

# /16x9/Content_Settings.xml
msgctxt "#31523"
msgid "Media flags are colourised using the dominant colour from the processed clearlogo. The dominant colour will be used as long as there is enough contrast with the current background colour. You can adjust the contrast thresholds for dark and light backgrounds below."
msgstr "Příznaky médií se obarvují pomocí dominantní barvy ze zpracovaného ClearLogo. Dominantní barva se použije, pokud má dostatečný kontrast vůči aktuální barvě pozadí. Prahové hodnoty kontrastu pro tmavá a světlá pozadí můžete upravit níže."

# /16x9/Content_Settings.xml
msgctxt "#31424"
msgid "Adjust colour contrast thresholds"
msgstr "Upravit prahové hodnoty barevného kontrastu"

# /16x9/Content_Settings.xml
msgctxt "#31524"
msgid "Adjust the amount of contrast required between the background and the flag colour. Raising the bottom threshold means only lighter colours will be accepted on dark backgrounds. Lowering the top threshold means only darker colours can be used on light backgrounds. Avoids dark flags on dark backgrounds or light flags on light backgrounds. Default range: 65 - 440."
msgstr "Upravte požadovanou míru kontrastu mezi pozadím a barvou příznaku. Zvýšení spodní prahové hodnoty znamená, že na tmavých pozadích budou přijaty pouze světlejší barvy. Snížení horní prahové hodnoty znamená, že na světlých pozadích lze použít pouze tmavší barvy. Tím se zabrání tmavým příznakům médií na tmavém pozadí nebo světlým příznakům médií na světlém pozadí. Výchozí rozsah: 65 - 440."

# /16x9/Content_Settings.xml
msgctxt "#31428"
msgid "Prefer keyart for poster views on info screens and dialogs"
msgstr "Preferovat keyart v plakátových zobrazeních na informačních obrazovkách a v dialozích"

# /16x9/Content_Settings.xml
msgctxt "#31700"
msgid "Prefer landscape art for fanart views on info screens and dialogs"
msgstr "Preferovat landscape v zobrazeních fanartu na informačních obrazovkách a v dialogových oknech"

# /16x9/Content_Settings.xml
msgctxt "#31417"
msgid "Home menu"
msgstr "Domovská nabídka"

# /16x9/Content_Settings.xml
msgctxt "#31517"
msgid "Configure your home menu shortcuts. For each shortcut, you can select an optional background to override the default slideshows."
msgstr "Nastavte zkratky domovské nabídky. U každé zkratky můžete vybrat volitelné pozadí, které přepíše výchozí prezentace."

# /16x9/Content_Settings.xml
msgctxt "#31418"
msgid "Shutdown menu"
msgstr "Nabídka vypnutí"

# /16x9/Content_Settings.xml
msgctxt "#31518"
msgid "Configure your shutdown menu shortcuts. Context-dependent 'Home', 'Theme' and 'Settings' shortcuts cannot be removed."
msgstr "Nastavte zkratky nabídky vypnutí. Kontextové zkratky „Domovská obrazovka“, „Motiv“ a „Nastavení“ nelze odebrat."

# /16x9/Content_Settings.xml
msgctxt "#31492"
msgid "Enable home shortcut in Shutdown menu"
msgstr "Povolit zkratku domovské obrazovky v nabídce vypnutí"

# /16x9/Content_Settings.xml
msgctxt "#31493"
msgid "Enable theme switcher shortcut in Shutdown menu"
msgstr "Povolit zkratku pro přepínání motivů v nabídce vypnutí"

# /16x9/Content_Settings.xml
msgctxt "#31494"
msgid "Enable LibreELEC menu shortcut in Shutdown menu"
msgstr "Povolit zkratku nabídky LibreELEC v nabídce vypnutí"

# /16x9/Content_Settings.xml
msgctxt "#31419"
msgid "Reset all menus"
msgstr "Obnovit všechny nabídky"

# /16x9/Content_Settings.xml
msgctxt "#31425"
msgid "Global"
msgstr "Globální"

# /16x9/Content_Settings.xml
msgctxt "#31426"
msgid "Limit background slideshow artwork to..."
msgstr "Omezit grafiku prezentace na pozadí na..."

# /16x9/Content_Settings.xml
msgctxt "#31526"
msgid "Choose to include only fanarts from the selected sections of your library in the background slideshow, or select a custom path, playlist or folder of images."
msgstr "Vyberte, zda se mají do prezentace na pozadí zahrnout pouze fanarty z vybraných částí knihovny, nebo vyberte vlastní cestu, seznam médií či složku obrázků."

# /16x9/Content_Settings.xml
msgctxt "#31436"
msgid "Movies / TV shows / Artists"
msgstr "Filmy / seriály / interpreti"

# /16x9/Content_Settings.xml
msgctxt "#31437"
msgid "Movies / TV shows"
msgstr "Filmy / seriály"

# /16x9/Content_Settings.xml
msgctxt "#31438"
msgid "Custom source"
msgstr "Vlastní zdroj"

# /16x9/Content_Settings.xml
msgctxt "#31439"
msgid "Choose path or playlist..."
msgstr "Vybrat cestu nebo seznam médií..."

# /16x9/Content_Settings.xml
msgctxt "#31427"
msgid "Background slideshow speed"
msgstr "Rychlost prezentace na pozadí"

# /16x9/Content_Settings.xml
msgctxt "#31732"
msgid "seconds"
msgstr "sekund"

# /16x9/Content_Settings.xml
msgctxt "#31733"
msgid "minutes"
msgstr "minut"

# /16x9/Content_Settings.xml
msgctxt "#31527"
msgid "Choose how quickly artwork in the slideshow should be refreshed. Default: 10 seconds"
msgstr "Vyberte, jak rychle se má grafika v prezentaci obnovovat. Výchozí hodnota: 10 sekund"

# /16x9/Content_Settings.xml
msgctxt "#31440"
msgid "Background slideshow artwork brightness (%)"
msgstr "Jas grafiky prezentace na pozadí (%)"

# /16x9/Content_Settings.xml
msgctxt "#31540"
msgid "Choose the brightness of backgrounds displayed on the home screen and other windows such as Settings and Add-ons. Default: 33%"
msgstr "Vyberte jas pozadí zobrazovaných na domovské obrazovce a v dalších oknech, například Nastavení a Doplňky. Výchozí hodnota: 33 %"

# /16x9/Content_Settings.xml
msgctxt "#31487"
msgid "Opacity of background panels (%)"
msgstr "Neprůhlednost panelů na pozadí (%)"

# /16x9/Content_Settings.xml
msgctxt "#31587"
msgid "Adjust the opacity of background panels that appear on top of artwork. Default: 75%"
msgstr "Upravte neprůhlednost panelů na pozadí, které se zobrazují nad grafikou. Výchozí hodnota: 75 %"

# /16x9/Content_Settings.xml
msgctxt "#31722"
msgid "Info screen background artwork brightness (%)"
msgstr "Jas grafiky pozadí informační obrazovky (%)"

# /16x9/Content_Settings.xml
msgctxt "#31822"
msgid "Choose the brightness of background artwork displayed when you bring up info for a list item. Default: 25%"
msgstr "Vyberte jas grafiky pozadí zobrazované při otevření informací o položce seznamu. Výchozí hodnota: 25 %"

# /16x9/Content_Settings.xml
msgctxt "#31723"
msgid "Library/Playback"
msgstr "Knihovna / přehrávání"

# /16x9/Content_Settings.xml
msgctxt "#31719"
msgid "OSD background brightness during video playback (%)"
msgstr "Jas pozadí OSD při přehrávání videa (%)"

# /16x9/Content_Settings.xml
msgctxt "#31819"
msgid "Adjust the brightness of videos when OSD controls or settings screens are visible on top. Default: 25%"
msgstr "Upravte jas videa, když jsou nad ním zobrazené ovládací prvky OSD nebo obrazovky nastavení. Výchozí hodnota: 25 %"

# /16x9/Content_Settings.xml
msgctxt "#31495"
msgid "Show the name of the current displayed background"
msgstr "Zobrazit název aktuálně zobrazeného pozadí"

# /16x9/Content_Settings.xml
msgctxt "#31433"
msgid "Override home background with global slideshow"
msgstr "Přepsat pozadí domovské obrazovky globální prezentací"

# /16x9/Content_Settings.xml
msgctxt "#31533"
msgid "Use the selected global slideshow on the homescreen instead of local or skin.shortcuts slideshows"
msgstr "Použít na domovské obrazovce vybranou globální prezentaci místo místních prezentací nebo prezentací ze Skin Shortcuts"

# /16x9/Content_Settings.xml
msgctxt "#31429"
msgid "Enable widgets on the home screen"
msgstr "Povolit widgety na domovské obrazovce"

# /16x9/Content_Settings.xml
msgctxt "#31529"
msgid "Add widgets to your homescreen. To configure, go to the Widgets tab in the left menu. Choose from preset widgets, such as 'Continue watching', 'Next up' and 'Liked songs', or configure your own using any plugin source. Then select the view and display type you want to use for each widget. For custom widgets, you can also set the name, sort method and limit."
msgstr "Přidejte widgety na domovskou obrazovku. Nastavení provedete na kartě Widgety v levé nabídce. Vyberte z přednastavených widgetů, například „Pokračovat ve sledování“, „Další na řadě“ a „Oblíbené skladby“, nebo si nakonfigurujte vlastní pomocí zdroje z libovolného pluginu. Poté vyberte zobrazení a způsob zobrazení, které chcete pro každý widget použít. U vlastních widgetů můžete nastavit také název, způsob řazení a limit."

# /16x9/Content_Settings.xml
msgctxt "#31430"
msgid "Reset home screen widgets"
msgstr "Obnovit widgety domovské obrazovky"

# /16x9/Content_Settings.xml
msgctxt "#31530"
msgid "Reset home widgets to Copacetic defaults: 1. Continue watching 2. Next up 3. Latest movies 4. Latest TV shows"
msgstr "Obnovit domovské widgety na výchozí hodnoty Copacetic: 1. Pokračovat ve sledování 2. Další na řadě 3. Nejnovější filmy 4. Nejnovější seriály"

# /16x9/Content_Settings.xml
msgctxt "#31431"
msgid "Are you sure you want to reset all home widgets back to default?"
msgstr "Opravdu chcete obnovit všechny domovské widgety do výchozího stavu?"

# /16x9/Content_Settings.xml
msgctxt "#31704"
msgid "Enable global search on the home screen"
msgstr "Povolit globální hledání na domovské obrazovce"

# /16x9/Content_Settings.xml
msgctxt "#31705"
msgid "Configure global search"
msgstr "Nastavit globální hledání"

# /16x9/Content_Settings.xml
msgctxt "#31706"
msgid "Enable global search for this media type"
msgstr "Povolit globální hledání pro tento typ médií"

# /16x9/Content_Settings.xml
msgctxt "#31707"
msgid "Include 'plot' field in this search"
msgstr "Zahrnout do tohoto hledání pole „děj“"

# /16x9/Content_Settings.xml
msgctxt "#31708"
msgid "Include 'tag' field in this search"
msgstr "Zahrnout do tohoto hledání pole „štítek“"

# /16x9/Content_Settings.xml
msgctxt "#31709"
msgid "Include 'biography' field in this search"
msgstr "Zahrnout do tohoto hledání pole „biografie“"

# /16x9/Content_Settings.xml
msgctxt "#31710"
msgid "Include 'review' field in this search"
msgstr "Zahrnout do tohoto hledání pole „recenze“"

# /16x9/Content_Settings.xml
msgctxt "#31442"
msgid "Enable screensaver"
msgstr "Povolit spořič obrazovky"

# /16x9/Content_Settings.xml
msgctxt "#31542"
msgid "After 10 seconds of inactivity, the home menu will be hidden, allowing the background artwork slideshow to run as a screensaver."
msgstr "Po 10 sekundách nečinnosti se domovská nabídka skryje, takže prezentace grafiky na pozadí může běžet jako spořič obrazovky."

# /16x9/Content_Settings.xml
msgctxt "#31443"
msgid "Show clearlogos"
msgstr "Zobrazit ClearLogo"

# /16x9/Content_Settings.xml
msgctxt "#31543"
msgid "Clearlogos will be displayed as part of the screensaver when they are available."
msgstr "Pokud jsou dostupná ClearLogo, budou se zobrazovat jako součást spořiče obrazovky."

# /16x9/Content_Settings.xml
msgctxt "#31444"
msgid "Furniture to include"
msgstr "Zahrnout prvky rozhraní"

# /16x9/Content_Settings.xml
msgctxt "#31544"
msgid "Choose the furniture you wish to show in the top-right corner of the home screen. Note that for weather information to be included, you must first install a weather add-on and ensure it is enabled under Settings > Services > Weather."
msgstr "Vyberte prvky rozhraní, které chcete zobrazovat v pravém horním rohu domovské obrazovky. Aby bylo možné zahrnout informace o počasí, musíte nejprve nainstalovat doplněk počasí a ujistit se, že je povolený v části Nastavení > Služby > Počasí."

# /16x9/Content_Settings.xml
msgctxt "#31724"
msgid "Clock"
msgstr "Hodiny"

# /16x9/Content_Settings.xml
msgctxt "#31725"
msgid "None"
msgstr "Žádné"

# /16x9/Content_Settings.xml
msgctxt "#31726"
msgid "Clock and date"
msgstr "Hodiny a datum"

# /16x9/Content_Settings.xml
msgctxt "#31727"
msgid "Clock, date and weather"
msgstr "Hodiny, datum a počasí"

# /16x9/Content_Settings.xml
msgctxt "#31728"
msgid "Make persistent across entire home screen, including widgets"
msgstr "Zachovat trvale na celé domovské obrazovce včetně widgetů"

# /16x9/Content_Settings.xml
msgctxt "#31729"
msgid "Enable second background slideshow"
msgstr "Povolit druhou prezentaci pozadí"

# /16x9/Content_Settings.xml
msgctxt "#31730"
msgid "Limit second background slideshow to..."
msgstr "Omezit druhou prezentaci pozadí na..."

# /16x9/Content_Settings.xml
msgctxt "#31731"
msgid "Start times"
msgstr "Časy spuštění"

# Widgets
# /16x9/Content_Settings.xml
msgctxt "#31445"
msgid "Widget"
msgstr "Widget"

# /16x9/Content_Settings.xml
msgctxt "#31489"
msgid "Configure widgets"
msgstr "Nastavit widgety"

# /16x9/Content_Settings.xml
msgctxt "#31701"
msgid "Movement"
msgstr "Pohyb"

# /16x9/Content_Settings.xml
msgctxt "#31496"
msgid "Spotlight content with auto scroll"
msgstr "Obsah Spotlight s automatickým posouváním"

# /16x9/Content_Settings.xml
msgctxt "#31596"
msgid "Widget will move forward one place every 10 seconds while system is idle. When combined with trailer autoplay option below to allow for each item's trailer to be played automatically as soon as the previous trailer is finished while system is idle."
msgstr "Když je systém nečinný, widget se každých 10 sekund posune o jednu položku vpřed. V kombinaci s níže uvedenou volbou automatického přehrávání upoutávek to umožní automaticky přehrát upoutávku každé položky hned po dokončení předchozí upoutávky, dokud je systém nečinný."

# /16x9/Content_Settings.xml
msgctxt "#31467"
msgid "Automatically play trailers for movies or tv shows in this widget"
msgstr "Automaticky přehrávat upoutávky k filmům nebo seriálům v tomto widgetu"

# /16x9/Content_Settings.xml
msgctxt "#31567"
msgid "Trailers will be played back automatically from any widgets showing movies or tv shows. Enable 'Spotlight content with auto scroll' option above to create a dynamic playlist of trailers for all items in the widget. Set delay in seconds before trailer playback starts under Extras > Trailer autoplay"
msgstr "Upoutávky se budou automaticky přehrávat z libovolných widgetů, které zobrazují filmy nebo seriály. Povolením výše uvedené volby „Obsah Spotlight s automatickým posouváním“ vytvoříte dynamický seznam upoutávek pro všechny položky ve widgetu. Prodlevu před zahájením přehrávání upoutávky nastavíte v části Extra funkce > Automatické přehrávání upoutávek."

# /16x9/Variables_Labels_Media.xml
msgctxt "#31476"
msgid "Enable clearlogos"
msgstr "Povolit ClearLogo"

# /16x9/Content_Settings.xml
msgctxt "#31498"
msgid "Prefer keyart for poster views"
msgstr "Preferovat keyart v plakátových zobrazeních"

# /16x9/Content_Settings.xml
msgctxt "#31598"
msgid "Remember 'keyart' is a custom art type. To ensure it is fetched locally or remotely by scrapers, make sure 'keyart' is included in your art type whitelists for movies and / or tv shows. You can do this by choosing 'Recommended Kodi Settings' under Copacetic > General, or by navigating to Settings > Media > Videos > Artwork."
msgstr "Nezapomeňte, že „keyart“ je vlastní typ grafiky. Aby ho zdroje informací mohly získávat z místních nebo vzdálených zdrojů, ujistěte se, že je „keyart“ zahrnutý v seznamech povolených typů grafiky pro filmy a/nebo seriály. To můžete provést výběrem položky „Doporučená nastavení Kodi pro Copacetic“ v části Copacetic > Obecné, nebo přechodem do části Nastavení > Média > Videa > Grafika."

# /16x9/Content_Settings.xml
msgctxt "#31499"
msgid "Prefer landscape art for fanart views"
msgstr "Preferovat landscape v zobrazeních fanartu"

# /16x9/Content_Settings.xml
msgctxt "#31599"
msgid "Remember 'landscape' is a custom art type. To ensure it is fetched locally or remotely by scrapers, make sure 'landscape' is included in your art type whitelists for movies and / or tv shows. You can do this by choosing 'Recommended Kodi Settings' under Copacetic > General, or by navigating to Settings > Media > Videos > Artwork."
msgstr "Nezapomeňte, že „landscape“ je vlastní typ grafiky. Aby ho zdroje informací mohly získávat z místních nebo vzdálených zdrojů, ujistěte se, že je „landscape“ zahrnutý v seznamech povolených typů grafiky pro filmy a/nebo seriály. To můžete provést výběrem položky „Doporučená nastavení Kodi pro Copacetic“ v části Copacetic > Obecné, nebo přechodem do části Nastavení > Média > Videa > Grafika."

# /16x9/Content_Settings.xml
msgctxt "#31477"
msgid "Prefer thumbnails for episodes instead of tv show fanart"
msgstr "Preferovat miniatury epizod místo fanartu seriálu"

# Views
# /16x9/Content_Settings.xml
msgctxt "#31475"
msgid "Kiosk mode"
msgstr "Režim kiosku"

# /16x9/Content_Settings.xml
msgctxt "#31575"
msgid "When kiosk mode is enabled, all view customisation options in the hidden menu will be removed so no further changes can be made."
msgstr "Když je zapnutý režim kiosku, ze skryté nabídky se odstraní všechny možnosti přizpůsobení zobrazení, takže nebude možné provádět další změny."

# /16x9/Content_Settings.xml
msgctxt "#31486"
msgid "Disable hidden options menu"
msgstr "Zakázat skrytou nabídku možností"

# /16x9/Content_Settings.xml
msgctxt "#31586"
msgid "With koisk mode enabled, you have the option to completely disable the hidden options menu. Warning: This will limit your ability to switch between views, change sort method, filter or search."
msgstr "Při zapnutém režimu kiosku můžete skrytou nabídku možností úplně zakázat. Upozornění: Omezí to možnost přepínat mezi zobrazeními, měnit způsob řazení, filtrovat nebo vyhledávat."

# /16x9/Content_Settings.xml
msgctxt "#31488"
msgid "Add shutdown menu shortcut to hidden views menu"
msgstr "Přidat zkratku nabídky vypnutí do skryté nabídky zobrazení"

# /16x9/Content_Settings.xml
msgctxt "#31441"
msgid "Add movement to fullscreen artwork"
msgstr "Přidat pohyb grafice na celé obrazovce"

# /16x9/Content_Settings.xml
msgctxt "#31541"
msgid "Adds a subtle 'Ken Burns effect'-style pan and zoom to the fullscreen background artwork."
msgstr "Přidá ke grafice na pozadí v režimu celé obrazovky jemný posun a přiblížení ve stylu efektu Kena Burnse."

# Views
# /16x9/Content_Settings.xml
msgctxt "#31446"
msgid "Enable view for video and music windows"
msgstr "Povolit zobrazení v oknech videí a hudby"

# /16x9/Content_Settings.xml
msgctxt "#31546"
msgid "Choose which windows to enable for each of the four additional Copacetic views. Keep any views you don't use disabled to speed up loading when a new media window is opened in Kodi."
msgstr "Vyberte, ve kterých oknech se mají povolit jednotlivá ze čtyř dodatečných zobrazení Copacetic. Zobrazení, která nepoužíváte, ponechte zakázaná, aby se při otevření nového okna médií v Kodi urychlilo načítání."

# /16x9/Content_Settings.xml
msgctxt "#31717"
msgid "Enable scrolling on long titles instead of truncation (...)"
msgstr "Povolit posouvání dlouhých názvů místo zkracování (...)"

# /16x9/Content_Settings.xml
msgctxt "#31447"
msgid "Enable view for add-on and program windows"
msgstr "Povolit zobrazení v oknech doplňků a programů"

# /16x9/Content_Settings.xml
msgctxt "#31734"
msgid "Enable view for favourites browser"
msgstr "Povolit zobrazení v prohlížeči oblíbených položek"

# /16x9/Content_Settings.xml
msgctxt "#31448"
msgid "Enable view for pictures window"
msgstr "Povolit zobrazení v okně obrázků"

# /16x9/Content_Settings.xml
msgctxt "#31715"
msgid "Item artwork size and orientation"
msgstr "Velikost a orientace grafiky položek"

# /16x9/Content_Settings.xml
msgctxt "#31815"
msgid "Choose how big you wish items to be presented in Grid panel views and whether you wish to scroll vertically or horizontally. For Fanart views, 'Horizontal large' displays 3 items per row and 'Horizontal small' displays 4. For Poster and Square views, 'Horizontal large' displays 5 items per row and 'Horizontal small' displays 7. 'Vertical' displays two rows at all times."
msgstr "Vyberte, jak velké mají být položky v panelových zobrazeních Mřížka a zda se má posouvat svisle nebo vodorovně. V zobrazeních „Fanart“ zobrazí „Vodorovné velké“ tři položky na řádek a „Vodorovné malé“ 4. V zobrazeních „Plakát“ a „Čtvercové“ zobrazí „Vodorovné velké“ pět položek na řádek a „Vodorovné malé“ 7. „Svislé“ vždy zobrazuje dva řádky."

# /16x9/Content_Settings.xml
msgctxt "#31449"
msgid "Dim artwork for watched items or disabled add-ons"
msgstr "Ztlumit grafiku zhlédnutých položek nebo zakázaných doplňků"

# /16x9/Content_Settings.xml
msgctxt "#31450"
msgid "Checkmarks for watched items or enabled add-ons"
msgstr "Zatržítka u zhlédnutých položek nebo povolených doplňků"

# Customisations
# /16x9/Content_Settings.xml
msgctxt "#31451"
msgid "Show unwatched episodes count"
msgstr "Zobrazit počet nezhlédnutých epizod"

# /16x9/Content_Settings.xml
msgctxt "#31551"
msgid "Display the total number of unwatched episodes for a tv show or season on top of the progress bar."
msgstr "Zobrazí celkový počet nezhlédnutých epizod seriálu nebo řady nad ukazatelem průběhu."

# /16x9/Content_Settings.xml
# /16x9/Variables_Labels_Windows.xml
msgctxt "#31452"
msgid "Preferred classification ratings"
msgstr "Preferovaná věková hodnocení"

# /16x9/Content_Settings.xml
msgctxt "#31552"
msgid "Choose the classification system to use when displaying age rating flags. If your preferred classication system is not present, please request it on the forum."
msgstr "Vyberte klasifikační systém, který se má používat při zobrazování příznaků věkového hodnocení. Pokud požadovaný klasifikační systém není k dispozici, požádejte o něj na fóru."

# /16x9/Content_Settings.xml
msgctxt "#31453"
msgid "Scroll by sort letter"
msgstr "Posouvat podle písmene řazení"

# /16x9/Content_Settings.xml
msgctxt "#31553"
msgid "When enabled, press down on horizontal scrollbars and right on vertical scrollbars to scroll by sort letter/number. This is dependent on the sort method currently selected. You can scroll by Name, File, Artist, Artist/Year, Album, Title, Original title, Rating, User rating, Play count, Number of discs, Duration, Appearances."
msgstr "Pokud je tato volba zapnutá, stisknutím šipky dolů na vodorovných posuvnících a šipky doprava na svislých posuvnících můžete posouvat podle písmene nebo čísla řazení. Závisí to na aktuálně vybraném způsobu řazení. Posouvat lze podle názvu, souboru, interpreta, interpreta/roku, alba, titulu, původního titulu, hodnocení, uživatelského hodnocení, počtu přehrání, počtu disků, délky a počtu výskytů."

# /16x9/Content_Settings.xml
msgctxt "#31454"
msgid "Liked song rating threshold"
msgstr "Práh hodnocení pro oblíbené skladby"

# /16x9/Content_Settings.xml
msgctxt "#31716"
msgid "Prefer white to grey text colour for plot in Showcase and Strip views"
msgstr "Preferovat bílou barvu textu děje před šedou ve zobrazeních Showcase a Pás"

# /16x9/Content_Settings.xml
msgctxt "#31554"
msgid "Overlay a binary user rating system (liked or not) on top of standard song user ratings. User ratings equal to or above this threshold are 'liked'. You can 'like' (set a user rating equivalent to the threshold) or 'unlike' (clear user rating) a song via the context menu, or embedded music player if enabled under Extras. The threshold will also be used by the 'Liked songs' widget. Set to 'Off' to disable."
msgstr "Doplní ke standardním uživatelským hodnocením skladeb binární systém hodnocení (oblíbené / neoblíbené). Uživatelská hodnocení rovná této prahové hodnotě nebo vyšší se považují za „oblíbené“. Skladbu můžete označit jako oblíbenou (nastavit uživatelské hodnocení odpovídající prahové hodnotě) nebo toto označení zrušit (vymazat uživatelské hodnocení) z kontextové nabídky, případně z vloženého hudebního přehrávače, pokud je povolený v části Extra funkce. Prahovou hodnotu bude používat také widget „Oblíbené skladby“. Hodnotou „Vypnuto“ tuto funkci zakážete."

# /16x9/Content_Settings.xml
msgctxt "#31484"
msgid "Info screens"
msgstr "Informační obrazovky"

# /16x9/Content_Settings.xml
msgctxt "#31703"
msgid "Use TMDbHelper for info screen widgets instead of library content"
msgstr "Pro widgety informační obrazovky používat TMDbHelper místo obsahu knihovny"

# /16x9/Content_Settings.xml
msgctxt "#31803"
msgid "As long as this plugin is enabled on your system, it will be used to populate info screen widgets including actor and director credits, similar movies/shows and more."
msgstr "Pokud je tento doplněk v systému povolený, použije se k naplnění widgetů informační obrazovky, včetně údajů o hercích a režisérech, podobných filmů či seriálů a dalších položek."

# /16x9/Content_Settings.xml
msgctxt "#31485"
msgid "Disable star ratings"
msgstr "Zakázat hvězdičková hodnocení"

# /16x9/Content_Settings.xml
msgctxt "#31478"
msgid "Video player"
msgstr "Videopřehrávač"

# /16x9/Content_Settings.xml
msgctxt "#31711"
msgid "Limit quick subtitle switcher in video OSD to a preferred language"
msgstr "Omezit rychlý přepínač titulků v OSD videa na preferovaný jazyk"

# /16x9/Content_Settings.xml
msgctxt "#31811"
msgid "Enter the three-letter code of your preferred language, e.g. 'eng' for English. If subtitles in this language are available for the currently playing video, the quick subtitle switcher will toggle on/off for the first subtitle stream in this language, ignoring other streams. If the language is not available, it will toggle between all streams as normal."
msgstr "Zadejte třípísmenný kód preferovaného jazyka, např. „eng“ pro angličtinu. Pokud jsou pro právě přehrávané video dostupné titulky v tomto jazyce, rychlý přepínač titulků bude zapínat a vypínat první stopu titulků v tomto jazyce a ignorovat ostatní stopy. Pokud jazyk dostupný není, bude jako obvykle přepínat mezi všemi stopami."

# /16x9/Content_Settings.xml
msgctxt "#31713"
msgid "Disable video information being displayed at the start of playback"
msgstr "Zakázat zobrazování informací o videu při zahájení přehrávání"

# /16x9/Content_Settings.xml
msgctxt "#31718"
msgid "Prefer time remaining to video duration in player seek bar"
msgstr "Na posuvníku přehrávače preferovat zbývající čas před délkou videa"

# /16x9/Content_Settings.xml
msgctxt "#31813"
msgid "This disables the label that appears upon video playback showing information about the video including end time, resolution and age rating."
msgstr "Tím se zakáže popisek, který se zobrazí při spuštění přehrávání videa a obsahuje informace o videu včetně času konce, rozlišení a věkového hodnocení."

# /16x9/Content_Settings.xml
msgctxt "#31490"
msgid "Enable Up Next widget during playback"
msgstr "Povolit widget Up Next během přehrávání"

# /16x9/Content_Settings.xml
msgctxt "#31590"
msgid "Up Next is a third-party addon that enabled Netflix-style autoplay of the next episode with an 'Are you still watching' prompt. Selecting this option will install and enable the addon, which can be configured under Add-ons."
msgstr "Up Next je doplněk třetí strany, který umožňuje automatické přehrávání další epizody ve stylu Netflixu s dotazem „Stále sledujete?“. Výběrem této volby se doplněk nainstaluje a povolí. Nastavit ho lze v části Doplňky."

# /16x9/Content_Settings.xml
msgctxt "#31491"
msgid "Choose artwork type to display in Up Next widget"
msgstr "Vybrat typ grafiky zobrazený ve widgetu Up Next"

# /16x9/Content_Settings.xml
msgctxt "#31591"
msgid "Choose between different layout options for the Up Next widget that will appear on the screen as an episode concludes."
msgstr "Vyberte z různých možností rozvržení widgetu Up Next, který se zobrazí na obrazovce při konci epizody."

# /16x9/Content_Settings.xml
msgctxt "#31455"
msgid "Instantly hide progress bar on pause screen"
msgstr "Na obrazovce pozastavení okamžitě skrýt ukazatel průběhu"

# /16x9/Content_Settings.xml
msgctxt "#31555"
msgid "Subtitles will not be obscured when video playback is paused."
msgstr "Při pozastavení přehrávání videa nebudou titulky zakryté."

# /16x9/Content_Settings.xml
msgctxt "#31456"
msgid "Show info on pause screen"
msgstr "Zobrazit informace na obrazovce pozastavení"

# /16x9/Content_Settings.xml
msgctxt "#31556"
msgid "Video information, which can be displayed during fullscreen video playback by pressing <i>, will also be displayed automatically when the video is paused."
msgstr "Informace o videu, které lze během přehrávání videa na celé obrazovce zobrazit stisknutím <i>, se automaticky zobrazí také při pozastavení videa."

# /16x9/Content_Settings.xml
msgctxt "#31479"
msgid "Music player"
msgstr "Hudební přehrávač"

# /16x9/Content_Settings.xml
msgctxt "#31480"
msgid "Enable background fanart"
msgstr "Povolit fanart na pozadí"

# /16x9/Content_Settings.xml
msgctxt "#31481"
msgid "Visualisation screen album cover"
msgstr "Obal alba na obrazovce vizualizace"

# /16x9/Content_Settings.xml
msgctxt "#31829"
msgid "Large"
msgstr "Velké"

# /16x9/Content_Settings.xml
