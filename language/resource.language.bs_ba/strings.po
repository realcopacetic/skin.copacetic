# /16x9/Content_Settings.xml
msgctxt "#31400"
msgid "General"
msgstr "Opšte"

# /16x9/Content_Settings.xml
msgctxt "#31500"
msgid "Configure your Copacetic theme, menus and background artwork service."
msgstr "Konfigurišite svoju Copacetic temu, menije i uslugu pozadinskih grafika."

# /16x9/Content_Settings.xml
msgctxt "#31416"
msgid "Menus"
msgstr "Izbornici"

# /16x9/Content_Settings.xml
msgctxt "#31516"
msgid "Choose the shortcuts you wish to add to your home and shutdown menus"
msgstr "Odaberite prečice koje želite dodati u početni meni i meni za isključivanje"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31432"
msgid "Background"
msgstr "Pozadina"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31532"
msgid "Customise background slideshows, brightness and panel opacity"
msgstr "Prilagodite pozadinske slajdove, svjetlinu i neprozirnost panela"

# /16x9/Content_Settings.xml
# /16x9/Content.xml
msgctxt "#31401"
msgid "Home"
msgstr "Početna"

# /16x9/Content_Settings.xml
msgctxt "#31501"
msgid "Get your home screen looking just the way you want it."
msgstr "Neka vaš početni ekran izgleda baš onako kako želite."

# /16x9/Content_Settings.xml
msgctxt "#31402"
msgid "Widgets"
msgstr "Vidžeti"

# /16x9/Content_Settings.xml
msgctxt "#31502"
msgid "Build out your home screen with up to nine fully customisable widgets."
msgstr "Izgradite svoj početni ekran sa do devet potpuno prilagodljivih widgeta."

# /16x9/Content_Settings.xml
msgctxt "#31403"
msgid "Views"
msgstr "Pregledi"

# /16x9/Content_Settings.xml
msgctxt "#31503"
msgid "Choose which views to enable for different parts of Kodi. Views can be customised for each individual content type from the options menu when browsing your media."
msgstr "Odaberite koje prikaze želite omogućiti za različite dijelove Kodija. Prikazi se mogu prilagoditi za svaku pojedinačnu vrstu sadržaja iz menija opcija prilikom pregledavanja medija."

# /16x9/Content_Settings.xml
msgctxt "#31404"
msgid "Customisations"
msgstr "Prilagođavanja"

# /16x9/Content_Settings.xml
msgctxt "#31504"
msgid "Make Copacetic your own with tweaks that change the functionality of the skin."
msgstr "Prilagodite Copacetic svojim potrebama pomoću podešavanja koja mijenjaju funkcionalnost skina."

# /16x9/Content_Settings.xml
msgctxt "#31405"
msgid "Extras"
msgstr "Dodaci"

# /16x9/Content_Settings.xml
msgctxt "#31505"
msgid "Configure exclusive Copacetic features including embedded lists, the music player widget, in-view multiart slideshows and automatic trailer playback."
msgstr "Konfigurišite ekskluzivne Copacetic funkcije, uključujući ugrađene liste, widget za muzički plejer, višestruke slajdove u prikazu i automatsku reprodukciju najava."

# /16x9/Content_Settings.xml
msgctxt "#31406"
msgid "Experiments"
msgstr "Eksperimenti"

# /16x9/Content_Settings.xml
msgctxt "#31506"
msgid "New features being tested or those requested by users that don't necessarily meet the desisgn ethos of the rest of Copacetic. It's recommended to leave these off for optimal user experience."
msgstr "Nove funkcije koje se testiraju ili one koje su korisnici zatražili, a koje ne moraju nužno odgovarati dizajnerskim principima ostatka Copacetica. Preporučuje se da ih isključite radi optimalnog korisničkog iskustva."

# General
# /16x9/Content.xml
# /16x9/Variables_Labels_Media.xml
msgctxt "#31407"
msgid "Night"
msgstr "Noć"

# /16x9/Content_Settings.xml
msgctxt "#31507"
msgid "Select 'Night' or 'Light' theme. Switch between themes on the fly via the shutdown menu."
msgstr "Odaberite temu 'Noć' ili 'Svjetlo'. Prebacujte se između tema u hodu putem menija za isključivanje."

# /16x9/Content.xml
# /16x9/Variables_Labels_Media.xml
msgctxt "#31408"
msgid "Light"
msgstr "Svijetlo"

# /16x9/Content_Settings.xml
msgctxt "#31409"
msgid "Accent colour"
msgstr "Akcentna boja"

# /16x9/Content_Settings.xml
msgctxt "#31509"
msgid "Personalise Copacetic with your own accent colour. Where info is displayed on top of this colour, such as the episodes count icon in Grid view, Copacetic will automatically select between white and black text to maximise contrast."
msgstr "Personalizirajte Copacetic vlastitom akcentnom bojom. Tamo gdje se informacije prikazuju preko ove boje, poput ikone broja epizoda u prikazu mreže, Copacetic će automatski odabrati između bijelog i crnog teksta kako bi se maksimizirao kontrast."

# /16x9/Content_Settings.xml
msgctxt "#31410"
msgid "Choose accent colour"
msgstr "Odaberite akcentnu boju"

# /16x9/Content_Settings.xml
msgctxt "#31411"
msgid "Reset accent colour"
msgstr "Resetuj boju akcenta"

# /16x9/Content_Settings.xml
msgctxt "#31720"
msgid "Speed up animations and window transitions [BETA]"
msgstr "Ubrzajte animacije i prijelaze između prozora [BETA]"

# /16x9/Content_Settings.xml
msgctxt "#31820"
msgid "Reduces the default animation times for transitioning between windows and visibility fades. Removes delays on certain animations and disabled others entirely."
msgstr "Smanjuje zadano vrijeme animacije za prelazak između prozora i postepeno smanjivanje vidljivosti. Uklanja kašnjenja na određenim animacijama, a druge potpuno onemogućava."

# /16x9/Content_Settings.xml
msgctxt "#31721"
msgid "Disable all viewtype scroll animations [BETA]"
msgstr "Onemogući sve animacije pomicanja za različite tipove prikaza [BETA]"

# /16x9/Content_Settings.xml
msgctxt "#31821"
msgid "Further speeds up browsing by setting the scrolltime for views to 0, removing the transitionary animations when navigating between listitems."
msgstr "Dodatno ubrzava pregledavanje postavljanjem vremena pomicanja za prikaze na 0, uklanjajući prelazne animacije prilikom navigacije između stavki liste."

# /16x9/Content_Settings.xml
msgctxt "#31412"
msgid "Recommended Kodi settings for Copacetic"
msgstr "Preporučene Kodi postavke za Copacetic"

# /16x9/Content_Settings.xml
msgctxt "#31512"
msgid "Highlights the Kodi settings recommended to change for optimal Copacetic user experience. Toggle each proposed change on/off to your liking, then accept the changes you wish to keep."
msgstr "Ističe postavke Kodija koje se preporučuju za promjenu radi optimalnog korisničkog iskustva na Copacetiku. Uključite/isključite svaku predloženu promjenu po želji, a zatim prihvatite promjene koje želite zadržati."

# /16x9/Content_Settings.xml
msgctxt "#31413"
msgid "Copacetic recommends changing the following Kodi settings for optimal user experience. Disable settings if you wish to keep their current value. Faded settings are disabled and show the current value."
msgstr "Copacetic preporučuje promjenu sljedećih Kodi postavki za optimalno korisničko iskustvo. Onemogućite postavke ako želite zadržati njihovu trenutnu vrijednost. Izblijedjele postavke su onemogućene i prikazuju trenutnu vrijednost."

# /16x9/Content_Settings.xml
msgctxt "#31414"
msgid "These will not be changed."
msgstr "Ovo se neće mijenjati."

# /16x9/Content_Settings.xml
msgctxt "#31421"
msgid "Enable clearlogo cropper"
msgstr "Omogući rezanje clearlogo-a"

# /16x9/Content_Settings.xml
msgctxt "#31521"
msgid "Clearlogos cached in Kodi's texture library will be cropped as they are required. Cropped versions are saved to a separate cache. Once a cropped clearlogo is cached, performance impact should be minimal. No changes are made to the original artwork. This process is run by Copacetic as a background service. Disable to improve performance."
msgstr "Clearlogo keširani u Kodijevoj biblioteci tekstura bit će obrezani po potrebi. Obrezane verzije se spremaju u zasebnu keš memoriju. Nakon što se obrezani clearlogo kešira, utjecaj na performanse trebao bi biti minimalan. Na originalnoj ilustraciji se ne vrše nikakve promjene. Ovaj proces pokreće Copacetic kao pozadinsku uslugu. Onemogućite da biste poboljšali performanse."

# /16x9/Content_Settings.xml
msgctxt "#31422"
msgid "Clear cache"
msgstr "Obriši keš memoriju"

# /16x9/Content_Settings.xml
msgctxt "#31522"
msgid "This will delete the cropped clearlogo cache. To prevent cropped clearlogos from being cached, make sure to disable the clearlogo cropping background service above."
msgstr "Ovo će izbrisati keš memoriju izrezanih clearloga. Da biste spriječili keširanje izrezanih clearloga, obavezno onemogućite uslugu izrezivanja clearloga u pozadini iznad."

# /16x9/Content_Settings.xml
msgctxt "#31423"
msgid "Colourise media flags"
msgstr "Oboji medijske zastave"

# /16x9/Content_Settings.xml
msgctxt "#31523"
msgid "Media flags are colourised using the dominant colour from the processed clearlogo. The dominant colour will be used as long as there is enough contrast with the current background colour. You can adjust the contrast thresholds for dark and light backgrounds below."
msgstr "Medijske zastavice su obojene dominantnom bojom iz obrađenog clearloga. Dominantna boja će se koristiti sve dok postoji dovoljan kontrast u odnosu na trenutnu boju pozadine. Pragove kontrasta za tamne i svijetle pozadine možete podesiti ispod."

# /16x9/Content_Settings.xml
msgctxt "#31424"
msgid "Adjust colour contrast thresholds"
msgstr "Podesite pragove kontrasta boja"

# /16x9/Content_Settings.xml
msgctxt "#31524"
msgid "Adjust the amount of contrast required between the background and the flag colour. Raising the bottom threshold means only lighter colours will be accepted on dark backgrounds. Lowering the top threshold means only darker colours can be used on light backgrounds. Avoids dark flags on dark backgrounds or light flags on light backgrounds. Default range: 65 - 440."
msgstr "Podesite količinu potrebnog kontrasta između pozadine i boje zastavice. Povećanje donjeg praga znači da će na tamnim pozadinama biti prihvaćene samo svjetlije boje. Spuštanje gornjeg praga znači da će se na svijetlim pozadinama moći koristiti samo tamnije boje. Izbjegava tamne zastavice na tamnim pozadinama ili svijetle zastavice na svijetlim pozadinama. Zadani raspon: 65 - 440."

# /16x9/Content_Settings.xml
msgctxt "#31428"
msgid "Prefer keyart for poster views on info screens and dialogs"
msgstr "Preferiraj keyart za prikaze postera na info ekranima i dijalozima"

# /16x9/Content_Settings.xml
msgctxt "#31700"
msgid "Prefer landscape art for fanart views on info screens and dialogs"
msgstr "Preferiraj pejzažnu umjetnost za prikaze fanarta na info ekranima i dijalozima"

# /16x9/Content_Settings.xml
msgctxt "#31417"
msgid "Home menu"
msgstr "Početna stranica"

# /16x9/Content_Settings.xml
msgctxt "#31517"
msgid "Configure your home menu shortcuts. For each shortcut, you can select an optional background to override the default slideshows."
msgstr "Konfigurišite prečice početnog menija. Za svaku prečicu možete odabrati opcionalnu pozadinu kako biste poništili zadane slajdšouove."

# /16x9/Content_Settings.xml
msgctxt "#31418"
msgid "Shutdown menu"
msgstr "Meni za isključivanje"

# /16x9/Content_Settings.xml
msgctxt "#31518"
msgid "Configure your shutdown menu shortcuts. Context-dependent 'Home', 'Theme' and 'Settings' shortcuts cannot be removed."
msgstr "Konfigurišite prečice u meniju za isključivanje. Prečice 'Početna', 'Tema' i 'Postavke' koje zavise od konteksta ne mogu se ukloniti."

# /16x9/Content_Settings.xml
msgctxt "#31492"
msgid "Enable home shortcut in Shutdown menu"
msgstr "Omogući prečicu za početni ekran u meniju za isključivanje"

# /16x9/Content_Settings.xml
msgctxt "#31493"
msgid "Enable theme switcher shortcut in Shutdown menu"
msgstr "Omogući prečicu za prebacivanje tema u meniju za isključivanje"

# /16x9/Content_Settings.xml
msgctxt "#31494"
msgid "Enable LibreELEC menu shortcut in Shutdown menu"
msgstr "Omogućite prečicu menija LibreELEC u meniju za isključivanje"

# /16x9/Content_Settings.xml
msgctxt "#31419"
msgid "Reset all menus"
msgstr "Resetuj sve menije"

# /16x9/Content_Settings.xml
msgctxt "#31425"
msgid "Global"
msgstr "Globalno"

# /16x9/Content_Settings.xml
msgctxt "#31426"
msgid "Limit background slideshow artwork to..."
msgstr "Ograniči pozadinsku sliku slajdova na..."

# /16x9/Content_Settings.xml
msgctxt "#31526"
msgid "Choose to include only fanarts from the selected sections of your library in the background slideshow, or select a custom path, playlist or folder of images."
msgstr "Odaberite da u pozadinsku prezentaciju uključite samo crteže fanova iz odabranih dijelova vaše biblioteke ili odaberite prilagođenu putanju, listu za reprodukciju ili mapu sa slikama."

# /16x9/Content_Settings.xml
msgctxt "#31436"
msgid "Movies / TV shows / Artists"
msgstr "Filmovi / TV emisije / Umjetnici"

# /16x9/Content_Settings.xml
msgctxt "#31437"
msgid "Movies / TV shows"
msgstr "Filmovi / TV emisije"

# /16x9/Content_Settings.xml
msgctxt "#31438"
msgid "Custom source"
msgstr "Prilagođeni izvor"

# /16x9/Content_Settings.xml
msgctxt "#31439"
msgid "Choose path or playlist..."
msgstr "Odaberite putanju ili listu pjesama..."

# /16x9/Content_Settings.xml
msgctxt "#31427"
msgid "Background slideshow speed"
msgstr "Brzina slajdova u pozadini"

# /16x9/Content_Settings.xml
msgctxt "#31732"
msgid "seconds"
msgstr "sekundi"

# /16x9/Content_Settings.xml
msgctxt "#31733"
msgid "minutes"
msgstr "minuta"

# /16x9/Content_Settings.xml
msgctxt "#31527"
msgid "Choose how quickly artwork in the slideshow should be refreshed. Default: 10 seconds"
msgstr "Odaberite koliko brzo treba osvježavati ilustracije u slajdšouu. Zadano: 10 sekundi"

# /16x9/Content_Settings.xml
msgctxt "#31440"
msgid "Background slideshow artwork brightness (%)"
msgstr "Svjetlina pozadinske slike u slajd-šou (%)"

# /16x9/Content_Settings.xml
msgctxt "#31540"
msgid "Choose the brightness of backgrounds displayed on the home screen and other windows such as Settings and Add-ons. Default: 33%"
msgstr "Odaberite svjetlinu pozadina prikazanih na početnom ekranu i drugim prozorima kao što su Postavke i Dodaci. Zadano: 33%"

# /16x9/Content_Settings.xml
msgctxt "#31487"
msgid "Opacity of background panels (%)"
msgstr "Neprozirnost pozadinskih panela (%)"

# /16x9/Content_Settings.xml
msgctxt "#31587"
msgid "Adjust the opacity of background panels that appear on top of artwork. Default: 75%"
msgstr "Podesite neprozirnost pozadinskih panela koji se pojavljuju preko umjetničkog djela. Zadano: 75%"

# /16x9/Content_Settings.xml
msgctxt "#31722"
msgid "Info screen background artwork brightness (%)"
msgstr "Osvjetljenje pozadinske slike info ekrana (%)"

# /16x9/Content_Settings.xml
msgctxt "#31822"
msgid "Choose the brightness of background artwork displayed when you bring up info for a list item. Default: 25%"
msgstr "Odaberite svjetlinu pozadinske slike koja se prikazuje kada se prikažu informacije za stavku liste. Zadano: 25%"

# /16x9/Content_Settings.xml
msgctxt "#31723"
msgid "Library/Playback"
msgstr "Biblioteka/Reprodukcija"

# /16x9/Content_Settings.xml
msgctxt "#31719"
msgid "OSD background brightness during video playback (%)"
msgstr "Osvjetljenje pozadine OSD-a tokom reprodukcije videa (%)"

# /16x9/Content_Settings.xml
msgctxt "#31819"
msgid "Adjust the brightness of videos when OSD controls or settings screens are visible on top. Default: 25%"
msgstr "Podesite svjetlinu videa kada su OSD kontrole ili ekrani postavki vidljivi na vrhu. Zadano: 25%"

# /16x9/Content_Settings.xml
msgctxt "#31495"
msgid "Show the name of the current displayed background"
msgstr "Prikaži naziv trenutno prikazane pozadine"

# /16x9/Content_Settings.xml
msgctxt "#31433"
msgid "Override home background with global slideshow"
msgstr "Prekriži pozadinu početne stranice globalnom slajdšou"

# /16x9/Content_Settings.xml
msgctxt "#31533"
msgid "Use the selected global slideshow on the homescreen instead of local or skin.shortcuts slideshows"
msgstr "Koristite odabranu globalnu slideshow prezentaciju na početnom ekranu umjesto lokalnih ili skin.shortcuts prezentacija"

# /16x9/Content_Settings.xml
msgctxt "#31429"
msgid "Enable widgets on the home screen"
msgstr "Omogućite widgete na početnom ekranu"

# /16x9/Content_Settings.xml
msgctxt "#31529"
msgid "Add widgets to your homescreen. To configure, go to the Widgets tab in the left menu. Choose from preset widgets, such as 'Continue watching', 'Next up' and 'Liked songs', or configure your own using any plugin source. Then select the view and display type you want to use for each widget. For custom widgets, you can also set the name, sort method and limit."
msgstr "Dodajte widgete na početni ekran. Za konfiguraciju, idite na karticu Widgeti u lijevom meniju. Odaberite između unaprijed postavljenih widgeta, kao što su 'Nastavi gledati', 'Sljedeće' i 'Sviđa mi se pjesme' ili konfigurirajte vlastiti koristeći bilo koji izvor dodatka. Zatim odaberite prikaz i vrstu prikaza koju želite koristiti za svaki widget. Za prilagođene widgete možete postaviti i naziv, način sortiranja i ograničenje."

# /16x9/Content_Settings.xml
msgctxt "#31430"
msgid "Reset home screen widgets"
msgstr "Resetiraj vidžete početnog ekrana"

# /16x9/Content_Settings.xml
msgctxt "#31530"
msgid "Reset home widgets to Copacetic defaults: 1. Continue watching 2. Next up 3. Latest movies 4. Latest TV shows"
msgstr "Resetujte početne widgete na zadane vrijednosti Copacetica: 1. Nastavi gledati 2. Sljedeće 3. Najnoviji filmovi 4. Najnovije TV emisije"

# /16x9/Content_Settings.xml
msgctxt "#31431"
msgid "Are you sure you want to reset all home widgets back to default?"
msgstr "Jeste li sigurni da želite resetirati sve početne widgete na zadane postavke?"

# /16x9/Content_Settings.xml
msgctxt "#31704"
msgid "Enable global search on the home screen"
msgstr "Omogućite globalno pretraživanje na početnom ekranu"

# /16x9/Content_Settings.xml
msgctxt "#31705"
msgid "Configure global search"
msgstr "Konfiguriraj globalnu pretragu"

# /16x9/Content_Settings.xml
msgctxt "#31706"
msgid "Enable global search for this media type"
msgstr "Omogući globalno pretraživanje za ovu vrstu medija"

# /16x9/Content_Settings.xml
msgctxt "#31707"
msgid "Include 'plot' field in this search"
msgstr "Uključi polje 'plot' u ovu pretragu"

# /16x9/Content_Settings.xml
msgctxt "#31708"
msgid "Include 'tag' field in this search"
msgstr "Uključi polje 'oznaka' u ovu pretragu"

# /16x9/Content_Settings.xml
msgctxt "#31709"
msgid "Include 'biography' field in this search"
msgstr "Uključite polje 'biografija' u ovu pretragu"

# /16x9/Content_Settings.xml
msgctxt "#31710"
msgid "Include 'review' field in this search"
msgstr "Uključi polje 'recenzija' u ovu pretragu"

# /16x9/Content_Settings.xml
msgctxt "#31442"
msgid "Enable screensaver"
msgstr "Omogući čuvar ekrana"

# /16x9/Content_Settings.xml
msgctxt "#31542"
msgid "After 10 seconds of inactivity, the home menu will be hidden, allowing the background artwork slideshow to run as a screensaver."
msgstr "Nakon 10 sekundi neaktivnosti, početni meni će biti skriven, što će omogućiti pozadinskoj grafiki da se slajdšou pokrene kao čuvar ekrana."

# /16x9/Content_Settings.xml
msgctxt "#31443"
msgid "Show clearlogos"
msgstr "Prikaži jasne logotipe"

# /16x9/Content_Settings.xml
msgctxt "#31543"
msgid "Clearlogos will be displayed as part of the screensaver when they are available."
msgstr "Jasni logotipi će se prikazivati kao dio čuvara ekrana kada budu dostupni."

# /16x9/Content_Settings.xml
msgctxt "#31444"
msgid "Furniture to include"
msgstr "Namještaj koji treba uključiti"

# /16x9/Content_Settings.xml
msgctxt "#31544"
msgid "Choose the furniture you wish to show in the top-right corner of the home screen. Note that for weather information to be included, you must first install a weather add-on and ensure it is enabled under Settings > Services > Weather."
msgstr "Odaberite namještaj koji želite prikazati u gornjem desnom uglu početnog ekrana. Imajte na umu da da biste uključili informacije o vremenu, prvo morate instalirati dodatak za vremensku prognozu i osigurati da je omogućen u Postavke > Usluge > Vrijeme."

# /16x9/Content_Settings.xml
msgctxt "#31724"
msgid "Clock"
msgstr "Sat"

# /16x9/Content_Settings.xml
msgctxt "#31725"
msgid "None"
msgstr "Nema"

# /16x9/Content_Settings.xml
msgctxt "#31726"
msgid "Clock and date"
msgstr "Sat i datum"

# /16x9/Content_Settings.xml
msgctxt "#31727"
msgid "Clock, date and weather"
msgstr "Sat, datum i vrijeme"

# /16x9/Content_Settings.xml
msgctxt "#31728"
msgid "Make persistent across entire home screen, including widgets"
msgstr "Omogući trajno prikazivanje na cijelom početnom ekranu, uključujući widgete"

# /16x9/Content_Settings.xml
msgctxt "#31729"
msgid "Enable second background slideshow"
msgstr "Omogući drugu pozadinsku prezentaciju"

# /16x9/Content_Settings.xml
msgctxt "#31730"
msgid "Limit second background slideshow to..."
msgstr "Ograniči drugu pozadinsku slajd prezentaciju na..."

# /16x9/Content_Settings.xml
msgctxt "#31731"
msgid "Start times"
msgstr "Vremena početka"

# Widgets
# /16x9/Content_Settings.xml
msgctxt "#31445"
msgid "Widget"
msgstr "Vidžet"

# /16x9/Content_Settings.xml
msgctxt "#31489"
msgid "Configure widgets"
msgstr "Konfiguriraj widgete"

# /16x9/Content_Settings.xml
msgctxt "#31701"
msgid "Movement"
msgstr "Pokret"

# /16x9/Content_Settings.xml
msgctxt "#31496"
msgid "Spotlight content with auto scroll"
msgstr "Istaknite sadržaj automatskim pomicanjem"

# /16x9/Content_Settings.xml
msgctxt "#31596"
msgid "Widget will move forward one place every 10 seconds while system is idle. When combined with trailer autoplay option below to allow for each item's trailer to be played automatically as soon as the previous trailer is finished while system is idle."
msgstr "Widget će se pomicati naprijed za jedno mjesto svakih 10 sekundi dok je sistem u stanju mirovanja. U kombinaciji s opcijom automatskog reproduciranja najave ispod, omogućava se automatska reprodukcija najave svake stavke čim se prethodna najava završi dok je sistem u stanju mirovanja."

# /16x9/Content_Settings.xml
msgctxt "#31467"
msgid "Automatically play trailers for movies or tv shows in this widget"
msgstr "Automatski reproduciraj najave za filmove ili TV emisije u ovom widgetu"

# /16x9/Content_Settings.xml
msgctxt "#31567"
msgid "Trailers will be played back automatically from any widgets showing movies or tv shows. Enable 'Spotlight content with auto scroll' option above to create a dynamic playlist of trailers for all items in the widget. Set delay in seconds before trailer playback starts under Extras > Trailer autoplay"
msgstr "Najave će se automatski reproducirati sa svih widgeta koji prikazuju filmove ili TV emisije. Omogućite opciju 'Istakni sadržaj s automatskim pomicanjem' iznad da biste kreirali dinamičku listu za reprodukciju najava za sve stavke u widgetu. Postavite kašnjenje u sekundama prije početka reprodukcije najave pod Dodaci > Automatska reprodukcija najave"

# /16x9/Variables_Labels_Media.xml
msgctxt "#31476"
msgid "Enable clearlogos"
msgstr "Omogući clearlogos"

# /16x9/Content_Settings.xml
msgctxt "#31498"
msgid "Prefer keyart for poster views"
msgstr "Preferiraj keyart za prikaze postera"

# /16x9/Content_Settings.xml
msgctxt "#31598"
msgid "Remember 'keyart' is a custom art type. To ensure it is fetched locally or remotely by scrapers, make sure 'keyart' is included in your art type whitelists for movies and / or tv shows. You can do this by choosing 'Recommended Kodi Settings' under Copacetic > General, or by navigating to Settings > Media > Videos > Artwork."
msgstr "Imajte na umu da je 'keyart' prilagođeni tip umjetničkog djela. Da biste osigurali da ga scraperi preuzimaju lokalno ili daljinski, provjerite je li 'keyart' uključen u vaše bijele liste tipova umjetničkog djela za filmove i/ili TV emisije. To možete učiniti odabirom 'Preporučene Kodi postavke' pod Copacetic > Općenito ili odabirom Postavke > Mediji > Videozapisi > Umjetničko djelo."

# /16x9/Content_Settings.xml
msgctxt "#31499"
msgid "Prefer landscape art for fanart views"
msgstr "Preferiram pejzažnu umjetnost za prikaze fanarta"

# /16x9/Content_Settings.xml
msgctxt "#31599"
msgid "Remember 'landscape' is a custom art type. To ensure it is fetched locally or remotely by scrapers, make sure 'landscape' is included in your art type whitelists for movies and / or tv shows. You can do this by choosing 'Recommended Kodi Settings' under Copacetic > General, or by navigating to Settings > Media > Videos > Artwork."
msgstr "Imajte na umu da je 'pejzaž' prilagođeni tip umjetničkog djela. Da biste osigurali da ga scraperi preuzimaju lokalno ili daljinski, provjerite je li 'pejzaž' uključen u vaše bijele liste tipova umjetničkog djela za filmove i/ili TV emisije. To možete učiniti odabirom 'Preporučene Kodi postavke' pod Copacetic > Općenito ili odabirom Postavke > Mediji > Videozapisi > Umjetničko djelo."

# /16x9/Content_Settings.xml
msgctxt "#31477"
msgid "Prefer thumbnails for episodes instead of tv show fanart"
msgstr "Preferiraj sličice za epizode umjesto fanarta za TV serije"

# Views
# /16x9/Content_Settings.xml
msgctxt "#31475"
msgid "Kiosk mode"
msgstr "Način rada kioska"

# /16x9/Content_Settings.xml
msgctxt "#31575"
msgid "When kiosk mode is enabled, all view customisation options in the hidden menu will be removed so no further changes can be made."
msgstr "Kada je omogućen kiosk način rada, sve opcije prilagođavanja prikaza u skrivenom meniju bit će uklonjene tako da se daljnje promjene ne mogu izvršiti."

# /16x9/Content_Settings.xml
msgctxt "#31486"
msgid "Disable hidden options menu"
msgstr "Onemogući meni skrivenih opcija"

# /16x9/Content_Settings.xml
msgctxt "#31586"
msgid "With koisk mode enabled, you have the option to completely disable the hidden options menu. Warning: This will limit your ability to switch between views, change sort method, filter or search."
msgstr "Kada je omogućen koisk način rada, imate mogućnost potpunog onemogućavanja menija skrivenih opcija. Upozorenje: Ovo će ograničiti vašu mogućnost prebacivanja između prikaza, promjene načina sortiranja, filtriranja ili pretraživanja."

# /16x9/Content_Settings.xml
msgctxt "#31488"
msgid "Add shutdown menu shortcut to hidden views menu"
msgstr "Dodajte prečicu iz menija za isključivanje u meni skrivenih prikaza"

# /16x9/Content_Settings.xml
msgctxt "#31441"
msgid "Add movement to fullscreen artwork"
msgstr "Dodajte pokret ilustraciji preko cijelog ekrana"

# /16x9/Content_Settings.xml
msgctxt "#31541"
msgid "Adds a subtle 'Ken Burns effect'-style pan and zoom to the fullscreen background artwork."
msgstr "Dodaje suptilno pomicanje i zumiranje u stilu 'Ken Burns efekta' na pozadinsku ilustraciju preko cijelog ekrana."

# Views
# /16x9/Content_Settings.xml
msgctxt "#31446"
msgid "Enable view for video and music windows"
msgstr "Omogući prikaz za prozore za video i muziku"

# /16x9/Content_Settings.xml
msgctxt "#31546"
msgid "Choose which windows to enable for each of the four additional Copacetic views. Keep any views you don't use disabled to speed up loading when a new media window is opened in Kodi."
msgstr "Odaberite koje prozore želite omogućiti za svaki od četiri dodatna Copacetic prikaza. Isključite prikaze koje ne koristite kako biste ubrzali učitavanje kada se u Kodiju otvori novi medijski prozor."

# /16x9/Content_Settings.xml
msgctxt "#31717"
msgid "Enable scrolling on long titles instead of truncation (...)"
msgstr "Omogući skrolovanje kod dugih naslova umjesto skraćivanja (...)"

# /16x9/Content_Settings.xml
msgctxt "#31447"
msgid "Enable view for add-on and program windows"
msgstr "Omogući prikaz za prozore dodataka i programa"

# /16x9/Content_Settings.xml
msgctxt "#31734"
msgid "Enable view for favourites browser"
msgstr "Omogući prikaz za preglednik favorita"

# /16x9/Content_Settings.xml
msgctxt "#31448"
msgid "Enable view for pictures window"
msgstr "Omogući prikaz za prozor sa slikama"

# /16x9/Content_Settings.xml
msgctxt "#31715"
msgid "Item artwork size and orientation"
msgstr "Veličina i orijentacija grafičkog elementa"

# /16x9/Content_Settings.xml
msgctxt "#31815"
msgid "Choose how big you wish items to be presented in Grid panel views and whether you wish to scroll vertically or horizontally. For Fanart views, 'Horizontal large' displays 3 items per row and 'Horizontal small' displays 4. For Poster and Square views, 'Horizontal large' displays 5 items per row and 'Horizontal small' displays 7. 'Vertical' displays two rows at all times."
msgstr "Odaberite veličinu stavki koje želite da budu prikazane u prikazima panela Mreža i da li želite da se pomičete vertikalno ili horizontalno. Za prikaze Fanart, 'Veliki horizontalni' prikazuje 3 stavke po redu, a 'Mali horizontalni' prikazuje 4. Za prikaze Poster i Kvadrat, 'Veliki horizontalni' prikazuje 5 stavki po redu, a 'Mali horizontalni' prikazuje 7. 'Vertikalni' uvijek prikazuje dva reda."

# /16x9/Content_Settings.xml
msgctxt "#31449"
msgid "Dim artwork for watched items or disabled add-ons"
msgstr "Zatamnjena grafika za nadzirane stavke ili onemogućene dodatke"

# /16x9/Content_Settings.xml
msgctxt "#31450"
msgid "Checkmarks for watched items or enabled add-ons"
msgstr "Kvačica za nadzirane stavke ili omogućene dodatke"

# Customisations
# /16x9/Content_Settings.xml
msgctxt "#31451"
msgid "Show unwatched episodes count"
msgstr "Prikaži broj nepogledanih epizoda"

# /16x9/Content_Settings.xml
msgctxt "#31551"
msgid "Display the total number of unwatched episodes for a tv show or season on top of the progress bar."
msgstr "Prikažite ukupan broj nepogledanih epizoda TV emisije ili sezone na vrhu trake napretka."

# /16x9/Content_Settings.xml
# /16x9/Variables_Labels_Windows.xml
msgctxt "#31452"
msgid "Preferred classification ratings"
msgstr "Preferirane ocjene klasifikacije"

# /16x9/Content_Settings.xml
msgctxt "#31552"
msgid "Choose the classification system to use when displaying age rating flags. If your preferred classication system is not present, please request it on the forum."
msgstr "Odaberite sistem klasifikacije koji će se koristiti prilikom prikazivanja oznaka za dobnu granicu. Ako vaš željeni sistem klasifikacije nije prisutan, zatražite ga na forumu."

# /16x9/Content_Settings.xml
msgctxt "#31453"
msgid "Scroll by sort letter"
msgstr "Pomicanje po slovu sortiranja"

# /16x9/Content_Settings.xml
msgctxt "#31553"
msgid "When enabled, press down on horizontal scrollbars and right on vertical scrollbars to scroll by sort letter/number. This is dependent on the sort method currently selected. You can scroll by Name, File, Artist, Artist/Year, Album, Title, Original title, Rating, User rating, Play count, Number of discs, Duration, Appearances."
msgstr "Kada je omogućeno, pritisnite horizontalne trake za pomicanje prema dolje i vertikalne trake za pomicanje desno za pomicanje po slovu/broju sortiranja. Ovo zavisi od trenutno odabrane metode sortiranja. Možete se pomicati po imenu, datoteci, izvođaču, izvođaču/godini, albumu, naslovu, originalnom naslovu, ocjeni, korisničkoj ocjeni, broju reprodukcija, broju diskova, trajanju i pojavljivanjima."

# /16x9/Content_Settings.xml
msgctxt "#31454"
msgid "Liked song rating threshold"
msgstr "Prag ocjene pjesme koju ste označili kao \"sviđa mi se\""

# /16x9/Content_Settings.xml
msgctxt "#31716"
msgid "Prefer white to grey text colour for plot in Showcase and Strip views"
msgstr "Preferiraj bijelu u odnosu na sivu boju teksta za grafikon u prikazima Showcase i Strip"

# /16x9/Content_Settings.xml
msgctxt "#31554"
msgid "Overlay a binary user rating system (liked or not) on top of standard song user ratings. User ratings equal to or above this threshold are 'liked'. You can 'like' (set a user rating equivalent to the threshold) or 'unlike' (clear user rating) a song via the context menu, or embedded music player if enabled under Extras. The threshold will also be used by the 'Liked songs' widget. Set to 'Off' to disable."
msgstr "Prekrižite standardne korisničke ocjene pjesama binarnim sistemom ocjenjivanja (sviđa mi se ili ne). Korisničke ocjene jednake ili veće od ovog praga nazivaju se 'sviđa mi se'. Pjesmu možete označiti kao 'sviđa mi se' (postaviti korisničku ocjenu ekvivalentnu pragu) ili 'ne sviđa mi se' (obrisati korisničku ocjenu) putem kontekstnog menija ili ugrađenog muzičkog playera ako je omogućeno pod Dodaci. Prag će također koristiti widget 'Sviđa mi se pjesme'. Postavite na 'Isključeno' da biste onemogućili."

# /16x9/Content_Settings.xml
msgctxt "#31484"
msgid "Info screens"
msgstr "Info ekrani"

# /16x9/Content_Settings.xml
msgctxt "#31703"
msgid "Use TMDbHelper for info screen widgets instead of library content"
msgstr "Koristite TMDbHelper za widgete na info ekranu umjesto sadržaja biblioteke"

# /16x9/Content_Settings.xml
msgctxt "#31803"
msgid "As long as this plugin is enabled on your system, it will be used to populate info screen widgets including actor and director credits, similar movies/shows and more."
msgstr "Sve dok je ovaj dodatak omogućen na vašem sistemu, koristit će se za popunjavanje widgeta na info ekranu, uključujući podatke o glumcima i režiserima, slične filmove/serije i još mnogo toga."

# /16x9/Content_Settings.xml
msgctxt "#31485"
msgid "Disable star ratings"
msgstr "Onemogući ocjenjivanje zvjezdicama"

# /16x9/Content_Settings.xml
msgctxt "#31478"
msgid "Video player"
msgstr "Video plejer"

# /16x9/Content_Settings.xml
msgctxt "#31711"
msgid "Limit quick subtitle switcher in video OSD to a preferred language"
msgstr "Ograničite brzi prebacivač titlova u video OSD-u na željeni jezik"

# /16x9/Content_Settings.xml
msgctxt "#31811"
msgid "Enter the three-letter code of your preferred language, e.g. 'eng' for English. If subtitles in this language are available for the currently playing video, the quick subtitle switcher will toggle on/off for the first subtitle stream in this language, ignoring other streams. If the language is not available, it will toggle between all streams as normal."
msgstr "Unesite troslovni kod željenog jezika, npr. 'eng' za engleski. Ako su titlovi na ovom jeziku dostupni za trenutno reprodukovani video, brzi prekidač za titlove će se uključiti/isključiti za prvi stream titlova na ovom jeziku, ignorišući ostale streamove. Ako jezik nije dostupan, prebacivat će se između svih streamova kao i obično."

# /16x9/Content_Settings.xml
msgctxt "#31713"
msgid "Disable video information being displayed at the start of playback"
msgstr "Onemogući prikaz informacija o videu na početku reprodukcije"

# /16x9/Content_Settings.xml
msgctxt "#31718"
msgid "Prefer time remaining to video duration in player seek bar"
msgstr "Preferiraj preostalo vrijeme u odnosu na trajanje videa u traci za premotavanje playera"

# /16x9/Content_Settings.xml
msgctxt "#31813"
msgid "This disables the label that appears upon video playback showing information about the video including end time, resolution and age rating."
msgstr "Ovo onemogućava oznaku koja se pojavljuje prilikom reprodukcije videa, a koja prikazuje informacije o videu, uključujući vrijeme završetka, rezoluciju i dobnu granicu."

# /16x9/Content_Settings.xml
msgctxt "#31490"
msgid "Enable Up Next widget during playback"
msgstr "Omogući widget Sljedeće tokom reprodukcije"

# /16x9/Content_Settings.xml
msgctxt "#31590"
msgid "Up Next is a third-party addon that enabled Netflix-style autoplay of the next episode with an 'Are you still watching' prompt. Selecting this option will install and enable the addon, which can be configured under Add-ons."
msgstr "\"Up Next\" je dodatak treće strane koji omogućava automatsko reproduciranje sljedeće epizode u Netflixovom stilu s upitom \"Da li još uvijek gledate?\". Odabirom ove opcije instalirat ćete i omogućiti dodatak, koji se može konfigurirati u odjeljku \"Dodaci\"."

# /16x9/Content_Settings.xml
msgctxt "#31491"
msgid "Choose artwork type to display in Up Next widget"
msgstr "Odaberite vrstu umjetničkog djela za prikaz u widgetu Sljedeće"

# /16x9/Content_Settings.xml
msgctxt "#31591"
msgid "Choose between different layout options for the Up Next widget that will appear on the screen as an episode concludes."
msgstr "Odaberite između različitih opcija rasporeda za widget \"Sljedeće\" koji će se pojaviti na ekranu kada se epizoda završi."

# /16x9/Content_Settings.xml
msgctxt "#31455"
msgid "Instantly hide progress bar on pause screen"
msgstr "Trenutno sakrijte traku napretka na ekranu za pauziranje"

# /16x9/Content_Settings.xml
msgctxt "#31555"
msgid "Subtitles will not be obscured when video playback is paused."
msgstr "Titlovi neće biti zaklonjeni kada je reprodukcija videa pauzirana."

# /16x9/Content_Settings.xml
msgctxt "#31456"
msgid "Show info on pause screen"
msgstr "Prikaži informacije na ekranu za pauzu"

# /16x9/Content_Settings.xml
msgctxt "#31556"
msgid "Video information, which can be displayed during fullscreen video playback by pressing <i>, will also be displayed automatically when the video is paused."
msgstr "Informacije o videu, koje se mogu prikazati tokom reprodukcije videa preko cijelog ekrana pritiskom na <i>, također će se automatski prikazati kada se video pauzira."

# /16x9/Content_Settings.xml
msgctxt "#31479"
msgid "Music player"
msgstr "Muzički plejer"

# /16x9/Content_Settings.xml
msgctxt "#31480"
msgid "Enable background fanart"
msgstr "Omogući fanart u pozadini"

# /16x9/Content_Settings.xml
msgctxt "#31481"
msgid "Visualisation screen album cover"
msgstr "Omot albuma za vizualizaciju ekrana"

