# Experiments
# /16x9/Content_Settings.xml
msgctxt "#31470"
msgid "Use unwatched count in info details"
msgstr "Koristite broj nepraćenih sadržaja u detaljima informacija"

# /16x9/Content_Settings.xml
msgctxt "#31570"
msgid "Replaced 'A/B watched' with 'X/Y unwatched' in all info lines. This information duplicates the unwatched episode count indicator, which can be enabled under Customisations and is integrated into the progress bar."
msgstr "Zamijenjeno je 'A/B gledano' sa 'X/Y nepogledano' u svim info redovima. Ova informacija duplicira indikator broja nepogledanih epizoda, koji se može omogućiti u Prilagođavanjima i integriran je u traku napretka."

# /16x9/Content_Settings.xml
msgctxt "#31471"
msgid "Enable 'Fanart' display layout for Grid view in Pictures window"
msgstr "Omogući raspored prikaza 'Fanart' za prikaz mreže u prozoru Slike"

# /16x9/Content_Settings.xml
msgctxt "#31571"
msgid "Enables Grid view fanart layout for the pictures window. Because pictures can take any aspect ratio, it is recommended to stick to square layouts for the optimal experience. Keep disabled to improve performance."
msgstr "Omogućava raspored fanarta u obliku mreže za prozor sa slikama. Budući da slike mogu imati bilo koji omjer širine i visine, preporučuje se korištenje kvadratnog rasporeda za optimalno iskustvo. Ostavite isključeno radi poboljšanja performansi."

# /16x9/Content_Settings.xml
msgctxt "#31714"
msgid "Enable landscape art for List and Billboard view backgrounds"
msgstr "Omogući pejzažnu umjetnost za pozadine prikaza lista i bilborda"

# /16x9/Content_Settings.xml
msgctxt "#31712"
msgid "Prefer landscape art to fanart for backgrounds in List and Billboard views"
msgstr "Za pozadine u prikazima List i Billboard preferiram pejzažnu umjetnost u odnosu na fanart"

# /16x9/Content_Settings.xml
msgctxt "#31812"
msgid "Will allow landscape artwork to be displayed instead of fanarts if landscape art is preferred - even on these two views where logos on the landscape artwork may interfere with readability of the details presented in these views."
msgstr "Omogućit će prikazivanje pejzažnih umjetničkih djela umjesto fanarta ako se preferira pejzažna umjetnost - čak i na ova dva prikaza gdje logotipi na pejzažnim umjetničkim djelima mogu ometati čitljivost detalja prikazanih u ovim prikazima."

# /16x9/Content_Settings.xml
msgctxt "#31702"
msgid "Move to parent directory automatically if container is empty"
msgstr "Automatski premjesti u nadređeni direktorij ako je kontejner prazan"

# /16x9/Content_Settings.xml
msgctxt "#31802"
msgid "If the current focused container is empty--for example because your filter is set to unwatched episodes and you have no unwatched episodes to view--enabling this will cause Kodi to automatically move to the parent directory."
msgstr "Ako je trenutno fokusirani kontejner prazan - na primjer, zato što je vaš filter postavljen na nepogledane epizode, a nemate nepogledanih epizoda za pregled - omogućavanje ove opcije će uzrokovati da se Kodi automatski premjesti u nadređeni direktorij."

# Extras
# /16x9/Content_Settings.xml
msgctxt "#31457"
msgid "Embedded lists"
msgstr "Ugrađene liste"

# /16x9/Content_Settings.xml
msgctxt "#31458"
msgid "Enable embedded lists for sets, tv shows and artists"
msgstr "Omogući ugrađene liste za setove, TV emisije i izvođače"

# /16x9/Content_Settings.xml
msgctxt "#31558"
msgid "Enrich video and music views by enabling embedded secondary lists that allow you to scroll through the movies in a set, the seasons in a tv show and the albums by an artist without clicking into an item. Instead, just press down on a listitem in horizontal views or left in vertical views to navigate the secondary list."
msgstr "Obogatite prikaze videa i muzike omogućavanjem ugrađenih sekundarnih lista koje vam omogućavaju da se krećete kroz filmove u setu, sezone u TV emisiji i albume izvođača bez klika na stavku. Umjesto toga, samo pritisnite stavku liste u horizontalnim prikazima ili lijevo u vertikalnim prikazima da biste se kretali kroz sekundarnu listu."

# /16x9/Content_Settings.xml
msgctxt "#31459"
msgid "Music player"
msgstr "Muzički plejer"

# /16x9/Content_Settings.xml
msgctxt "#31460"
msgid "Enable embedded music player"
msgstr "Omogući ugrađeni muzički plejer"

# /16x9/Content_Settings.xml
msgctxt "#31560"
msgid "View and control music playback from anywhere in Kodi with the music player widget, which is embedded into each unique Copacetic view. If you've set a 'Liked song rating threshold' under Customisations, you'll also be able to mark songs as 'Liked' straight from the widget or jump straight to a view of the currently playing artist."
msgstr "Pregledajte i kontrolišite reprodukciju muzike sa bilo kojeg mjesta u Kodiju pomoću widgeta za muzički plejer, koji je ugrađen u svaki jedinstveni Copacetic prikaz. Ako ste postavili 'Prag ocjene pjesme koja vam se sviđa' pod Prilagođavanjima, također ćete moći označiti pjesme kao 'Sviđa mi se' direktno iz widgeta ili direktno preći na prikaz izvođača koji se trenutno reprodukuje."

# /16x9/Content_Settings.xml
msgctxt "#31461"
msgid "Multiart"
msgstr "Višestruka umjetnost"

# /16x9/Content_Settings.xml
msgctxt "#31462"
msgid "Enable multiart slideshows"
msgstr "Omogući višestruke projekcije slajdova"

# /16x9/Content_Settings.xml
msgctxt "#31562"
msgid "Enjoy more artwork with multiart slideshows, embedded directly into each view. Copacetic will play a slideshow of all available multiart in your library for a given listitem and art type. To add multiart, simply add additional artwork to the same folder as your main artwork with a number appended to the end then rescan the item, e.g. keyart.jpg, keyart1.jpg, keyart2.jpg or filename-poster.jpg, filename-poster1.jpg."
msgstr "Uživajte u više umjetničkih djela uz višestruke slajdove, ugrađene direktno u svaki prikaz. Copacetic će reproducirati slajdove svih dostupnih višestrukih umjetničkih djela u vašoj biblioteci za datu stavku liste i vrstu umjetničkog djela. Da biste dodali višestruka umjetnička djela, jednostavno dodajte dodatna umjetnička djela u istu mapu kao i vaša glavna umjetnička djela s brojem dodanim na kraj, a zatim ponovo skenirajte stavku, npr. keyart.jpg, keyart1.jpg, keyart2.jpg ili naziv datoteke-poster.jpg, naziv datoteke-poster1.jpg."

# /16x9/Content_Settings.xml
msgctxt "#31563"
msgid "Choose how long to display each artwork in the slideshow."
msgstr "Odaberite koliko dugo će se prikazivati svaki umjetnički rad u slajdšouu."

# /16x9/Content_Settings.xml
msgctxt "#31464"
msgid "Trailer autoplay"
msgstr "Automatska reprodukcija najave"

# /16x9/Content_Settings.xml
msgctxt "#31465"
msgid "Enable trailers to autoplay"
msgstr "Omogući automatsko reproduciranje najava"

# /16x9/Content_Settings.xml
msgctxt "#31565"
msgid "Automatically start fullscreen playback of trailers after a short delay, which you can set below. Stop playback by pressing any direction button. In horizontal views, up/down ends playback with no further action until you scroll. Left/right ends playback and scrolls to the previous/next item, meaning the next trailer will begin automatically after the set delay. Directions are switched in vertical views."
msgstr "Automatski pokreni reprodukciju trejlera preko cijelog ekrana nakon kratkog kašnjenja, koje možete postaviti ispod. Zaustavi reprodukciju pritiskom na bilo koju tipku za smjer. U horizontalnim prikazima, gore/dolje prekida reprodukciju bez daljnje akcije dok ne pomičete ekran. Lijevo/desno prekida reprodukciju i pomiče se na prethodnu/sljedeću stavku, što znači da će sljedeći trejler automatski početi nakon postavljenog kašnjenja. Smjerovi se mijenjaju u vertikalnim prikazima."

# /16x9/Content_Settings.xml
msgctxt "#31466"
msgid "Delay before playback starts (seconds)"
msgstr "Kašnjenje prije početka reprodukcije (sekunde)"

# /16x9/Content_Settings.xml
msgctxt "#31566"
msgid "Choose how long you must wait on a selected movie or tv show before playback of the trailer starts."
msgstr "Odaberite koliko dugo morate čekati na odabrani film ili TV emisiju prije nego što počne reprodukcija najave."

# /16x9/Content_Settings.xml
msgctxt "#31468"
msgid "Autoplay trailers for movies in video library"
msgstr "Automatsko reproduciranje trejlera za filmove u videoteci"

# /16x9/Content_Settings.xml
msgctxt "#31568"
msgid "Autoplay can be quickly toggled on/off from the options menu within the video library."
msgstr "Automatska reprodukcija se može brzo uključiti/isključiti iz menija opcija unutar videoteke."

# /16x9/Content_Settings.xml
msgctxt "#31469"
msgid "Autoplay trailers for tv shows in video library"
msgstr "Automatsko reproduciranje najava za TV emisije u videoteci"

