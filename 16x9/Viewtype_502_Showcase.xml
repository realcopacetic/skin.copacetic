<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="ShowcaseView_Container">
		<control type="group">
			<visible>$EXP[ShowcaseView_IsVisible]</visible>
			<include content="Custom_List">
				<param name="folderwatch" value="true" />
				<param name="ladders" value="true" />
				<param name="visible" value="$PARAM[visible]" />
				<param name="type" value="fixedlist" />
				<param name="id" value="502" />
				<param name="viewtype_label" value="Showcase" />
				<param name="viewtype" value="bigwrap" />
				<param name="orientation" value="horizontal" />
				<include content="blk_layouts">
					<param name="width" value="480" />
				</include>
				<include content="Clearlogo_Crop_Pass" condition="Window.Is(videos) | Window.Is(music)" />
			</include>
		</control>
	</include>

	<!-- The media windows' Showcase: C2's vue_reel (reel.xml) in the display's wrapper, which hides it while the listing changes,
		fades it for a trailer and slides posters with details right of the music player. secondary: as StripView_Media's -->
	<include name="ShowcaseView_Media">
		<param name="secondary" default="false" />
		<param name="window" />
		<definition>
			<include content="Viewtype_Display_Template">
				<param name="media_view" value="true" />
				<param name="viewtype_label" value="Showcase" />
				<param name="visible" value="!Window.IsVisible(selectvideoversion)" />
				<animation effect="slide" start="0,0" end="360,0" time="0" reversible="true" condition="$EXP[ShowcaseView_Display_IsPosters] + !$EXP[ShowcaseView_Details_Off] + $EXP[Music_Player_IsVisible]">Conditional</animation>
				<include content="Trailer_Autoplay_Fade_Animation" condition="$EXP[trailer_include_$PARAM[window]]" />
				<include content="vue_reel">
					<param name="id" value="502" />
					<param name="secondary" value="$PARAM[secondary]" />
					<param name="window" value="$PARAM[window]" />
				</include>
			</include>
		</definition>
	</include>

	<!-- The rails' Showcase (Home rows): the rail's art (ShowcaseView_Art_<display>) in the display's wrapper -->
	<include name="ShowcaseView_Display">
		<param name="id" default="502" />
		<param name="media_view" default="false" />
		<param name="widget_view" default="true" /><!-- unread: declared for Home_Row_Layout's shared call, which passes it to every view (M122 a) -->
		<param name="display" /> <!-- a Home row's display, a literal: picks the art include below -->
		<definition>
			<include content="Viewtype_Display_Template">
				<param name="viewtype_label" value="Showcase" />
				<param name="visible" value="!Window.IsVisible(selectvideoversion)" />
				<param name="media_view" value="$PARAM[media_view]" />
				<include content="Trailer_Autoplay_Fade_Animation" condition="$EXP[trailer_include_videos] | $EXP[trailer_include_home]" />
				<include content="ShowcaseView_Art_$PARAM[display]">
					<param name="target_id" value="$PARAM[id]" />
					<param name="art_icon" value="$PARAM[art_icon]" />
					<param name="breadcrumb_overlay" value="true" />
				</include>
			</include>
		</definition>
	</include>

	<!-- The details over the focused art (Title or Info over the art), for the media view (reel.xml) -->
	<include name="ShowcaseView_Overlay">
		<control type="group">
			<visible>!$EXP[TransparentDialog_IsVisible] + !Window.IsVisible(pictureinfo) + !$EXP[Scrollbar_HasFocus]</visible>
			<visible>![Control.HasFocus(3100) + Control.IsVisible(5008)] + !$EXP[Secondary_List_Container_Switching] + !$EXP[Secondary_List_Content_Switching]</visible>
			<include content="Visible_Fade_Delayed_Animation" />
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<control type="group">
				<visible>!$EXP[Content_Switching]</visible>
				<include content="Visible_Fade_Delayed_Long_Animation" />
				<control type="grouplist">
					<left>30</left>
					<right>30</right>
					<visible>$EXP[ShowcaseView_Details_Overlay_IsVisible] + !Control.HasFocus(3100)</visible>
					<orientation>vertical</orientation>
					<align>center</align>
					<itemgap>0</itemgap>
					<control type="textbox">
						<visible>$EXP[ShowcaseView_Display_IsSquare]</visible>
						<height max="260">auto</height>
						<font>Showcase_Overlay_Title</font>
						<textcolor>light</textcolor>
						<label>$VAR[Title_Label]</label>
						<align>center</align>
						<aligny>center</aligny>
					</control>
					<control type="textbox">
						<visible>$EXP[ShowcaseView_Display_IsPosters]</visible>
						<height max="260">auto</height>
						<font>Showcase_Title</font>
						<textcolor>light</textcolor>
						<label>$VAR[Title_Label]</label>
						<align>center</align>
						<aligny>center</aligny>
					</control>
					<control type="label">
						<visible>$EXP[ShowcaseView_Details_Info_Overlay]</visible>
						<height max="70">auto</height>
						<font>Showcase_Info</font>
						<textcolor>light</textcolor>
						<label>$VAR[Info_Label]</label>
						<align>center</align>
					</control>
				</control>
			</control>
		</control>
	</include>

	<include name="ShowcaseView_Details">
		<param name="id" default="502" />
		<param name="media_view" default="true" />
		<param name="widget_clearlogos" default="false" />
		<param name="include_progress" default="true" />
		<definition>
			<include content="Viewtype_Details_Template">
				<param name="viewtype_label" value="Showcase" />
				<param name="visible" value="$PARAM[visible]" />
				<include content="Progress" condition="[Window.Is(videos) | Window.Is(home) | Window.Is(movieinformation)] + $PARAM[include_progress]">
					<param name="id" value="$PARAM[id]" />
					<animation effect="slide" start="0,0" end="-600,0" time="0" condition="true">Conditional</animation>
					<animation effect="slide" start="0,0" end="360,0" time="0" reversible="true" condition="$PARAM[media_view] + Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio + $EXP[ShowcaseView_Display_IsPosters] + !$EXP[ShowcaseView_Details_Off]">Conditional</animation>
					<animation effect="slide" start="0,0" end="180,0" time="0" condition="$EXP[ShowcaseView_Display_IsSquare]">Conditional</animation>
				</include>
				<include content="Common_Details">
					<param name="viewtype_label" value="Showcase" />
					<param name="left" value="990" />
					<param name="width" value="660" />
					<param name="align" value="center" />
					<param name="logo_id" value="63$PARAM[id]" />
					<param name="logo_width" value="100%" />
					<param name="title_color" value="$VAR[Primary_Color]" />
					<param name="title_maxheight" value="280" />
					<param name="plot_maxheight" value="235" />
					<param name="widget_clearlogos" value="$PARAM[widget_clearlogos]" />
					<animation effect="slide" start="0,0" end="180,0" time="0" reversible="true" condition="$PARAM[media_view] + Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio + $EXP[ShowcaseView_Display_IsPosters] + !$EXP[ShowcaseView_Details_Off]">Conditional</animation>
					<animation effect="slide" start="0,0" end="180,0" time="0" condition="$EXP[ShowcaseView_Display_IsSquare]">Conditional</animation>
				</include>
			</include>
		</definition>
	</include>

</includes>