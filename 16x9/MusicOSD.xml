<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- musicosd -->
	<!-- OSD_Label's button name: one home property for both OSDs (radio shows the PVR rows here) -->
	<onload>ClearProperty(OSD_Controls,home)</onload>
	<onunload>ClearProperty(OSD_Controls,home)</onunload>
	<defaultcontrol always="true">1</defaultcontrol>
	<zorder>3</zorder>
	<controls>
		<include content="OSD_Template">
			<param name="breadcrumb_color" value="$VAR[visualisation_Label_Color]" />
			<param name="windowname" value="musicosd" />
			<param name="width" value="300" />
		</include>
	</controls>
</window>