<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- C1's copy of C2's billboard.xml, under C2's names so a C2 fix diffs across. C1's look: parallax off (none of its buttons,
		properties or hooks), the art crossfades on a move, half bright, with C1's Ken Burns; no spotlight body (C1's details stay) -->

	<include name="vue_billboard_fanart">
		<include content="tpl_billboard_art">
			<param name="id" value="$PARAM[id]" />
			<param name="region" value="$PARAM[region]" />
			<param name="secondary" value="$PARAM[secondary]" />
			<param name="texture_prefix" value="$PARAM[texture_prefix]" />
		</include>
	</include>

	<!-- C1: region, the scroll latches the multiart waits on (a rail's, or the media view's) -->
	<include name="tpl_billboard_art">
		<param name="height" default="1080" />
		<param name="region" default="primary" />
		<param name="secondary" default="false" /><!-- true where the embedded list (3100) draws its art in the focus region, below the view's -->
		<param name="visible" default="true" />
		<param name="width" default="1920" />
		<param name="zoom_center_next_secondary" default="960,0" />
		<param name="zoom_center_prev_secondary" default="960,1080" />
		<definition>
			<include content="grp_art_anchor">
				<param name="height" value="$PARAM[height]" />
				<param name="left" value="0" />
				<param name="top" value="0" />
				<param name="visible" value="$PARAM[visible]" />
				<param name="width" value="$PARAM[width]" />
				<animation effect="fadediffuse" end="ff808080" time="0" condition="true">Conditional</animation><!-- C1: half bright under the details, the list's art included -->
				<include content="Ken_Burns_Effect_Animation" condition="Skin.HasSetting(List_Ken_Burns_Effect)" />
				<include content="img_art"><!-- C1's crossfade: an instant copy under the fading art fills the fade's dip -->
					<param name="fadetime" value="5" />
					<param name="texture" value="$VAR[texture_$PARAM[texture_prefix]_fanart0]" />
				</include>
				<include content="tpl_focus_region">
					<param name="height" value="$PARAM[height]" />
					<param name="secondary" value="$PARAM[secondary]" />
					<param name="texture_stub_secondary" value="secondary_fanart" />
					<param name="width" value="$PARAM[width]" />
					<param name="zoom_center_next" value="$PARAM[zoom_center_next_secondary]" />
					<param name="zoom_center_prev" value="$PARAM[zoom_center_prev_secondary]" />
					<include content="tpl_art_focused">
						<param name="fadetime" value="360" />
						<param name="height" value="$PARAM[height]" />
						<param name="id" value="$PARAM[id]" />
						<param name="multiart" value="!$EXP[container_scrolling_$PARAM[region]] + [$EXP[multiart_current_3400] | $EXP[multiart_shown]]" /><!-- the old Billboard's: unlike Strip's, also inside a movie's versions; multiart_shown holds it through the embedded list's serve -->
						<param name="position" value="0" />
						<param name="texture_stub" value="$PARAM[texture_prefix]_fanart" />
						<param name="width" value="$PARAM[width]" />
						<include content="btn_secondary_redirect" condition="$PARAM[secondary]" />
					</include>
				</include>
			</include>
			<control type="group"><!-- C1's collection mark, outside the zoom. It leaves with the view's art as the region scrolls to the list's -->
				<animation effect="slide" end="0,-$PARAM[height]" time="Default_Transition_1x" tween="sine" easing="inout" reversible="true" condition="[$PARAM[secondary]] + Control.HasFocus(3100)">Conditional</animation><!-- secondary: only a vue with the embedded list moves its mark -->
				<include content="grp_collection_indicator">
					<param name="id" value="$PARAM[id]" />
					<param name="position" value="0" />
					<param name="width" value="60" />
				</include>
			</control>
		</definition>
	</include>

</includes>
