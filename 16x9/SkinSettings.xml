<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- skinsettings: a shell under the helper's editor (copaceticsettings.xml), which draws Skin settings. The condition
		stops onload running again (LOAD_EVERY_TIME) while that editor is closing -->
	<onload condition="String.IsEmpty(Window(home).Property(active_editor_name))">RunScript(script.copacetic.helper,action=dynamic_settings_window,host=skinsettings,host_focus=3001,mapping=copacetic1,name=copaceticsettings)</onload>
	<onunload>ClearProperty(settings_Passthrough,home)</onunload>
	<backgroundcolor>dark</backgroundcolor>
	<controls>
		<include content="Background_Multiart_Settings" />
	</controls>
</window>
