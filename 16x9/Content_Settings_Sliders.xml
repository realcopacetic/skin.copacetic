<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="skinsettings_GridView_Size_Button_Conditions">
		<onleft condition="Skin.String(GridView_Size,Horizontal)">Skin.SetString(GridView_Size,Large)</onleft>
		<onleft condition="Skin.String(GridView_Size,Large) | !Skin.String(GridView_Size)">Skin.SetString(GridView_Size,Small)</onleft>
		<onright condition="Skin.String(GridView_Size,Small)">Skin.SetString(GridView_Size,Large)</onright>
		<onright condition="Skin.String(GridView_Size,Large) | !Skin.String(GridView_Size)">Skin.SetString(GridView_Size,Horizontal)</onright>
	</include>
	<include name="skinsettings_GridView_Size_Unfocused_Slides">
		<animation effect="slide" end="60" time="0" condition="Skin.String(GridView_Size,Large) | !Skin.String(GridView_Size)">Conditional</animation>
		<animation effect="slide" end="120" time="0" condition="Skin.String(GridView_Size,Horizontal)">Conditional</animation>
	</include>
	<include name="skinsettings_GridView_Size_Focused_Slides">
		<animation effect="slide" end="55" time="0" condition="Skin.String(GridView_Size,Large) | !Skin.String(GridView_Size)">Conditional</animation>
		<animation effect="slide" end="110" time="0" condition="Skin.String(GridView_Size,Horizontal)">Conditional</animation>
	</include>

	<include name="skinsettings_like_threshold_Button_Conditions">
