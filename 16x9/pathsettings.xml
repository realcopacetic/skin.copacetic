<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- pathsettings: the helper's editor for the copacetic1 mapping: the background slideshows' custom paths (skin settings
		1602 and 1611) and play next (1409) -->
	<defaultcontrol always="true">100</defaultcontrol>
	<backgroundcolor>$VAR[Dark_Color]</backgroundcolor>
	<controls>
		<include content="pathsettings_Hidden" />
		<include content="Default_Dialog_Panel_Layout">
			<param name="visible" value="!$EXP[TransparentDialog_IsVisible]" />
			<include content="Breadcrumb_Label">
				<param name="title_label" value="$INFO[Container(100).ListItem.Label]" />
			</include>
			<include content="Settings_List_Template">
				<param name="focus_border_margin_left" value="60" />
				<param name="height" value="630" />
				<param name="id" value="100" />
				<param name="label2_visible" value="false" />
				<param name="left" value="90" />
				<param name="top" value="225" />
				<param name="width" value="870" />
				<onleft>415</onleft>
				<onright>9001</onright>
			</include>
			<include content="Dialog_Divider_With_Scrollbar">
				<param name="scrollbarvisible" value="Control.HasFocus(100)" />
			</include>
			<include content="Settings_Grouplist_Template">
				<param name="id" value="9001" />
				<param name="include_scrollbar" value="false" />
				<param name="left" value="960" />
				<param name="onleft" value="100" />
				<param name="onright" value="415" />
				<param name="pagecontrol" value="61" />
				<param name="width" value="870" />
				<include content="pathsettings_Right_List_Content" />
			</include>
			<include content="Button_Group_Template">
				<param name="button1" value="true" />
				<param name="button1_id" value="415" />
				<param name="button1_texture" value="Check" />
				<param name="onleft" value="9001" />
				<param name="onright" value="100" />
			</include>
		</include>
	</controls>
</window>
