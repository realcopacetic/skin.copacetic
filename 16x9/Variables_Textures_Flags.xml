<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<variable name="AudioCodec_Flag">
		<value condition="VideoPlayer.IsFullscreen + !String.IsEmpty(VideoPlayer.AudioCodec)">$INFO[VideoPlayer.AudioCodec,flags/audio/,.png]</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,.DTS-HD.MA)">flags/audio/dtshd_ma.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,.EAC3)">flags/audio/eac3.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,.DD) | String.Contains(Player.FilenameAndPath,.AC3)">flags/audio/ac3.png</value>
		<value condition="!String.IsEmpty(ListItem.AudioCodec)">$INFO[ListItem.AudioCodec,flags/audio/,.png]</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,.DTS-HD.MA)">flags/audio/dtshd_ma.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,.EAC3)">flags/audio/eac3.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,.DD) | String.Contains(ListItem.FilenameAndPath,.AC3)">flags/audio/ac3.png</value>
	</variable>

	<variable name="Certification_ESRB_Flags">
		<!-- ESRB: Games -->
		<value condition="String.Contains(ListItem.Property(esrb),AO)">flags/rating/ESRB_AO.png</value>
		<value condition="String.Contains(ListItem.Property(esrb),Mature)">flags/rating/ESRB_M.png</value>
		<value condition="String.Contains(ListItem.Property(esrb),Teen)">flags/rating/ESRB_T.png</value>
		<value condition="String.Contains(ListItem.Property(esrb),E10)">flags/rating/ESRB_E10.png</value>
		<value condition="String.Contains(ListItem.Property(esrb),Everyone)">flags/rating/ESRB_E.png</value>
		<value>flags/rating/ESRB_RP.png</value>
	</variable>

	<!-- Age rating: the generated texture_mpaa_<system> tables read probe 6345 (label_mpaa), and the US and Canadian ones
	     split TV from films by 6346 (label_episodic); rating_system mirrors Skin settings' pick, BBFC its default -->
	<expression name="probe_episodic">!String.IsEmpty(Control.GetLabel(6346))</expression>
	<!-- The player's item is a TV episode by its type or its show title: add-ons set either, and TVShowDBID only the library -->
	<expression name="Player_IsEpisodic">VideoPlayer.Content(episodes) | !String.IsEmpty(VideoPlayer.TVShowTitle)</expression>
	<variable name="MPAA_Flag">
		<value condition="!String.IsEmpty(ListItem.Property(esrb))">$VAR[Certification_ESRB_Flags]</value>
		<value condition="Skin.String(rating_system,MPAA)">$VAR[texture_mpaa_us]</value>
		<value condition="Skin.String(rating_system,CHVRS)">$VAR[texture_mpaa_ca]</value>
		<value condition="Skin.String(rating_system,ACB)">$VAR[texture_mpaa_ACB]</value>
		<value condition="Skin.String(rating_system,FSK)">$VAR[texture_mpaa_FSK]</value>
		<value condition="Skin.String(rating_system,DJCTQ)">$VAR[texture_mpaa_DJCTQ]</value>
		<value condition="Skin.String(rating_system,EIRIN)">$VAR[texture_mpaa_EIRIN]</value>
		<value condition="Skin.String(rating_system,KIJKWIJZER)">$VAR[texture_mpaa_KIJKWIJZER]</value>
		<value>$VAR[texture_mpaa_BBFC]</value>
	</variable>

	<variable name="Studio_Flag">
		<value condition="VideoPlayer.IsFullscreen + !String.IsEmpty(VideoPlayer.Studio)">$INFO[VideoPlayer.Studio,flags/studios/,.png]</value>
		<value condition="VideoPlayer.IsFullscreen + VideoPlayer.Content(livetv) + !String.IsEmpty(Player.Icon)">$INFO[Player.Icon]</value>
		<value condition="Control.HasFocus(3100) + !String.IsEmpty(Container(3100).ListItem.Studio)">$INFO[Container(3100).ListItem.Studio,flags/studios/,.png]</value>
		<value condition="ListItem.IsCollection + Window.Is(movieinformation) + !String.IsEmpty(Container(50).ListItem.Studio)">$INFO[Container(50).ListItem.Studio,flags/studios/,.png]</value>
		<value condition="ListItem.IsCollection + Skin.HasSetting(Secondary_List_Enabled) + !String.IsEmpty(Container(3100).ListItem.Studio)">$INFO[Container(3100).ListItem.Studio,flags/studios/,.png]</value>
		<value condition="ListItem.IsCollection + !String.IsEmpty(Container(3100).ListItem.Studio)">$INFO[Container(3100).ListItem.Studio,flags/studios/,.png]</value>
		<value condition="!String.IsEmpty(ListItem.Studio)">$INFO[ListItem.Studio,flags/studios/,.png]</value>
	</variable>

	<variable name="VideoCodec_Flag">
		<value condition="VideoPlayer.IsFullscreen + String.IsEqual(VideoPlayer.HDRType,dolbyvision)">flags/video/dolbyvision.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.IsEqual(VideoPlayer.HDRType,hdr10)">flags/video/hdr.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.IsEqual(VideoPlayer.HDRType,hlg)">flags/video/hdr.png</value>
		<value condition="VideoPlayer.IsFullscreen + [[String.Contains(Player.FilenameAndPath,dolby.vision) | String.Contains(Player.FilenameAndPath,.DoVi.) | String.Contains(Player.FilenameAndPath,.DV.)] + String.Contains(Player.FilenameAndPath,atmos)]">flags/video/dolbyvisionatmos.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,dolby.vision) | String.Contains(Player.FilenameAndPath,.DV.)]">flags/video/dolbyvision.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,hdr)">flags/video/hdr.png</value>
		<value condition="VideoPlayer.IsFullscreen + !String.IsEmpty(VideoPlayer.VideoCodec)">$INFO[VideoPlayer.VideoCodec,flags/video/,.png]</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,hevc) | String.Contains(Player.FilenameAndPath,x265)]">flags/video/hevc.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,h264) | String.Contains(Player.FilenameAndPath,x264)]">flags/video/h264.png</value>
		<value condition="String.IsEqual(ListItem.HDRType,dolbyvision)">flags/video/dolbyvision.png</value>
		<value condition="String.IsEqual(ListItem.HDRType,hdr10)">flags/video/hdr.png</value>
		<value condition="String.IsEqual(ListItem.HDRType,hlg)">flags/video/hdr.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,dolby.vision) | String.Contains(ListItem.FilenameAndPath,.DoVi.) | String.Contains(ListItem.FilenameAndPath,.DV.)] + String.Contains(ListItem.FilenameAndPath,atmos)">flags/video/dolbyvisionatmos.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,dolby.vision) | String.Contains(ListItem.FilenameAndPath,.DV.)">flags/video/dolbyvision.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,hdr)">flags/video/hdr.png</value>
		<value condition="!String.IsEmpty(ListItem.VideoCodec)">$INFO[ListItem.VideoCodec,flags/video/,.png]</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,hevc) | String.Contains(ListItem.FilenameAndPath,x265)">flags/video/hevc.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,h264) | String.Contains(ListItem.FilenameAndPath,x264)">flags/video/h264.png</value>
	</variable>

	<variable name="VideoSource_Flag">
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,AMZN) | String.Contains(Player.FilenameAndPath,Amazon)]">flags/source/Amazon.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,ATVP)] ">flags/source/Apple TV+.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,DSCV)] ">flags/source/Discovery+.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,DSNP) | String.Contains(Player.FilenameAndPath,Disney)]">flags/source/Disney+.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,HMAX) | String.Contains(Player.FilenameAndPath,HBO)]">flags/source/HBO Max.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,HULU)]">flags/source/Hulu.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,p.MAX.W)">flags/source/Max.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,MGM)] ">flags/source/MGM+.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,.NF.) | String.Contains(Player.FilenameAndPath,Netflix)]">flags/source/Netflix.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,PMNT)] ">flags/source/Paramount+.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,PCOK)] ">flags/source/Peacock.png</value>

		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,web) + [String.Contains(Player.FilenameAndPath,dl) | String.Contains(Player.FilenameAndPath,rip)]">flags/source/webtv.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,bluray) | String.Contains(Player.FilenameAndPath,blu-ray) | String.Contains(Player.FilenameAndPath,brrip) | String.Contains(Player.FilenameAndPath,bdrip) | String.Contains(Player.FilenameAndPath,.m2ts,Right) | String.Contains(Player.FilenameAndPath,.bdmv,Right) | String.Contains(Player.FilenameAndPath,bd25) | String.Contains(Player.FilenameAndPath,bd50)] + [String.Contains(Player.FilenameAndPath,uhd) | String.Contains(Player.FilenameAndPath,2160p)]">flags/source/uhd-bluray.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,bluray) | String.Contains(Player.FilenameAndPath,blu-ray) | String.Contains(Player.FilenameAndPath,brrip) | String.Contains(Player.FilenameAndPath,bdrip) | String.Contains(Player.FilenameAndPath,.m2ts,Right) | String.Contains(Player.FilenameAndPath,.bdmv,Right) | String.Contains(Player.FilenameAndPath,bd25) | String.Contains(Player.FilenameAndPath,bd50)] + String.Contains(Player.FilenameAndPath,3d)">flags/source/bluray3d.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,bluray) | String.Contains(Player.FilenameAndPath,blu-ray) | String.Contains(Player.FilenameAndPath,brrip) | String.Contains(Player.FilenameAndPath,bdrip) | String.Contains(Player.FilenameAndPath,.m2ts,Right) | String.Contains(Player.FilenameAndPath,.bdmv,Right) | String.Contains(Player.FilenameAndPath,bd25) | String.Contains(Player.FilenameAndPath,bd50)] + String.Contains(Player.FilenameAndPath,imax)">flags/source/imax.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,bluray) | String.Contains(Player.FilenameAndPath,blu-ray) | String.Contains(Player.FilenameAndPath,brrip) | String.Contains(Player.FilenameAndPath,bdrip) | String.Contains(Player.FilenameAndPath,.m2ts,Right) | String.Contains(Player.FilenameAndPath,.bdmv,Right) | String.Contains(Player.FilenameAndPath,bd25) | String.Contains(Player.FilenameAndPath,bd50)]">flags/source/bluray.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,hddvd) | String.Contains(Player.FilenameAndPath,hd-dvd) | String.Contains(Player.FilenameAndPath,.evo,Right)]">flags/source/hddvd.png</value>
		<value condition="VideoPlayer.IsFullscreen + [String.Contains(Player.FilenameAndPath,.ifo,Right) | String.Contains(Player.FilenameAndPath,.iso,Right) | String.Contains(Player.FilenameAndPath,dvd)]">flags/source/dvd.png</value>
		<value condition="VideoPlayer.IsFullscreen + String.Contains(Player.FilenameAndPath,hd) + String.Contains(Player.FilenameAndPath,tv)">flags/source/hdtv.png</value>
		<value condition="VideoPlayer.IsFullscreen + [[String.Contains(Player.FilenameAndPath,sd) + String.Contains(Player.FilenameAndPath,tv)] | [String.Contains(Player.FilenameAndPath,pd) + String.Contains(Player.FilenameAndPath,tv)] | String.Contains(Player.FilenameAndPath,dsr)]">flags/source/sdtv.png</value>

		<value condition="!String.Contains(ListItem.Studio,Amazon) + [String.Contains(ListItem.FilenameAndPath,AMZN) | String.Contains(ListItem.FilenameAndPath,Amazon) | String.Contains(ListItem.Property(Network),Amazon)]">flags/source/Amazon.png</value>
		<value condition="!String.Contains(ListItem.Studio,Apple TV) + [String.Contains(ListItem.FilenameAndPath,ATVP) | String.Contains(ListItem.Property(Network),Apple TV)] ">flags/source/Apple TV+.png</value>
		<value condition="!String.Contains(ListItem.Studio,Discovery) + [String.Contains(ListItem.FilenameAndPath,DSCV) | String.Contains(ListItem.Property(Network),Discovery)] ">flags/source/Discovery+.png</value>
		<value condition="!String.Contains(ListItem.Studio,Disney) + [String.Contains(ListItem.FilenameAndPath,DSNP) | String.Contains(ListItem.FilenameAndPath,Disney) | String.Contains(ListItem.Property(Network),Disney)]">flags/source/Disney+.png</value>
		<value condition="!String.Contains(ListItem.Studio,HBO Max) + [String.Contains(ListItem.FilenameAndPath,HMAX) | String.Contains(ListItem.FilenameAndPath,HBO) | String.Contains(ListItem.Property(Network),HBO Max)]">flags/source/HBO Max.png</value>
		<value condition="!String.Contains(ListItem.Studio,Hulu) + [String.Contains(ListItem.FilenameAndPath,HULU) | String.Contains(ListItem.Property(Network),Hulu)]">flags/source/Hulu.png</value>
		<value condition="!String.Contains(ListItem.Studio,Max) + [String.Contains(ListItem.FilenameAndPath,p.MAX.W) | String.Contains(ListItem.Property(Network),Max)]">flags/source/Max.png</value>
		<value condition="!String.Contains(ListItem.Studio,Metro) + !String.Contains(ListItem.Studio,MGM) + [String.Contains(ListItem.FilenameAndPath,MGM) | String.Contains(ListItem.Property(Network),MGM)] ">flags/source/MGM+.png</value>
		<value condition="!String.Contains(ListItem.Studio,Netflix) + [String.Contains(ListItem.FilenameAndPath,.NF.) | String.Contains(ListItem.FilenameAndPath,Netflix) | String.Contains(ListItem.Property(Network),Netflix)]">flags/source/Netflix.png</value>
		<value condition="!String.Contains(ListItem.Studio,Paramount) + [String.Contains(ListItem.FilenameAndPath,PMNT) | String.Contains(ListItem.Property(Network),Paramount)] ">flags/source/Paramount+.png</value>
		<value condition="!String.Contains(ListItem.Studio,Peacock) + [String.Contains(ListItem.FilenameAndPath,PCOK) | String.Contains(ListItem.Property(Network),Peacock)] ">flags/source/Peacock.png</value>

		<value condition="String.Contains(ListItem.FilenameAndPath,web) + [String.Contains(ListItem.FilenameAndPath,dl) | String.Contains(ListItem.FilenameAndPath,rip)]">flags/source/webtv.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,bluray) | String.Contains(ListItem.FilenameAndPath,blu-ray) | String.Contains(ListItem.FilenameAndPath,brrip) | String.Contains(ListItem.FilenameAndPath,bdrip) | String.Contains(ListItem.FilenameAndPath,.m2ts,Right) | String.Contains(ListItem.FilenameAndPath,.bdmv,Right) | String.Contains(ListItem.FilenameAndPath,bd25) | String.Contains(ListItem.FilenameAndPath,bd50)] + [String.Contains(ListItem.FilenameAndPath,uhd) | String.Contains(ListItem.FilenameAndPath,2160p)]">flags/source/uhd-bluray.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,bluray) | String.Contains(ListItem.FilenameAndPath,blu-ray) | String.Contains(ListItem.FilenameAndPath,brrip) | String.Contains(ListItem.FilenameAndPath,bdrip) | String.Contains(ListItem.FilenameAndPath,.m2ts,Right) | String.Contains(ListItem.FilenameAndPath,.bdmv,Right) | String.Contains(ListItem.FilenameAndPath,bd25) | String.Contains(ListItem.FilenameAndPath,bd50)] + String.Contains(ListItem.FilenameAndPath,3d)">flags/source/bluray3d.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,bluray) | String.Contains(ListItem.FilenameAndPath,blu-ray) | String.Contains(ListItem.FilenameAndPath,brrip) | String.Contains(ListItem.FilenameAndPath,bdrip) | String.Contains(ListItem.FilenameAndPath,.m2ts,Right) | String.Contains(ListItem.FilenameAndPath,.bdmv,Right) | String.Contains(ListItem.FilenameAndPath,bd25) | String.Contains(ListItem.FilenameAndPath,bd50)] + String.Contains(ListItem.FilenameAndPath,imax)">flags/source/imax.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,bluray) | String.Contains(ListItem.FilenameAndPath,blu-ray) | String.Contains(ListItem.FilenameAndPath,brrip) | String.Contains(ListItem.FilenameAndPath,bdrip) | String.Contains(ListItem.FilenameAndPath,.m2ts,Right) | String.Contains(ListItem.FilenameAndPath,.bdmv,Right) | String.Contains(ListItem.FilenameAndPath,bd25) | String.Contains(ListItem.FilenameAndPath,bd50)]">flags/source/bluray.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,hddvd) | String.Contains(ListItem.FilenameAndPath,hd-dvd) | String.Contains(ListItem.FilenameAndPath,.evo,Right)">flags/source/hddvd.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,.ifo,Right) | String.Contains(ListItem.FilenameAndPath,.iso,Right) | String.Contains(ListItem.FilenameAndPath,dvd)">flags/source/dvd.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,hd) + String.Contains(ListItem.FilenameAndPath,tv)">flags/source/hdtv.png</value>
		<value condition="[String.Contains(ListItem.FilenameAndPath,sd) + String.Contains(ListItem.FilenameAndPath,tv)] | [String.Contains(ListItem.FilenameAndPath,pd) + String.Contains(ListItem.FilenameAndPath,tv)] | String.Contains(ListItem.FilenameAndPath,dsr)">flags/source/sdtv.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,vhs)">flags/source/vhs.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,dvhs)">flags/source/dvhs.png</value>
		<value condition="String.Contains(ListItem.FilenameAndPath,dtheater)">flags/source/dtheater.png</value>
	</variable>

</includes>
