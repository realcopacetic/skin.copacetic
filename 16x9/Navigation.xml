<includes>

	<include name="OnBack_Conditions">
		<!-- return to previous infoscreen if that's where user came from -->
		<onback condition="!$EXP[trailer_playing] + Window.Is(videos) + String.IsEqual(Window(movieinformation).Property(SentFromInfo),true)">SetFocus(6001)</onback>
		<onback condition="Window.Is(music) + String.IsEqual(Window(musicinformation).Property(SentFromInfo),true)">SetFocus(6001)</onback>
	</include>

	<include name="List_Navigation">
		<definition>
			<onup condition="Integer.IsGreater(Container.NumItems,1)">50</onup>
			<onup condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
			<ondown condition="Integer.IsGreater(Container.NumItems,1)">50</ondown>
			<ondown condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</ondown>
			<onleft condition="$EXP[trailer_playing]">PlayerControl(Stop)</onleft>
			<onleft condition="!$EXP[trailer_playing] + $EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)">SetFocus(3100,0)</onleft>
			<onleft condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onright>
			<onright condition="!$EXP[Music_Player_IsVisible] + $EXP[trailer_playing]">PlayerControl(Stop)</onright>
			<onright condition="!$EXP[Music_Player_IsVisible] + !$EXP[trailer_playing] + Integer.IsGreater(Container.NumItems,22)">SetFocus(4013)</onright>
			<onright condition="!$EXP[Music_Player_IsVisible] + !$EXP[trailer_playing] + Integer.IsLessOrEqual(Container.NumItems,22) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<include content="atr_trailer_back" />
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="Simple_List_Navigation">
		<definition>
			<onleft condition="Window.Is(musicinformation) + String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(Control.GetLabel(6003))">99</onleft>
			<onleft condition="Window.Is(musicinformation) + String.IsEqual(ListItem.DBType,album) + String.IsEmpty(Control.GetLabel(6003))">97</onleft>
			<onright condition="Window.Is(musicinformation) + String.IsEqual(ListItem.DBType,album)">SetFocus(7)</onright>
			<onright condition="!Window.Is(musicinformation) + !Container.HasNext + !Container.HasPrevious">4000</onright>
			<onright condition="!Window.Is(musicinformation) + [Container.HasNext | Container.HasPrevious]">60</onright>
		</definition>
	</include>

	<include name="Secondary_List_Navigation">
		<definition>
			<onleft condition="$EXP[trailer_playing] + $EXP[ListView_IsVisible]">PlayerControl(Stop)</onleft>
			<onleft condition="!$EXP[trailer_playing] + $EXP[ListView_IsVisible]">SetFocus(4104)</onleft>
			<onright condition="$EXP[trailer_playing] + $EXP[ListView_IsVisible]">PlayerControl(Stop)</onright>
			<onright condition="!$EXP[trailer_playing] + $EXP[ListView_IsVisible]">SetFocus(4100)</onright>
			<onup condition="$EXP[ListView_IsVisible]">0</onup>
			<ondown condition="$EXP[ListView_IsVisible]">0</ondown>
			<onleft condition="$EXP[trailer_playing] + $EXP[BillboardView_IsVisible]">PlayerControl(Stop)</onleft>
			<onleft condition="!$EXP[trailer_playing] + $EXP[BillboardView_IsVisible]">SetFocus(4100)</onleft>
			<onright condition="$EXP[trailer_playing] + $EXP[BillboardView_IsVisible]">PlayerControl(Stop)</onright>
			<onright condition="!$EXP[trailer_playing] + $EXP[BillboardView_IsVisible]">SetFocus(4100)</onright>
			<onup condition="$EXP[BillboardView_IsVisible]">0</onup>
			<ondown condition="$EXP[BillboardView_IsVisible]">SetFocus(4102)</ondown>
			<onleft condition="$EXP[trailer_playing] + $EXP[ShowcaseView_IsVisible]">PlayerControl(Stop)</onleft>
			<onleft condition="!$EXP[trailer_playing] + $EXP[ShowcaseView_IsVisible]">SetFocus(4100)</onleft>
			<onright condition="$EXP[trailer_playing] + $EXP[ShowcaseView_IsVisible]">PlayerControl(Stop)</onright>
			<onright condition="!$EXP[trailer_playing] + $EXP[ShowcaseView_IsVisible]">SetFocus(4100)</onright>
			<onup condition="$EXP[ShowcaseView_IsVisible]">0</onup>
			<ondown condition="$EXP[ShowcaseView_IsVisible]">SetFocus(4102)</ondown>
			<include content="atr_trailer_back" />
			<onback condition="!$EXP[trailer_playing]">4100</onback><!-- bare id so Back is consumed: back to the list through the relay, as Right does, never up a folder -->
		</definition>
	</include>

	<include name="Billboard_Navigation">
		<definition>
			<onup condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + $EXP[trailer_playing]">PlayerControl(Stop)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + !$EXP[trailer_playing] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
			<ondown condition="$EXP[trailer_playing]">PlayerControl(Stop)</ondown>
			<ondown condition="!$EXP[trailer_playing] + $EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)">SetFocus(3100,0)</ondown>
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)] + Integer.IsGreater(Container.NumItems,3)">SetFocus(4013)</ondown>
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)] + Integer.IsLessOrEqual(Container.NumItems,3) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</ondown>
			<onleft condition="Integer.IsGreater(Container.NumItems,3)">501</onleft>
			<onleft condition="Integer.IsLessOrEqual(Container.NumItems,3) + Integer.IsGreater(Container.NumItems,1)">0</onleft>
			<onleft condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="Integer.IsGreater(Container.NumItems,3)">501</onright>
			<onright condition="Integer.IsLessOrEqual(Container.NumItems,3) + Integer.IsGreater(Container.NumItems,1)">0</onright>
			<onright condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<include content="atr_trailer_back" />
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="Showcase_Navigation">
		<definition>
			<onup condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + $EXP[trailer_playing]">PlayerControl(Stop)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + !$EXP[trailer_playing] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
			<ondown condition="$EXP[trailer_playing]">PlayerControl(Stop)</ondown>
			<ondown condition="!$EXP[trailer_playing] + $EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)">SetFocus(3100,0)</ondown>
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)] + Integer.IsGreater(Container.NumItems,5)">SetFocus(4013)</ondown>
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Integer.IsGreater(Container(3100).NumItems,0)] + Integer.IsLessOrEqual(Container.NumItems,5) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</ondown>
			<onleft condition="Integer.IsGreater(Container.NumItems,10)">502</onleft>
			<onleft condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onleft>
			<onleft condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="Integer.IsGreater(Container.NumItems,10)">502</onright>
			<onright condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onright>
			<onright condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<include content="atr_trailer_back" />
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="Strip_Navigation">
		<definition>
			<onup condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + $EXP[trailer_playing]">PlayerControl(Stop)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + !$EXP[trailer_playing] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
			<ondown condition="$EXP[trailer_playing]">PlayerControl(Stop)</ondown>
			<ondown condition="!$EXP[trailer_playing] + $EXP[Secondary_List_Focus] + Control.IsVisible(3100) + Integer.IsGreater(Container(3100).NumItems,0) + !$EXP[Options_Switching] + !$EXP[Container_Switching]">SetFocus(4111)</ondown><!-- through the list's art in the focus region, which scrolls to it (secondary.xml). IsVisible: a hidden copy of 3100 keeps its old items; the switches hide 4111 with the view -->
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Control.IsVisible(3100) + Integer.IsGreater(Container(3100).NumItems,0) + !$EXP[Options_Switching] + !$EXP[Container_Switching]] + Integer.IsGreater(Container.NumItems,9)">SetFocus(4013)</ondown>
			<ondown condition="!$EXP[trailer_playing] + ![$EXP[Secondary_List_Focus] + Control.IsVisible(3100) + Integer.IsGreater(Container(3100).NumItems,0) + !$EXP[Options_Switching] + !$EXP[Container_Switching]] + Integer.IsLessOrEqual(Container.NumItems,9) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</ondown>
			<onleft condition="Integer.IsGreater(Container.NumItems,10)">504</onleft>
			<onleft condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onleft>
			<onleft condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="Integer.IsGreater(Container.NumItems,10)">504</onright>
			<onright condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onright>
			<onright condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<include content="atr_trailer_back" />
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="Grid_Vertical_Navigation">
		<definition>
			<onleft condition="Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onright>
			<onright condition="!$EXP[Music_Player_IsVisible] + Integer.IsGreater(Container.NumItems,9)">SetFocus(4013)</onright>
			<onright condition="!$EXP[Music_Player_IsVisible]  + Integer.IsLessorEqual(Container.NumItems,9) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<onup condition="$EXP[GridView_Display_IsFanart] + Integer.IsGreater(Container.NumItems,3)">505</onup>
			<onup condition="!$EXP[GridView_Display_IsFanart] + Integer.IsGreater(Container.NumItems,5)">505</onup>
			<onup condition="$EXP[GridView_Display_IsFanart] + Integer.IsLessorEqual(Container.NumItems,3)">0</onup>
			<onup condition="!$EXP[GridView_Display_IsFanart] + Integer.IsLessorEqual(Container.NumItems,5)">0</onup>
			<ondown condition="$EXP[GridView_Display_IsFanart] + Integer.IsGreater(Container.NumItems,3)">505</ondown>
			<ondown condition="!$EXP[GridView_Display_IsFanart] + Integer.IsGreater(Container.NumItems,5)">505</ondown>
			<ondown condition="$EXP[GridView_Display_IsFanart] + Integer.IsLessorEqual(Container.NumItems,3)">0</ondown>
			<ondown condition="!$EXP[GridView_Display_IsFanart] + Integer.IsLessorEqual(Container.NumItems,5)">0</ondown>
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="Grid_Horizontal_Navigation">
		<definition>
			<onup condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onup>
			<onup condition="!$EXP[Music_Player_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
			<ondown condition="Integer.IsGreater(Container.NumItems,9)">SetFocus(4013)</ondown>
			<ondown condition="Integer.IsLessOrEqual(Container.NumItems,9) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</ondown>
			<onleft condition="Integer.IsGreater(Container.NumItems,10)">505</onleft>
			<onleft condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onleft>
			<onleft condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onleft>
			<onright condition="Integer.IsGreater(Container.NumItems,10)">505</onright>
			<onright condition="Integer.IsLessOrEqual(Container.NumItems,10) + Integer.IsGreater(Container.NumItems,1)">0</onright>
			<onright condition="Integer.IsEqual(Container.NumItems,1) + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
			<include content="OnBack_Conditions" />
		</definition>
	</include>

	<include name="videobookmarks_Navigation">
		<definition>
			<onup>SetFocus(4000)</onup>
			<ondown>SetFocus(4000)</ondown>
			<onleft>0</onleft>
			<onright>SetFocus(4000)</onright>
		</definition>
	</include>

	<include name="loginscreen_Navigation">
		<definition>
			<ondown>SetFocus(4000)</ondown>
			<onleft>0</onleft>
			<onright>0</onright>
		</definition>
	</include>

	
	<include name="Music_Player_Navigation">
		<include content="infoscreen_onup">
			<param name="condition" value="$EXP[Infoscreen_IsVisible] + $EXP[infoscreen_rails_focusable]" />
		</include>
		<onup condition="$EXP[Infoscreen_IsVisible] + !$EXP[infoscreen_rails_focusable]">SetFocus(3000)</onup> <!-- no rail can take focus: the menu, as before -->
		<ondown condition="$EXP[Infoscreen_IsVisible]">SetFocus(3000)</ondown>
		<include content="widgets_onup">
			<param name="condition" value="Window.Is(home) + Skin.HasSetting(Widgets_Enabled)" />
		</include>
		<onup condition="Window.Is(home) + !Skin.HasSetting(Widgets_Enabled)">3000</onup>
		<ondown condition="Window.Is(home)">3000</ondown>
		<onback condition="Window.Is(home)">3000</onback>
		<onleft condition="Window.Is(home) + !Skin.HasSetting(GlobalSearch_Disabled)">4201</onleft>
		<onback condition="$EXP[ListView_IsVisible] + !$EXP[Infoscreen_IsVisible]">50</onback>
		<onleft condition="$EXP[ListView_IsVisible] + !$EXP[Infoscreen_IsVisible]">50</onleft>
		<onright condition="$EXP[ListView_IsVisible] + Integer.IsLessOrEqual(Container.NumItems,11) + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
		<onright condition="$EXP[ListView_IsVisible] + Integer.IsGreater(Container.NumItems,12) + !$EXP[Infoscreen_IsVisible]">SetFocus(4013)</onright>
		<onback condition="$EXP[BillboardView_IsVisible] + !$EXP[Infoscreen_IsVisible]">501</onback>
		<onup condition="$EXP[BillboardView_IsVisible] + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
		<ondown condition="$EXP[BillboardView_IsVisible] + !$EXP[Infoscreen_IsVisible]">501</ondown>
		<onback condition="$EXP[ShowcaseView_IsVisible] + !$EXP[Infoscreen_IsVisible]">502</onback>
		<onup condition="$EXP[ShowcaseView_IsVisible] + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
		<ondown condition="$EXP[ShowcaseView_IsVisible] + !$EXP[Infoscreen_IsVisible]">502</ondown>
		<onback condition="$EXP[StripView_IsVisible] + !$EXP[Infoscreen_IsVisible]">504</onback>
		<onup condition="$EXP[StripView_IsVisible] + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
		<ondown condition="$EXP[StripView_IsVisible] + !$EXP[Infoscreen_IsVisible]">504</ondown>
		<onback condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_IsVisible] + !$EXP[Infoscreen_IsVisible]">505</onback>
		<onleft condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_IsVisible] + !$EXP[Infoscreen_IsVisible]">505</onleft>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsFanart] + Integer.IsGreater(Container.NumItems,3) + !$EXP[Infoscreen_IsVisible]">SetFocus(4013)</onright>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsPosters] + Integer.IsGreater(Container.NumItems,5) + !$EXP[Infoscreen_IsVisible]">SetFocus(4013)</onright>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsSquare] + Integer.IsGreater(Container.NumItems,10) + !$EXP[Infoscreen_IsVisible]">SetFocus(4013)</onright>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsFanart] + Integer.IsLessorEqual(Container.NumItems,3) + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsPosters] + Integer.IsLessorEqual(Container.NumItems,5) + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
		<onright condition="!Skin.String(GridView_Size,Horizontal) + $EXP[GridView_Display_IsSquare] + Integer.IsLessorEqual(Container.NumItems,10) + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onright>
		<onback condition="Skin.String(GridView_Size,Horizontal) + $EXP[GridView_IsVisible] + !$EXP[Infoscreen_IsVisible]">505</onback>
		<onup condition="Skin.String(GridView_Size,Horizontal) + $EXP[GridView_IsVisible] + !$EXP[Infoscreen_IsVisible] + Integer.IsGreater(Container(3000).NumItems,0)">SetFocus(3000,0,absolute)</onup>
		<ondown condition="Skin.String(GridView_Size,Horizontal) + $EXP[GridView_IsVisible] + !$EXP[Infoscreen_IsVisible]">505</ondown>
	</include>

	<include name="Home_Menu_Navigation">
		<onup condition="Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio">SetFocus(3500,1)</onup>
		<onup condition="![Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio] + !Skin.HasSetting(GlobalSearch_Disabled)">4201</onup>
		<include content="widgets_onup">
			<param name="condition" value="![Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio] + Skin.HasSetting(GlobalSearch_Disabled)" />
		</include>
		<ondown>3200</ondown>
		<include content="widgets_cursor_resets" />
	</include>

	<include name="Search_Button_Navigation">
		<include content="widgets_onup">
			<param name="condition" value="true" />
		</include>
		<onright condition="Skin.HasSetting(Music_Player_Enabled) + Player.HasAudio">SetFocus(3500,1)</onright>
		<ondown>SetFocus(3000)</ondown>
		<onback>SetFocus(3000)</onback>
	</include>

	<include name="Home_Row_Navigation">
		<onleft condition="!Container.HasNext">0</onleft>
		<onright condition="!Container.HasPrevious">0</onright>
	</include>

	<include name="MovieInfo_Dialog_Menu_Navigation">
		<onback>SetFocus(4020)</onback>
		<ondown condition="$EXP[infoscreen_rails_focusable]">3200</ondown> <!-- the rails' grouplist: its first rail that can take focus -->
		<onup condition="$EXP[Music_Player_IsVisible]">SetFocus(3500,1)</onup>
		<include content="infoscreen_onup">
			<param name="condition" value="!$EXP[Music_Player_IsVisible] + $EXP[infoscreen_rails_focusable]" />
		</include>
		<include content="Widget_Position_Reset_OnFocus" />
	</include>

	<include name="MusicInfo_Dialog_Menu_Navigation">
		<include content="MovieInfo_Dialog_Menu_Navigation" />
	</include>

	<include name="AddonInfo_Dialog_Menu_Navigation">
		<ondown condition="Control.IsVisible(50)">SetFocus(50)</ondown>
		<include content="Widget_Position_Reset_OnFocus" />
	</include>

	<include name="Multiart_Reset_OnLoad">
		<!-- Home, Videos and Music are kept in memory: without these the next arrival would read the last visit's cursor and skip reseeding -->
		<onunload condition="Skin.HasSetting(Multiart_Slideshow)">ClearProperty(artwork_cursor_primary,home)</onunload>
		<onunload condition="Skin.HasSetting(Multiart_Slideshow)">ClearProperty(multiart_seed_scope_3400,home)</onunload>
		<onunload condition="Skin.HasSetting(Multiart_Slideshow)">ClearProperty(multiart_seed_sig_3400,home)</onunload>
	</include>

	<include name="Widget_Position_Reset_OnLoad">
		<onload condition="Integer.IsGreater(Container(3000).CurrentItem,1)">Control.Move(3000,$INFO[Container(3000).CurrentItem,-])</onload>
		<onload condition="Integer.IsGreater(Container(3000).CurrentItem,1)">Control.Move(3000,1)</onload>
		<onload condition="Integer.IsGreater(Container(50).CurrentItem,1)">Control.Move(50,$INFO[Container(50).CurrentItem,-])</onload>
		<onload condition="Integer.IsGreater(Container(50).CurrentItem,1)">Control.Move(50,1)</onload>
		<include content="infoscreen_resets_onload" />
	</include>

	<include name="Widget_Position_Reset_OnFocus">
		<onfocus condition="Integer.IsGreater(Container(50).CurrentItem,1)">Control.Move(50,$INFO[Container(50).CurrentItem,-])</onfocus>
		<onfocus condition="Integer.IsGreater(Container(50).CurrentItem,1)">Control.Move(50,1)</onfocus>
		<include content="infoscreen_resets_onfocus" />
	</include>

</includes>