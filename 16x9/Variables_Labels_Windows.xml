		<value condition="Control.HasFocus(16060) | Control.HasFocus(1606)">$LOCALIZE[31587]</value>
		<value condition="Control.HasFocus(16070) | Control.HasFocus(1607)">$LOCALIZE[31822]</value>
		<value condition="Control.HasFocus(16080) | Control.HasFocus(1608)">$LOCALIZE[31819]</value>
		<!-- Home -->
		<value condition="Control.HasFocus(1101)">$LOCALIZE[31529]</value>
		<value condition="Control.HasFocus(1110)">$LOCALIZE[31542]</value>
		<value condition="Control.HasFocus(1111)">$LOCALIZE[31543]</value>
		<value condition="Control.HasFocus(1118)">$LOCALIZE[31533]</value>
