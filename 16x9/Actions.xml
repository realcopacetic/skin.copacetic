				<param name="posb" value="$PARAM[posb]" />
				<param name="setting" value="Custom_SortMethod_Label" />
			</include>
			<include content="Widget_Move_String">
				<param name="condition" value="$PARAM[condition]" />
				<param name="posa" value="$PARAM[posa]" />
				<param name="posb" value="$PARAM[posb]" />
				<param name="setting" value="Custom_SortOrder" />
			</include>
			<include content="Widget_Move_String">
				<param name="condition" value="$PARAM[condition]" />
				<param name="posa" value="$PARAM[posa]" />
				<param name="posb" value="$PARAM[posb]" />
				<param name="setting" value="Custom_Limit" />
			</include>
			<!-- Focus reaches the moved widget through 4010 a frame later, once conditions are read afresh; a press before then finds nothing to click -->
			<onclick condition="$PARAM[condition]">SetProperty(Widget_Move,$PARAM[focus],home)</onclick>
			<onclick condition="$PARAM[condition]">SetFocus(4010)</onclick>
		</definition>
	</include>

	<!-- A click's conditions are all read before its first action runs, so the two toggles need no temp -->
	<include name="Widget_Move_Bool">
		<param name="condition" />
		<param name="posa" />
		<param name="posb" />
		<param name="setting" />
		<definition>
			<onclick condition="$PARAM[condition] + [Skin.HasSetting(Widget$PARAM[posa]_$PARAM[setting]) + !Skin.HasSetting(Widget$PARAM[posb]_$PARAM[setting]) | !Skin.HasSetting(Widget$PARAM[posa]_$PARAM[setting]) + Skin.HasSetting(Widget$PARAM[posb]_$PARAM[setting])]">Skin.ToggleSetting(Widget$PARAM[posa]_$PARAM[setting])</onclick>
			<onclick condition="$PARAM[condition] + [Skin.HasSetting(Widget$PARAM[posa]_$PARAM[setting]) + !Skin.HasSetting(Widget$PARAM[posb]_$PARAM[setting]) | !Skin.HasSetting(Widget$PARAM[posa]_$PARAM[setting]) + Skin.HasSetting(Widget$PARAM[posb]_$PARAM[setting])]">Skin.ToggleSetting(Widget$PARAM[posb]_$PARAM[setting])</onclick>
		</definition>
	</include>

	<!-- $ESCINFO is read as each action runs, so slot a's value waits in a property; its quotes keep commas and spaces -->
	<include name="Widget_Move_String">
		<param name="condition" />
		<param name="posa" />
		<param name="posb" />
		<param name="setting" />
		<definition>
			<onclick condition="$PARAM[condition]">SetProperty(Widget_Move,$ESCINFO[Skin.String(Widget$PARAM[posa]_$PARAM[setting])],home)</onclick>
			<onclick condition="$PARAM[condition]">Skin.SetString(Widget$PARAM[posa]_$PARAM[setting],$ESCINFO[Skin.String(Widget$PARAM[posb]_$PARAM[setting])])</onclick>
			<onclick condition="$PARAM[condition]">Skin.SetString(Widget$PARAM[posb]_$PARAM[setting],$ESCINFO[Window(home).Property(Widget_Move)])</onclick>
		</definition>
	</include>

</includes>