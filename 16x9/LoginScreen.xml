<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- loginscreen -->
	<defaultcontrol always="true">4010</defaultcontrol>
	<backgroundcolor>dark</backgroundcolor>
	<controls>
		<include content="loginscreen_Hidden" />
		<include content="Background_Multiart_Login" />
		<include content="Default_Dialog_Panel_Layout">
			<param name="visible" value="!$EXP[Hidden_Focus_Setter] + !System.HasVisibleModalDialog" />
			<param name="panel_edge_top" value="120" />
			<param name="panel_edge_bottom" value="120" />
			<control type="label">
				<label>$LOCALIZE[31900]</label>
				<top>180</top>
				<height>60</height>
				<centerleft>50%</centerleft>
				<width>1200</width>
				<align>center</align>
				<font>Title_Breadcrumb_Label</font>
				<textcolor>light</textcolor>
			</control>
			<control type="label">
				<centerleft>50%</centerleft>
				<width>720</width>
				<top>840</top>
				<height>60</height>
				<label>$INFO[ListItem.Label]</label>
				<textcolor>light</textcolor>
				<font>Grid_Title</font>
				<align>center</align>
				<aligny>center</aligny>
			</control>
			<include content="Button_Group_Template">
				<param name="right" value="900" />
				<param name="bottom" value="0" />
				<param name="onup" value="52" />
				<param name="button1" value="true" />
				<param name="button1_texture" value="Power" />
				<param name="button1_onclick" value="ActivateWindow(shutdownmenu)" />
				<param name="color" value="light" />
				<param name="unfocused_color" value="light" />
			</include>
		</include>
		<!-- The profiles in Strip (C2's strip template, texture_loginscreen_squareN), squares as the media view's but smaller: 360, focus 480 -->
		<control type="group">
			<visible>!$EXP[Hidden_Focus_Setter] + !System.HasVisibleModalDialog</visible>
			<include content="Visible_Fade_Delayed_Long_Animation" />
			<include content="tpl_strip_art">
				<param name="art" value="square" />
				<param name="centerx" value="240" />
				<param name="focus_height" value="480" />
				<param name="focus_top" value="300" />
				<param name="focus_width" value="480" />
				<param name="id" value="52" />
				<param name="item_height" value="360" />
				<param name="item_slide" value="360" />
				<param name="item_top" value="360" />
				<param name="item_width" value="360" />
				<param name="ladders_visible" value="true" />
				<param name="left_visible" value="true" />
				<param name="offleft_posx" value="-480" />
				<param name="offleft_slide" value="1200" />
				<param name="posx-1" value="360" />
				<param name="posx-2" value="0" />
				<param name="posx-3" value="-360" />
				<param name="posx0" value="720" />
				<param name="posx1" value="1200" />
				<param name="posx2" value="1560" />
				<param name="posx3" value="1920" />
				<param name="region" value="primary" />
				<param name="shadow_left" value="600" />
				<param name="texture_prefix" value="loginscreen" />
				<param name="visible" value="true" />
			</include>
		</control>
	</controls>
</window>