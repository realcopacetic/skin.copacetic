	<!-- Info -->
	<variable name="ContainerPath_0">
		<value condition="!String.IsEmpty(Container.FolderPath)">$INFO[Container.FolderPath]</value>
		<value condition="!String.IsEmpty(ListItem.FolderPath)">$INFO[ListItem.FolderPath]</value>
	</variable>
	<variable name="ContainerPath_X">
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,movie)">videodb://movies/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22movies%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,tvshow)">videodb://tvshows/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode) + Integer.IsGreater(ListItem.TVShowDBID,0)">$INFO[ListItem.TVShowDBID,videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
		<!-- The helper's episodes carry the show id as a property: a plugin can't set TVShowDBID -->
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode) + Integer.IsGreater(ListItem.Property(tvshowid),0)">$INFO[ListItem.Property(tvshowid),videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,artist)">musicdb://artists/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22artists%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,album)">musicdb://albums/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22albums%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,song)">musicdb://songs/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22songs%22%7D</value>
	</variable>

	<variable name="Path_MovieSet">
		<value condition="!String.IsEmpty(ListItem.SetID)">videodb://movies/titles/?setid=$INFO[ListItem.SetID]</value>
	</variable>

	<variable name="Path_Episodes">
		<value condition="Integer.IsGreater(ListItem.TVShowDBID,0) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.TVShowDBID,videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
		<!-- The helper's episodes carry the show id as a property: a plugin can't set TVShowDBID -->
		<value condition="Integer.IsGreater(ListItem.Property(tvshowid),0) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.Property(tvshowid),videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
	</variable>

	<variable name="Path_Seasons">
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,tvshow)">videodb://tvshows/titles/$INFO[ListItem.DBID]/</value>
		<value condition="Integer.IsGreater(ListItem.TVShowDBID,0)">videodb://tvshows/titles/$INFO[ListItem.TVShowDBID]/</value>
	</variable>

	<variable name="Path_ActorCredits">
		<!-- the focused cast member's other titles: an episode leaves out its show -->
		<value condition="!String.IsEmpty(Container(50).ListItem.Label) + Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode)">plugin://script.copacetic.helper/?info=actor_credits&amp;label=$INFO[Container(50).ListItem.Label]&amp;exclude_value=$INFO[ListItem.TVShowTitle]&amp;limit=50</value>
		<value condition="!String.IsEmpty(Container(50).ListItem.Label) + Integer.IsGreater(ListItem.DBID,0)">plugin://script.copacetic.helper/?info=actor_credits&amp;label=$INFO[Container(50).ListItem.Label]&amp;exclude_value=$INFO[ListItem.Title]&amp;limit=50</value>
		<!-- <value condition="!String.IsEmpty(Container(50).ListItem.Label) + String.IsEqual(ListItem.DBType,movie)">videodb://movies/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItem.Label]%22%5D%7D%5D%7D%2C%22type%22%3A%22movies%22%7D</value> -->
		<!-- <value condition="!String.IsEmpty(Container(50).ListItem.Label) + String.IsEqual(ListItem.DBType,tvshow)">videodb://tvshows/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItem.Label]%22%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value> -->
		<!-- Path for a mix of results from across the first 5 actors -->
		<!--<value>videodb://movies/titles/?xsp=%7B%22rules%22%3A%7B%22or%22%3A%5B%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(0).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(1).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(2).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(3).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(4).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(5).Label]%22%5D%7D%2C%7B%22field%22%3A%22actor%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22$INFO[Container(50).ListItemAbsolute(6).Label]%22%5D%7D%5D%7D%2C%22type%22%3A%22movies%22%7D</value>-->
		<value>special://skin/extras/playlists/empty.xsp</value> <!-- an empty URL would keep the last item's credits -->
	</variable>

	<variable name="Path_DirectorCredits">
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Director)">plugin://script.copacetic.helper/?info=director_credits&amp;label=$INFO[Container(9000).ListItem.Director]&amp;exclude_value=$INFO[ListItem.Title]&amp;sort=votes&amp;limit=50</value>
		<value>special://skin/extras/playlists/empty.xsp</value> <!-- also while 9000 still holds the last item's -->
	</variable>

	<variable name="Path_MusicVideos">
		<value condition="!String.IsEmpty(ListItem.Artist) + String.IsEqual(ListItem.DBType,artist)">videodb://musicvideos/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Artist]%5D%7D%5D%7D%2C%22type%22%3A%22musicvideos%22%7D</value>
		<value condition="!String.IsEmpty(ListItem.Artist) + !String.IsEmpty(ListItem.Album) + String.IsEqual(ListItem.DBType,album)">videodb://musicvideos/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Artist]%5D%7D%2C%7B%22field%22%3A%22album%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Album]%5D%7D%5D%7D%2C%22type%22%3A%22musicvideos%22%7D</value>
		<value condition="!String.IsEmpty(ListItem.Artist) + !String.IsEmpty(ListItem.Album) + !String.IsEmpty(ListItem.Title) + String.IsEqual(ListItem.DBType,song)">videodb://musicvideos/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Artist]%5D%7D%2C%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22musicvideos%22%7D</value>
	</variable>

	<variable name="Path_StudioCredits">
		<!-- the first studio. Shows: networks grouped with contains in an xsp, which a title with & would break, so it isn't left out -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Studio) + !String.IsEmpty(ListItem.TVShowTitle) + !String.Contains(ListItem.Title,&amp;)">videodb://tvshows/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22studio%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$VAR[Studio_Label]%5D%7D%2C%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22isnot%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value>
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Studio) + !String.IsEmpty(ListItem.TVShowTitle)">videodb://tvshows/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22studio%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$VAR[Studio_Label]%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value>
		<!-- films: the exact studio, as the xsp's is matched, through the helper, which keeps & and + -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Studio)">plugin://script.copacetic.helper/?info=studio_credits&amp;label=$INFO[Container(9000).ListItem.Studio]&amp;exclude_value=$INFO[ListItem.Title]&amp;type=movie&amp;sort=random&amp;limit=50</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_Discography">
		<value condition="!String.IsEmpty(ListItem.Artist) + String.IsEqual(ListItem.DBType,artist)">musicdb://albums/?artistid=$INFO[ListItem.DBID]</value>
		<!-- a song by its album artist: by id, which a name with & or + can't break -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(albumartist_id)) + String.IsEqual(ListItem.Artist,Container(9000).ListItem.Property(albumartist))">musicdb://albums/?artistid=$INFO[Container(9000).ListItem.Property(albumartist_id)]</value>
		<!-- a song: its artist's albums by name, as the header names it (& would break the xsp); else the first album artist's -->
		<value condition="!String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Artist) + !String.Contains(ListItem.Artist,&amp;)">musicdb://albums/?xsp=%7b%22rules%22%3a%7b%22and%22%3a%5b%7b%22field%22%3a%22artist%22%2c%22operator%22%3a%22is%22%2c%22value%22%3a%5b$ESCINFO[ListItem.Artist]%5d%7d%5d%7d%2c%22type%22%3a%22albums%22%7d</value>
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(albumartist_id))">musicdb://albums/?artistid=$INFO[Container(9000).ListItem.Property(albumartist_id)]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_Similar">
		<!-- the random genre's titles: a season or episode lists shows, leaving out its own -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Property(genre_query)) + [String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)]">plugin://script.copacetic.helper/?info=genre_credits&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.TVShowTitle]&amp;type=tvshow&amp;sort=random&amp;limit=20</value>
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Property(genre_query))">plugin://script.copacetic.helper/?info=genre_credits&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.Title]&amp;type=$INFO[ListItem.DBType]&amp;sort=random&amp;limit=20</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarArtists">
		<!-- artists in any of the artist's genres, its albums' too -->
		<value condition="Integer.IsGreater(ListItem.DBID,0)">plugin://script.copacetic.helper/?info=genre_music&amp;type=artist&amp;id=$INFO[ListItem.DBID]&amp;label=$INFO[ListItem.Genre]&amp;exclude_value=$INFO[ListItem.Artist]&amp;limit=20</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarAlbums">
		<!-- the random genre's albums, as the header names it -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(genre_query))">plugin://script.copacetic.helper/?info=genre_music&amp;type=album&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.Album]&amp;limit=20</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarSongs">
		<value condition="!String.IsEmpty(ListItem.Genre)">plugin://script.copacetic.helper/?info=genre_music&amp;type=song&amp;label=$INFO[ListItem.Genre]&amp;exclude_value=$INFO[ListItem.Title]&amp;limit=20</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>


	<!-- globalsearch -->
	<!-- An action run after Skin.SetString(globalsearch)'s keyboard closes: opens the results for a query -->
	<variable name="globalsearch_Open">
		<value condition="!String.IsEmpty(Skin.String(globalsearch))">ActivateWindow(1180)</value>
	</variable>
	<!-- Run after the results close (1180 is modal); skipped if they led to another window -->
	<variable name="globalsearch_Focus">
		<value condition="Window.IsActive(home) + !System.HasActiveModalDialog">SetFocus(3000)</value>
	</variable>

	<variable name="Path_globalsearch_Movies">
