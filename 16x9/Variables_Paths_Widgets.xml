<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<!-- Home -->
	<!-- Liked songs: an empty bound drops the rule, so with Like off the row would list every song -->
	<variable name="Path_LikedSongs_From">
		<value condition="Integer.IsGreater(Skin.String(like_threshold),0)">$INFO[Skin.String(like_threshold)]</value>
		<value>8</value>
	</variable>

	<!-- Info -->
	<variable name="ContainerPath_0">
		<value condition="!String.IsEmpty(Container.FolderPath)">$INFO[Container.FolderPath]</value>
		<value condition="!String.IsEmpty(ListItem.FolderPath)">$INFO[ListItem.FolderPath]</value>
	</variable>
	<variable name="ContainerPath_X">
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,movie)">videodb://movies/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22movies%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,tvshow)">videodb://tvshows/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value>
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode) + Integer.IsGreater(ListItem.TVShowDBID,0)">$INFO[ListItem.TVShowDBID,videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
		<!-- The helper's episodes carry the show id as a property: a plugin can't set TVShowDBID -->
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode) + Integer.IsGreater(ListItem.Property(tvshowid),0)">$INFO[ListItem.Property(tvshowid),videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
	</variable>

	<variable name="Path_MovieSet">
		<value condition="!String.IsEmpty(ListItem.SetID)">videodb://movies/titles/?setid=$INFO[ListItem.SetID]</value>
	</variable>

	<variable name="Path_Episodes">
		<value condition="Integer.IsGreater(ListItem.TVShowDBID,0) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.TVShowDBID,videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
		<!-- The helper's episodes carry the show id as a property: a plugin can't set TVShowDBID -->
		<value condition="Integer.IsGreater(ListItem.Property(tvshowid),0) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.Property(tvshowid),videodb://tvshows/titles/]$INFO[ListItem.Season,/,/]</value>
	</variable>

	<variable name="Path_Seasons">
		<value condition="Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,tvshow)">videodb://tvshows/titles/$INFO[ListItem.DBID]/</value>
		<value condition="Integer.IsGreater(ListItem.TVShowDBID,0)">videodb://tvshows/titles/$INFO[ListItem.TVShowDBID]/</value>
		<!-- The helper's episodes carry the show id as a property: a plugin can't set TVShowDBID -->
		<value condition="Integer.IsGreater(ListItem.Property(tvshowid),0)">videodb://tvshows/titles/$INFO[ListItem.Property(tvshowid)]/</value>
	</variable>

	<!-- The helper's rails below put names, titles and genres last: a | in a plugin URL ends its options, so it can only cut those -->
	<variable name="Path_ActorCredits">
		<!-- the focused cast member's other titles: an episode leaves out its show -->
		<value condition="!String.IsEmpty(Container(50).ListItem.Label) + Integer.IsGreater(ListItem.DBID,0) + String.IsEqual(ListItem.DBType,episode)">plugin://script.copacetic.helper/?info=actor_credits&amp;limit=50&amp;label=$INFO[Container(50).ListItem.Label]&amp;exclude_value=$INFO[ListItem.TVShowTitle]</value>
		<value condition="!String.IsEmpty(Container(50).ListItem.Label) + Integer.IsGreater(ListItem.DBID,0)">plugin://script.copacetic.helper/?info=actor_credits&amp;limit=50&amp;label=$INFO[Container(50).ListItem.Label]&amp;exclude_value=$INFO[ListItem.Title]</value>
		<value>special://skin/extras/playlists/empty.xsp</value> <!-- an empty URL would keep the last item's credits -->
	</variable>

	<variable name="Path_DirectorCredits">
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Director)">plugin://script.copacetic.helper/?info=director_credits&amp;sort=votes&amp;limit=50&amp;label=$INFO[Container(9000).ListItem.Director]&amp;exclude_value=$INFO[ListItem.Title]</value>
		<value>special://skin/extras/playlists/empty.xsp</value> <!-- also while 9000 still holds the last item's -->
	</variable>

	<variable name="Path_MusicVideos">
		<!-- an artist's through the helper, which keeps & and +; an album's or song's by name in an xsp, which a name with & or + leaves empty -->
		<value condition="!String.IsEmpty(ListItem.Artist) + String.IsEqual(ListItem.DBType,artist)">plugin://script.copacetic.helper/?info=artist_credits&amp;limit=50&amp;label=$INFO[ListItem.Artist]</value>
		<value condition="!String.IsEmpty(ListItem.Artist) + !String.IsEmpty(ListItem.Album) + String.IsEqual(ListItem.DBType,album)">videodb://musicvideos/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Artist]%5D%7D%2C%7B%22field%22%3A%22album%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Album]%5D%7D%5D%7D%2C%22type%22%3A%22musicvideos%22%7D</value>
		<value condition="!String.IsEmpty(ListItem.Artist) + !String.IsEmpty(ListItem.Title) + String.IsEqual(ListItem.DBType,song)">videodb://musicvideos/titles/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Artist]%5D%7D%2C%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[ListItem.Title]%5D%7D%5D%7D%2C%22type%22%3A%22musicvideos%22%7D</value>
		<value>special://skin/extras/playlists/empty.xsp</value> <!-- an empty URL would keep the last item's videos -->
	</variable>

	<variable name="Path_StudioCredits">
		<!-- the film's or show's other titles from its first studio or network, matched exactly, through the helper, which keeps & and + -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Studio)">plugin://script.copacetic.helper/?info=studio_credits&amp;type=$INFO[ListItem.DBType]&amp;sort=random&amp;limit=50&amp;label=$INFO[Container(9000).ListItem.Studio]&amp;exclude_value=$INFO[ListItem.Title]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_Discography">
		<value condition="!String.IsEmpty(ListItem.Artist) + String.IsEqual(ListItem.DBType,artist)">musicdb://albums/?artistid=$INFO[ListItem.DBID]</value>
		<!-- a song by its album artist: by id, which a name with & or + can't break -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(albumartist_id)) + String.IsEqual(ListItem.Artist,Container(9000).ListItem.Property(albumartist))">musicdb://albums/?artistid=$INFO[Container(9000).ListItem.Property(albumartist_id)]</value>
		<!-- a song: its artist's albums by name, as the header names it (& would break the xsp); else the first album artist's.
		     It waits on 9000 too, so a song whose artist is its album artist loads once, by id -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Artist) + !String.Contains(ListItem.Artist,&amp;)">musicdb://albums/?xsp=%7b%22rules%22%3a%7b%22and%22%3a%5b%7b%22field%22%3a%22artist%22%2c%22operator%22%3a%22is%22%2c%22value%22%3a%5b$ESCINFO[ListItem.Artist]%5d%7d%5d%7d%2c%22type%22%3a%22albums%22%7d</value>
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(albumartist_id))">musicdb://albums/?artistid=$INFO[Container(9000).ListItem.Property(albumartist_id)]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_Similar">
		<!-- the random genre's titles: a season or episode lists shows, leaving out its own -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Property(genre_query)) + [String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)]">plugin://script.copacetic.helper/?info=genre_credits&amp;type=tvshow&amp;sort=random&amp;limit=20&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.TVShowTitle]</value>
		<value condition="$EXP[Infoscreen_Metadata_Ready] + Integer.IsGreater(ListItem.DBID,0) + !String.IsEmpty(Container(9000).ListItem.Property(genre_query))">plugin://script.copacetic.helper/?info=genre_credits&amp;type=$INFO[ListItem.DBType]&amp;sort=random&amp;limit=20&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.Title]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarArtists">
		<!-- artists in any of the artist's genres, its albums' too -->
		<value condition="Integer.IsGreater(ListItem.DBID,0)">plugin://script.copacetic.helper/?info=genre_music&amp;type=artist&amp;id=$INFO[ListItem.DBID]&amp;limit=20&amp;label=$INFO[ListItem.Genre]&amp;exclude_value=$INFO[ListItem.Artist]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarAlbums">
		<!-- the random genre's albums, as the header names it -->
		<value condition="$EXP[Infoscreen_Metadata_Ready] + !String.IsEmpty(Container(9000).ListItem.Property(genre_query))">plugin://script.copacetic.helper/?info=genre_music&amp;type=album&amp;limit=20&amp;label=$INFO[Container(9000).ListItem.Property(genre_query)]&amp;exclude_value=$INFO[ListItem.Album]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

	<variable name="Path_SimilarSongs">
		<value condition="!String.IsEmpty(ListItem.Genre)">plugin://script.copacetic.helper/?info=genre_music&amp;type=song&amp;limit=20&amp;label=$INFO[ListItem.Genre]&amp;exclude_value=$INFO[ListItem.Title]</value>
		<value>special://skin/extras/playlists/empty.xsp</value>
	</variable>

</includes>