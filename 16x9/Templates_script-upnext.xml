<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- The play next card (Custom_1190_Playnext.xml). The helper only queues the show's next episode on the video playlist,
		so the card reads VideoPlayer.Offset(1); the playnext timer (Timers.xml) opens and closes it -->

	<!-- The playnext timer's start terms but the pause, which Timers.xml can't take as an expression: hides the card in the tick before the timer closes it -->
	<expression name="playnext_due">Skin.HasSetting(playnext_enabled) + Window.IsVisible(fullscreenvideo) + VideoPlayer.Content(episodes) + !String.IsEmpty(VideoPlayer.Offset(1).Title) + Integer.IsGreater(Player.TimeRemaining(secs),0) + Integer.IsLess(Player.TimeRemaining(secs),Skin.String(playnext_lead))</expression>
	<!-- The "Still there?" hold has paused playback: playnext_hold stamps it as it fires; a pause without the stamp is the user's -->
	<expression name="playnext_held">!String.IsEmpty(Window(1190).Property(playnext_hold)) + Player.Paused</expression>

	<include name="script-upnext_thumb">
		<control type="image">
			<animation effect="fadediffuse" end="ff555555" time="0" condition="true">Conditional</animation>
			<texture fallback="views/dark_grey_100.png">$VAR[script-upnext_Artwork]</texture>
		</control>
		<!-- The countdown: the bar shrinks to the left with the time left of the lead (includes_playnext.xml); gone while the hold's stamp is set -->
		<control type="group">
			<visible>String.IsEmpty(Window(1190).Property(playnext_hold))</visible>
			<bottom>0</bottom>
			<height>6</height>
			<animation effect="fade" end="0" time="0">WindowClose</animation> <!-- a close resets the open leg: hide the bar for the window's fade -->
			<control type="image">
				<texture colordiffuse="light15">views/white_100.png</texture>
			</control>
			<control type="image">
				<texture colordiffuse="light">views/white_100.png</texture>
				<include content="playnext_countdown" />
			</control>
		</control>
	</include>

	<include name="script-upnext_layout">
		<param name="height" default="180" />
		<definition>
			<control type="group">
				<width>320</width>
				<height>$PARAM[height]</height>
				<right>0</right>
				<bottom>0</bottom>
				<include content="script-upnext_thumb" />
				<control type="grouplist">
					<top>30</top>
					<bottom>90</bottom>
					<width>100%</width>
					<orientation>vertical</orientation>
					<align>center</align>
					<include content="Breadcrumb_Label">
						<param name="left" value="0" />
						<param name="right" value="0" />
						<param name="top" value="0" />
						<param name="align" value="center" />
						<param name="bar" value="false" />
						<param name="title_label" value="$VAR[script-upnext_Title_Label]" />
						<param name="title_font" value="MusicPlayer_Title" />
						<param name="maxtitlelabelwidth" value="180" />
						<param name="info_label" value="$VAR[script-upnext_Label]" />
						<param name="info_label_visible" value="!$EXP[playnext_held]" />
						<param name="info_font" value="MusicPlayer_Info" />
						<param name="maxinfolabelwidth" value="140" />
					</include>
				</control>
			</control>
		</definition>
	</include>

	<include name="script-upnext_template">
		<control type="group">
			<visible>$EXP[playnext_due]</visible> <!-- a user pause closes the card (the playnext timer), so it is never hidden while it has focus -->
			<include content="Visible_Fade_Delayed_Animation" />
			<include content="script-upnext_layout" condition="!Skin.String(script-upnext_Artwork,Square) + !Skin.String(script-upnext_Artwork,Posters)" />
			<include content="script-upnext_layout" condition="Skin.String(script-upnext_Artwork,Square)">
				<param name="height" value="320" />
			</include>
			<include content="script-upnext_layout" condition="Skin.String(script-upnext_Artwork,Posters)">
				<param name="height" value="480" />
			</include>
			<!-- The buttons, as Button_Group_Template draws them, written out for their conditional actions -->
			<include content="Hidden_Button_Grouplist">
				<control type="button" id="3012"> <!-- play now, or carry on after the hold; the player first, as a closing dialog drops actions -->
					<include content="Hidden_Button_Template" />
					<onclick condition="!$EXP[playnext_held]">PlayerControl(Next)</onclick>
					<onclick condition="$EXP[playnext_held]">PlayerControl(Play)</onclick>
					<onclick>Dialog.Close(1190)</onclick>
				</control>
				<control type="button" id="3013"> <!-- cancel: the episode plays out and nothing follows; Playlist.Clear empties the music playlist too -->
					<include content="Hidden_Button_Template" />
					<onclick condition="$EXP[playnext_held]">PlayerControl(Play)</onclick>
					<onclick>Playlist.Clear</onclick>
					<onclick>Dialog.Close(1190)</onclick>
				</control>
			</include>
			<include content="Button_Grouplist">
				<param name="bottom" value="0" />
				<param name="height" value="120" />
				<param name="right" value="40" />
				<include content="Button_Template">
					<param name="alt_texture" value="Check" />
					<param name="target_id" value="3012" />
					<param name="texture" value="Play" />
					<param name="toggle_button" value="true" />
					<param name="use_alt_texture" value="$EXP[playnext_held]" />
				</include>
				<include content="Button_Template">
					<param name="target_id" value="3013" />
					<param name="texture" value="Cross" />
				</include>
			</include>
		</control>
	</include>
</includes>
