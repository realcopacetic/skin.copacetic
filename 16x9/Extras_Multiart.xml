<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <!-- The fanart slideshows' register 3401 (the background, info screens, visualisation): fanart1 to fanart15 are generated
       (includes_multiart.xml), and a caller's own <info> rows (the main fanart) join them; <randomize> shuffles all once at load -->
  <include name="Fanart_Multiart_Template">
    <param name="art" default="fanart" />
    <param name="info" default="ListItem" />
    <param name="transition_time" default="Multiart_Pause" />
    <definition>
      <control type="fadelabel" id="3401">
        <include content="Hidden_Control" />
        <font>Body</font>
        <nested />
        <include content="multiart_fanart_infos">
          <param name="art" value="$PARAM[art]" />
          <param name="info" value="$PARAM[info]" />
        </include>
        <randomize>true</randomize>
        <pauseatend>$PARAM[transition_time]</pauseatend>
        <scroll>false</scroll>
        <scrollout>false</scrollout>
        <resetonlabelchange>true</resetonlabelchange>
      </control>
    </definition>
  </include>

  <!-- 9300 holds the focused item: its bind's item (the cursor without its visit; an info dialog's close ring binds its token as current), or (C2's)
       a load ring's serve, which names no item, while its token stands (a service started after the window: Kodi's start, a helper restart) -->
  <expression name="multiart_item_current">[String.IsEqual(Container(9300).ListItem.Property(item),Window(home).Property(artwork_item_primary)) + !String.IsEmpty(Window(home).Property(artwork_item_primary))] | [String.IsEmpty(Container(9300).ListItem.Property(item)) + !String.IsEmpty(Window(home).Property(artwork_item_primary)) + !String.IsEmpty(Window(home).Property(moved_primary)) + String.IsEqual(Container(9300).ListItem.Property(current),Window(home).Property(moved_primary))]</expression>
  <!-- ...and its family turns (C2's name): 9300's own, or 9400's slide for it, held while the embedded list's serve leaves 9300 the item with none -->
  <expression name="multiart_current_primary">$EXP[multiart_item_current] + [!String.IsEmpty(Container(9300).ListItem.Art(multiart)) | $EXP[multiart_slide_current]]</expression>
  <!-- 9400 has turned for 9300's item (C2's multiart_band_current): the same identity (C1's kept visit names the arrival: an info close carries on), 9300's
       current extends it (3100's serve: the cursor's s<position>; holds a fading copy past a move), or the cursor does (an info close from 3100) -->
  <expression name="multiart_slide_current">!String.IsEmpty(Container(9400).ListItem.Property(identity)) + [String.IsEqual(Container(9400).ListItem.Property(identity),Container(9300).ListItem.Property(identity)) | String.StartsWith(Container(9300).ListItem.Property(current),Container(9400).ListItem.Property(identity)) | String.StartsWith(Window(home).Property(artwork_cursor_primary),Container(9400).ListItem.Property(identity))]</expression>
  <!-- The windows holding 9400 (MyViews_Multiart_Labels): include condition for the multiart images of the views on C2's code -->
  <expression name="multiart_window">Skin.HasSetting(Multiart_Slideshow) + [Window.Is(home) | Window.Is(videos) | Window.Is(music)]</expression>
  <!-- The slide on screen (C2's): 9400's once it has turned for 9300's item, else slide 0, 9300's own; 9400 keeps its slide when the turn stops -->
  <variable name="texture_multiart">
    <value condition="$EXP[multiart_slide_current]">$INFO[Container(9400).ListItem.Art(slide)]</value>
    <value>$INFO[Container(9300).ListItem.Art(multiart)]</value>
  </variable>
  <!-- Asks 9300 for the family (on a scrollbar, Artwork_Serve's first row reads none: it waits for focus to return) -->
  <expression name="multiart_serve">Skin.HasSetting(Multiart_Slideshow) + !String.IsEmpty(Control.GetLabel(6400))</expression>

  <!-- cursor_key: the served handler names the bind's identity from the settle's cursor, visit and all (handlers.py artwork) -->
  <variable name="Params_Multiart">
    <value condition="$EXP[multiart_serve]">&amp;cursor_key=primary&amp;multiart=$INFO[Control.GetLabel(6400)]&amp;multiart_max=15&amp;slides=9400:6932</value>
  </variable>

  <include name="MyViews_Multiart_Labels">
    <include content="Hidden_Components">
      <control type="label" id="6400">
        <label>$VAR[Multiart_Type]</label>
      </control>
    </include>
    <!-- C2's slides: the service turns the family 9300's bind carries on 9400, a list with no <content>, one bind a beat, each slide made with
         probe 6932's params (helper docs/service/serve.md, Multiart). C1 draws no blur, but a slide binds only with one (serve.py _slide) -->
    <control type="label" id="6932">
      <visible>false</visible>
      <label>background_blur=true</label>
    </control>
    <control type="list" id="9400">
      <width>0</width>
      <height>0</height>
      <itemlayout />
      <focusedlayout />
    </control>
  </include>

</includes>