<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <!-- The fanart slideshows' register 3401 (the background, info screens, visualisation): fanart1 to fanart15 are generated
       (includes_multiart.xml), and a caller's own <info> rows (the main fanart) join them; <randomize> shuffles all once at load -->
  <include name="Fanart_Multiart_Template">
    <param name="art" default="fanart" />
    <param name="info" default="ListItem" />
    <param name="transition_time" default="Multiart_Pause" />
    <definition>
      <control type="fadelabel" id="3401">
        <include content="Hidden_Control" />
        <font>Body</font>
        <nested />
        <include content="multiart_fanart_infos">
          <param name="art" value="$PARAM[art]" />
          <param name="info" value="$PARAM[info]" />
        </include>
        <randomize>true</randomize>
        <pauseatend>$PARAM[transition_time]</pauseatend>
        <scroll>false</scroll>
        <scrollout>false</scrollout>
        <resetonlabelchange>true</resetonlabelchange>
      </control>
    </definition>
  </include>

  <!-- 9300 holds the focused item: its bind's item (the cursor without its visit; an info dialog's close ring binds its token as current), or (C2's)
       a load ring's serve, which names no item, while its token stands (a service started after the window: Kodi's start, a helper restart) -->
  <expression name="multiart_item_current">[String.IsEqual(Container(9300).ListItem.Property(item),Window(home).Property(artwork_item_primary)) + !String.IsEmpty(Window(home).Property(artwork_item_primary))] | [String.IsEmpty(Container(9300).ListItem.Property(item)) + !String.IsEmpty(Window(home).Property(artwork_item_primary)) + !String.IsEmpty(Window(home).Property(moved_primary)) + String.IsEqual(Container(9300).ListItem.Property(current),Window(home).Property(moved_primary))]</expression>
  <!-- ...and that serve seeded register 3400 -->
  <expression name="multiart_current_3400">$EXP[multiart_item_current] + !String.IsEmpty(Container(9300).ListItem.Art(multiart))</expression>
  <expression name="multiart_shown">Control.IsVisible(5012)</expression>
  <!-- The windows holding register 3400 (MyViews_Multiart_Labels): include condition for the multiart images of the views on C2's code -->
  <expression name="multiart_window">Skin.HasSetting(Multiart_Slideshow) + [Window.Is(home) | Window.Is(videos) | Window.Is(music)]</expression>
  <!-- Register 3400's slide, as those images read it -->
  <variable name="texture_multiart_3400">
    <value>$INFO[Control.GetLabel(3400)]</value>
  </variable>
  <!-- Asks 9300 to seed (on a scrollbar, Artwork_Serve's first row reads none: seeding waits for focus to return) -->
  <expression name="multiart_serve">Skin.HasSetting(Multiart_Slideshow) + !String.IsEmpty(Control.GetLabel(6400))</expression>

  <variable name="Params_Multiart">
    <value condition="$EXP[multiart_serve]">&amp;cursor_key=primary&amp;multiart=$INFO[Control.GetLabel(6400)]&amp;multiart_fadelabel=3400&amp;multiart_max=15</value>
  </variable>

  <include name="Multiart_Cursor">
    <param name="id" />
    <definition>
      <!-- A move starts the next item from its main image; a return from the embedded list, a menu or the music player keeps its visit
           (atr_artwork_visit_stamp), which the helper's seed keys on, so its rotation carries on. Read against the cursor before this arrival's -->
      <onfocus condition="$EXP[artwork_cursor_hook] + [Container($PARAM[id]).OnNext | Container($PARAM[id]).OnPrevious | !String.StartsWith(Window(home).Property(artwork_cursor_primary),$PARAM[id]/)]">ClearProperty(multiart_seed_sig_3400,home)</onfocus>
    </definition>
  </include>

  <!-- On when a serve seeds the focused item; held after the embedded list's serve replaces 9300, which names the same item with no multiart.
       Reads its own state (law: a control's visible may read its own Control.IsVisible); false at open, as the cursor is cleared on unload -->
  <include name="Multiart_Shown_Latch">
    <control type="group" id="5012">
      <visible>[$EXP[multiart_current_3400] | Control.IsVisible(5012)] + $EXP[multiart_item_current]</visible>
    </control>
  </include>

  <!-- The helper fills it through the artwork serve (9300): main image first, the rest in a random order -->
  <include name="Multiart_Template">
    <control type="fadelabel" id="3400">
      <include content="Hidden_Control" />
      <font>Body</font>
      <pauseatend>Multiart_Pause</pauseatend>
      <scroll>false</scroll>
      <scrollout>false</scrollout>
    </control>
  </include>

  <include name="MyViews_Multiart_Labels">
    <include content="Hidden_Components">
      <control type="label" id="6400">
        <label>$VAR[Multiart_Type]</label>
      </control>
    </include>
    <include content="Multiart_Shown_Latch" />
    <include content="Multiart_Template" />
  </include>

</includes>