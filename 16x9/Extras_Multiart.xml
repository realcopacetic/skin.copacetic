  <include name="visualisation_Multiart_Template">
    <definition>
      <control type="fadelabel" id="3401">
        <include content="Hidden_Control" />
        <font>Body</font>
        <info>Player.Art(artist.fanart)</info>
        <info>Player.Art(artist.fanart1)</info>
        <info>Player.Art(artist.fanart2)</info>
        <info>Player.Art(artist.fanart3)</info>
        <info>Player.Art(artist.fanart4)</info>
        <info>Player.Art(artist.fanart5)</info>
        <info>Player.Art(artist.fanart6)</info>
        <info>Player.Art(artist.fanart7)</info>
        <info>Player.Art(artist.fanart8)</info>
        <info>Player.Art(artist.fanart9)</info>
        <info>Player.Art(artist.fanart10)</info>
        <info>Player.Art(artist.fanart11)</info>
        <info>Player.Art(artist.fanart12)</info>
        <info>Player.Art(artist.fanart13)</info>
        <info>Player.Art(artist.fanart14)</info>
        <info>Player.Art(artist.fanart15)</info>
        <randomize>true</randomize>
        <pauseatend>$PARAM[transition_time]</pauseatend>
        <scroll>false</scroll>
        <scrollout>false</scrollout>
        <resetonlabelchange>true</resetonlabelchange>
      </control>
    </definition>
  </include> 
  
  <!-- 9300 holds the focused item: a serve echoes the cursor, so moving on breaks the match at once -->
  <expression name="multiart_item_current">String.IsEqual(Container(9300).ListItem.Property(current),Window(home).Property(artwork_cursor_primary)) + !String.IsEmpty(Window(home).Property(artwork_cursor_primary))</expression>
  <!-- ...and that serve seeded register 3400 -->
  <expression name="multiart_current_3400">$EXP[multiart_item_current] + !String.IsEmpty(Container(9300).ListItem.Art(multiart)) + ![Container(9300).IsUpdating + String.IsEmpty(Window(home).Property(multiart_seed_sig_3400))]</expression>
  <expression name="multiart_shown">Control.IsVisible(5012)</expression>
  <!-- Asks 9300 to seed: the scrollbars page the list without a focus change, so seeding waits for focus to return -->
  <expression name="multiart_serve">Skin.HasSetting(Multiart_Slideshow) + !String.IsEmpty(Control.GetLabel(6400)) + !$EXP[Scrollbar_HasFocus]</expression>

  <variable name="Params_Multiart">
    <value condition="$EXP[multiart_serve]">&amp;cursor_key=primary&amp;multiart=$INFO[Control.GetLabel(6400)]&amp;multiart_fadelabel=3400&amp;multiart_max=15</value>
  </variable>

  <include name="Multiart_Cursor">
    <param name="id" />
    <definition>
      <!-- A move starts the next item from its main image; a return from the rail or a modal has no move, so its rotation carries on -->
      <onfocus condition="!Control.HasFocus(3100) + [Container($PARAM[id]).OnNext | Container($PARAM[id]).OnPrevious | !String.StartsWith(Window(home).Property(artwork_cursor_primary),$PARAM[id]/)]">ClearProperty(multiart_seed_sig_3400,home)</onfocus>
      <onfocus condition="!Control.HasFocus(3100)">SetProperty(artwork_cursor_primary,$PARAM[id]/$INFO[Container($PARAM[id]).CurrentItem]/$INFO[Container($PARAM[id]).ListItem.DBID]/,home)</onfocus>
    </definition>
  </include>

  <!-- On when a serve seeds the focused item; held after the rail's serve replaces 9300, which echoes the same cursor with no multiart.
       Reads its own state (law: a control's visible may read its own Control.IsVisible); false at open, as the cursor is cleared on unload -->
  <include name="Multiart_Shown_Latch">
    <control type="group" id="5012">
      <visible>[$EXP[multiart_current_3400] | Control.IsVisible(5012)] + [$EXP[multiart_item_current] | [Control.HasFocus(3100) + String.StartsWith(Container(9300).ListItem.Property(current),held/)]]</visible>
    </control>
  </include>

  <!-- The helper fills it through the artwork serve (9300): main image first, the rest in a random order -->
  <include name="Multiart_Template">
    <control type="fadelabel" id="3400">
      <include content="Hidden_Control" />
      <font>Body</font>
      <pauseatend>$PARAM[transition_time]</pauseatend>
      <scroll>false</scroll>
      <scrollout>false</scrollout>
    </control>
  </include>

  <include name="MyViews_Multiart_Labels">
    <param name="include_type_label" default="true" />
    <param name="template" default="Multiart" />
    <definition>
      <include content="Hidden_Components" condition="$PARAM[include_type_label]">
        <control type="label" id="6400">
          <label>$VAR[Multiart_Type]</label>
        </control>
      </include>
      <include content="Multiart_Shown_Latch" condition="$PARAM[include_type_label]" />
      <include content="$PARAM[template]_Template" condition="Skin.String(Multiart_Interval,3)">
        <param name="transition_time" value="3000" />
      </include>
      <include content="$PARAM[template]_Template" condition="Skin.String(Multiart_Interval,4) | !Skin.String(Multiart_Interval)">
        <param name="transition_time" value="4000" />
      </include>
      <include content="$PARAM[template]_Template" condition="Skin.String(Multiart_Interval,5)">
        <param name="transition_time" value="5000" />
      </include>
      <include content="$PARAM[template]_Template" condition="Skin.String(Multiart_Interval,7)">
        <param name="transition_time" value="7000" />
      </include>
      <include content="$PARAM[template]_Template" condition="Skin.String(Multiart_Interval,10)">
        <param name="transition_time" value="10000" />
      </include>
    </definition>
  </include>

</includes>