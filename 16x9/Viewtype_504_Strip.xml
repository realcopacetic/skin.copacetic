<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="StripView_Container">
		<control type="group">
			<visible>$EXP[StripView_IsVisible]</visible>
			<include content="Custom_List">
				<param name="folderwatch" value="true" />
				<param name="type" value="fixedlist" />
				<param name="visible" value="$PARAM[visible]" />
				<param name="id" value="504" />
				<param name="viewtype_label" value="Strip" />
				<param name="viewtype" value="wrap" />
				<param name="orientation" value="horizontal" />
				<include content="Clearlogo_Crop_Pass" condition="Window.Is(videos) | Window.Is(music)" />
			</include>
		</control>
	</include>

	<include name="StripView_Display">
		<param name="id" default="504" />
		<param name="art_icon" default="Strip" />
		<param name="media_view" default="true" />
		<param name="widget_view" default="false" />
		<param name="display" />
		<definition>
			<include content="Viewtype_Display_Template">
				<param name="viewtype_label" value="Strip" />
				<param name="visible" value="!Window.IsVisible(selectvideoversion)" />
				<param name="media_view" value="$PARAM[media_view]" />
				<include content="Trailer_Autoplay_Fade_Animation" condition="$EXP[trailer_include_videos] | $EXP[trailer_include_home]" />
				<include content="StripView_Art_$PARAM[display]" condition="$PARAM[widget_view]">
					<param name="target_id" value="$PARAM[id]" />
					<param name="art_icon" value="$PARAM[art_icon]" />
					<param name="container" value="$PARAM[container]" />
					<param name="animated_condition" value="$PARAM[animated_condition]" />
				</include>
				<include content="StripView_Art_Posters" condition="$PARAM[media_view] + !Window.Is(addonbrowser)">
					<param name="target_id" value="$PARAM[id]" />
					<param name="art_icon" value="$PARAM[art_icon]" />
				</include>
				<include content="StripView_Art_Fanart" condition="$PARAM[media_view] + !Window.Is(addonbrowser)">
					<param name="target_id" value="$PARAM[id]" />
					<param name="art_icon" value="$PARAM[art_icon]" />
				</include>
				<include content="StripView_Art_Square" condition="$PARAM[media_view]">
					<param name="target_id" value="$PARAM[id]" />
					<param name="art_icon" value="$PARAM[art_icon]" />
				</include>
			</include>
		</definition>
	</include>

	<include name="StripView_Details">
		<param name="id" default="504" />
		<param name="media_view" default="false" />
		<param name="widget_clearlogos" default="false" />
		<param name="include_progress" default="true" />
		<definition>
			<include content="Viewtype_Details_Template">
				<param name="visible" value="$PARAM[visible]" />
				<param name="viewtype_label" value="Strip" />
				<include content="Progress" condition="[Window.Is(videos) | Window.Is(home) | Window.Is(movieinformation)] + $PARAM[include_progress]">
					<param name="id" value="$PARAM[id]" />
					<param name="bottom" value="144" />
					<animation effect="slide" end="0,-30" time="0" condition="$EXP[StripView_Display_IsSquare] | $EXP[StripView_Display_IsFanart]">Conditional</animation>
					<animation effect="slide" end="75,0" time="0" condition="$EXP[StripView_Display_IsSquare] + !$EXP[StripView_Details_Off] + !$EXP[Infoscreen_Widget_HasFocus]">Conditional</animation>
					<animation effect="slide" end="320,0" time="0" condition="$EXP[StripView_Display_IsFanart] + !$EXP[StripView_Details_Off] + !$EXP[Infoscreen_Widget_HasFocus]">Conditional</animation>
				</include>
				<include content="Common_Details" condition="!$EXP[Infoscreen_IsVisible]">
					<param name="viewtype_label" value="Strip" />
					<param name="left" value="60" />
					<param name="width" value="600" />
					<param name="align" value="center" />
					<param name="logo_id" value="63$PARAM[id]" />
					<param name="logo_width" value="100%" />
					<param name="title_color" value="$VAR[Primary_Color]" />
					<param name="title_maxheight" value="336" />
					<param name="plot_maxheight" value="235" />
					<param name="widget_clearlogos" value="$PARAM[widget_clearlogos]" />
					<animation effect="slide" end="0,15" time="0" condition="$EXP[StripView_Display_IsFanart] | $EXP[StripView_Display_IsSquare]">Conditional</animation>
				</include>
				<include content="Variable_Title_Label" condition="!Window.Is(home) + !Window.Is(addoninformation)">
					<param name="checker" value="60$PARAM[id]" /> <!-- each rail's own checkers: Container(id).HasNext reads the first visible control with that id (GUIControlLookup.cpp:22-37) -->
					<param name="visible" value="[[$EXP[StripView_Media_IsVisible] | $EXP[StripView_Widget_Home_IsVisible]] + $EXP[StripView_Details_Title] + !$EXP[StripView_Logo_On]] | [$EXP[StripView_Widget_Rail_IsVisible] + !$EXP[infoscreen_seasons_title_hidden]]" />
					<param name="label" value="$VAR[Title_Label]" />
					<param name="textcolor" value="$VAR[Primary_Color]" />
					<animation effect="slide" end="0,-15" time="0" condition="$EXP[StripView_Display_IsSquare] | $EXP[StripView_Display_IsFanart]">Conditional</animation>
				</include>
			</include>
		</definition>
	</include>

</includes>