	<!-- One option row: the helper sets its label and value, moves its slider and hides it for kinds of item it doesn't apply to
	     (controls_content_types.json). The ids are the helper's sliderex convention, {id} slider and {id}0 button (control_factory.py:62-64) -->
	<include name="viewsettings_Slider_Row">
		<param name="id" />
		<param name="ondown" />
		<param name="onup" />
		<definition>
			<control type="group" id="$PARAM[id]1">
				<visible>Control.IsVisible($PARAM[id])</visible>
				<height>90</height>
				<defaultcontrol always="true">$PARAM[id]0</defaultcontrol>
				<!-- The row's underline, kept while Select moves focus between the button and its slider -->
				<control type="image">
					<visible>Control.HasFocus($PARAM[id]) | Control.HasFocus($PARAM[id]0)</visible>
					<texture border="2,2,62,2" colordiffuse="$VAR[Unfocused_Color]">dialogs/button_underline_except_60_right.png</texture>
				</control>
				<control type="button" id="$PARAM[id]0">
					<width>690</width>
					<texturefocus />
