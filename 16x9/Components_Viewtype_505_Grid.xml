	<include name="GridView_Overlay">
		<param name="displaytype_label" />
		<param name="include_slides" default="true" />
		<param name="left" />
		<param name="top" default="180" />
		<param name="width" />
		<param name="height" />
		<param name="edge" default="15" />
		<param name="title_max_height" default="300" />
		<param name="title_font" default="Grid_Title" />
		<param name="info_font" default="Grid_Info" />
		<definition>
			<control type="group">
				<include content="GridView_Overlay_Slides_$PARAM[displaytype_label]_Large" condition="!Skin.String(GridView_Size,Small) + !Skin.String(GridView_Size,Horizontal)" />
				<include content="GridView_Overlay_Slides_$PARAM[displaytype_label]_Small" condition="Skin.String(GridView_Size,Small)" />
				<include content="GridView_Overlay_Slides_$PARAM[displaytype_label]_Horizontal" condition="Skin.String(GridView_Size,Horizontal)" />
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<visible>$EXP[GridView_Display_Is$PARAM[displaytype_label]] + [$EXP[GridView_Details_On] | $EXP[GridView_Widget_IsVisible]] + !Window.IsVisible(pictureinfo)</visible>
				<control type="grouplist">
					<left>$PARAM[edge]</left>
					<right>$PARAM[edge]</right>
					<orientation>vertical</orientation>
					<align>center</align>
					<itemgap>0</itemgap>
					<control type="textbox">
						<height max="$PARAM[title_max_height]">auto</height>
						<font>$PARAM[title_font]</font>
						<textcolor>light</textcolor>
						<label>$VAR[Title_Label]</label>
						<align>center</align>
					</control>
					<control type="label">
						<visible>$EXP[GridView_Details_Info] | $EXP[GridView_Widget_IsVisible]</visible>
						<visible>!String.IsEmpty(Control.GetLabel(6004))</visible>
						<height>35</height>
						<font>$PARAM[info_font]</font>
						<textcolor>light</textcolor>
						<label>$INFO[Control.GetLabel(6004)]</label>
						<align>center</align>
					</control>
				</control>
			</control>
		</definition>
	</include>

	<include name="GridView_Widget_Overlay">
