	<!-- Widget: a Grid row's art on C1's reel (reel.xml): equal tiles, the focus second from the left after a sliver of the previous item, with C1's
		border and shadows and the neighbours bright; dimmed under a transparent dialog as before. Each art passes its slots' on-screen x -->
	<include name="GridView_Rail">
		<param name="border_protrusion" default="10" />
		<param name="border_size" default="11" />
		<param name="border_visible" default="true" /><!-- the focus border and shadows show only while this holds (the bookmarks: not under their buttons) -->
		<param name="dim_focus" default="false" /><!-- the focus half bright (Spotlight, unless the row prefers landscape) -->
		<param name="include_progress" default="true" /><!-- an info rail's mapping: false where the dialog's ListItem isn't the rail's (cast) -->
		<definition>
			<control type="group">
				<include content="Dialog_Over_Artwork_Fadediffuse_Animation" />
				<nested />
				<include content="tpl_reel">
					<param name="ani_dim_arrive" value="efx_reel_dim_leave" />
					<param name="ani_dim_focus" value="efx_reel_dim_hold" />
					<param name="ani_dim_leave" value="efx_reel_dim_settle" />
					<param name="art" value="$PARAM[art]" />
					<param name="border_color" value="$VAR[Accent_Color]" />
					<param name="border_over" value="true" />
					<param name="border_protrusion" value="$PARAM[border_protrusion]" />
					<param name="border_size" value="$PARAM[border_size]" />
					<param name="border_visible" value="$PARAM[border_visible]" />
					<param name="centerx" value="$PARAM[centerx]" />
					<param name="dim_focus" value="$PARAM[dim_focus]" />
					<param name="dim_neighbours" value="false" />
					<param name="id" value="$PARAM[id]" />
					<param name="item_height" value="$PARAM[item_height]" />
					<param name="item_slide" value="$PARAM[item_width]" />
					<param name="item_top" value="$PARAM[item_top]" />
					<param name="item_width" value="$PARAM[item_width]" />
					<param name="left_visible" value="true" />
					<param name="marks_window" value="[Window.Is(videos) | Window.Is(home) | Window.Is(movieinformation)] + [$PARAM[include_progress]]" />
					<param name="offright_slide" value="$PARAM[item_width]" />
					<param name="outer" value="true" />
					<param name="outer_far" value="$PARAM[outer_far]" />
					<param name="overlay" value="false" />
					<param name="position_out" value="$PARAM[position_out]" />
					<param name="posx-1" value="$PARAM[posx-1]" />
					<param name="posx-2" value="$PARAM[posx-2]" />
					<param name="posx0" value="$PARAM[posx0]" />
					<param name="posx1" value="$PARAM[posx1]" />
					<param name="posx2" value="$PARAM[posx2]" />
					<param name="posx3" value="$PARAM[posx3]" />
					<param name="posx4" value="$PARAM[posx4]" />
					<param name="posx5" value="$PARAM[posx5]" />
					<param name="posx_out" value="$PARAM[posx_out]" />
					<param name="region" value="$PARAM[region]" />
					<param name="rides_out" value="true" />
					<param name="right_visible" value="true" />
					<param name="texture_prefix" value="$PARAM[texture_prefix]" />
					<param name="title_shade" value="false" />
					<param name="visible" value="true" />
				</include>
			</control>
		</definition>
	</include>

