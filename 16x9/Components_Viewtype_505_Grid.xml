<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="Grid_Icon">
		<param name="icon" default="Check_focused" />
		<param name="visible" default="String.IsEqual(ListItem.Overlay,OverlayWatched.png)" />
		<param name="width" default="30" />
		<param name="left" default="0" />
		<param name="backing_visible" default="true" />
		<param name="color" default="$VAR[Progress_Grid_Text_Color]" />
		<definition>
			<control type="group">
				<visible>$PARAM[visible]</visible>
				<visible>!$EXP[TransparentDialog_IsVisible] + !$EXP[Scrollbar_HasFocus]</visible>
				<include content="Visible_Fade_Delayed_Animation" />
				<height>$PARAM[width]</height>
				<width>$PARAM[width]</width>
				<control type="image">
					<texture colordiffuse="$VAR[Accent_Color]">views/white_100.png</texture>
					<visible>$PARAM[backing_visible]</visible>
				</control>
				<include content="$PARAM[icon]">
					<param name="color" value="$PARAM[color]" />
					<param name="width" value="$PARAM[width]" />
				</include>
				<nested />
			</control>
		</definition>
	</include>

	<include name="GridView_Dropshadow">
		<param name="top_right" />
		<param name="right" />
		<param name="bottom_right" />
		<param name="bottom" />
		<param name="bottom_left" />
		<definition>
			<control type="group">
				<visible>!$EXP[TransparentDialog_IsVisible] + !Window.IsVisible(pictureinfo) + !$EXP[Scrollbar_HasFocus] + !$EXP[Music_Player_HasFocus] + !Window.IsVisible(busydialog)</visible>
				<include content="Visible_Fade_Animation" />
				<!-- Left Side -->
				<include content="DropShadow">
					<param name="left" value="-120" />
					<param name="top" value="0" />
					<param name="width" value="120" />
					<param name="height" value="100%" />
					<param name="visible" value="!Container(505).Column(0)" />
				</include>
				<!-- Top Left Corner -->
				<include content="DropShadow">
					<param name="left" value="-120" />
					<param name="top" value="-120" />
					<param name="width" value="120" />
					<param name="height" value="120" />
					<param name="texture" value="views/dropshadow_topleftcorner_120.png" />
					<param name="visible" value="!Container(505).Column(0) + !Container(505).Row(0)" />
				</include>
				<!-- Top Side -->
				<include content="DropShadow">
					<param name="left" value="0" />
					<param name="top" value="-120" />
					<param name="width" value="100%" />
					<param name="height" value="120" />
					<param name="texture" value="views/dropshadow_top_120.png" />
					<param name="visible" value="!Container(505).Row(0)" />
				</include>
				<!-- Top Right Corner -->
				<include content="DropShadow">
					<param name="left" value="100%" />
					<param name="top" value="-120" />
					<param name="width" value="120" />
					<param name="height" value="120" />
					<param name="flipx" value="true" />
					<param name="texture" value="views/dropshadow_topleftcorner_120.png" />
					<param name="visible" value="!Container(505).Row(0) + $PARAM[top_right]" />
				</include>
				<!-- Rigt Side -->
				<include content="DropShadow">
					<param name="left" value="100%" />
					<param name="top" value="0" />
					<param name="width" value="120" />
					<param name="height" value="100%" />
					<param name="flipx" value="true" />
