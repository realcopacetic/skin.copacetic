	<include name="Infoscreen_Widget_50_Cast">
		<include content="Infoscreen_Widget_Template">
			<param name="min_items" value="2" />
			<param name="widget_view" value="Grid" />
			<param name="widget_display" value="Posters" />
			<param name="widget_position" value="0" />
