<includes>

	<include name="BillboardView_Container">
		<control type="group">
			<visible>$EXP[BillboardView_IsVisible]</visible>
			<include content="Custom_List">
				<param name="folderwatch" value="true" />
				<param name="visible" value="$PARAM[visible]" />
				<param name="type" value="list" />
				<param name="id" value="501" />
				<param name="viewtype_label" value="Billboard" />
				<param name="viewtype" value="wide" />
				<param name="orientation" value="horizontal" />
			</include>
		</control>
	</include>

	<!-- The media windows' Billboard: C2's vue_billboard_fanart (billboard.xml) in the display's wrapper, which hides it while the listing
		changes and fades it for a trailer. secondary: the window's embedded list draws its art in the focus region, below the view's -->
	<include name="BillboardView_Media">
		<param name="secondary" default="false" />
		<param name="window" />
		<definition>
			<include content="Viewtype_Display_Template">
				<param name="media_view" value="true" />
				<param name="viewtype_label" value="Billboard" />
				<include content="Trailer_Autoplay_Fade_Animation" condition="$EXP[trailer_include_$PARAM[window]]" />
				<include content="vue_billboard_fanart">
					<param name="id" value="501" />
					<param name="secondary" value="[$PARAM[secondary]] + Window.Is(videos)" /><!-- Videos only: Music's list (an artist's albums) shows only in a square berth -->
					<param name="texture_prefix" value="primary" />
				</include>
			</include>
		</definition>
	</include>

	<!-- The rails' Billboard (Home rows, info screen rails): C2's vue_billboard_fanart on the rail's texture_prefix and region -->
	<include name="BillboardView_Art_Fanart">
		<include content="vue_billboard_fanart">
			<param name="id" value="$PARAM[id]" />
			<param name="region" value="$PARAM[region]" />
			<param name="texture_prefix" value="$PARAM[texture_prefix]" />
		</include>
	</include>

	<!-- A Home row's Billboard: the rail's art in the display's wrapper -->
	<include name="BillboardView_Display">
		<include content="Viewtype_Display_Template">
			<param name="viewtype_label" value="Billboard" />
			<include content="Trailer_Autoplay_Fade_Animation" condition="$EXP[trailer_include_videos] | $EXP[trailer_include_home]" />
			<include content="BillboardView_Art_$PARAM[display]">
				<param name="id" value="$PARAM[id]" />
				<param name="region" value="$PARAM[region]" />
				<param name="texture_prefix" value="$PARAM[texture_prefix]" />
			</include>
		</include>
	</include>

	<include name="BillboardView_Details">
		<param name="id" default="501" />
		<param name="media_view" default="false" />
		<param name="widget_clearlogos" default="false" />
		<param name="include_progress" default="true" />
		<definition>
			<include content="Viewtype_Details_Template">
				<param name="viewtype_label" value="Billboard" />
				<param name="visible" value="$PARAM[visible]" />
				<include content="Progress" condition="[Window.Is(videos) | Window.Is(home) | Window.Is(movieinformation)] + $PARAM[include_progress]">
					<param name="id" value="$PARAM[id]" />
				</include>
				<include content="Common_Details">
					<param name="logo_id" value="63$PARAM[id]" />
					<param name="widget_clearlogos" value="$PARAM[widget_clearlogos]" />
				</include>
			</include>
		</definition>
	</include>

</includes>