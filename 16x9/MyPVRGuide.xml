<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- tvguide / radioguide: stub, PVR isn't skinned (PVR_Stub) -->
	<!-- Kodi drives the guide's grid without checking it exists (a digit, waking from sleep), so hand over to the channels stub -->
	<onload condition="Window.Is(tvguide)">ReplaceWindow(tvchannels)</onload>
	<onload condition="Window.Is(radioguide)">ReplaceWindow(radiochannels)</onload>
	<backgroundcolor>$VAR[Dark_Color]</backgroundcolor>
	<controls>
		<include content="PVR_Stub" />
	</controls>
</window>