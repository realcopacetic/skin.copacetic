<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<!-- Grid's data source: never focused, it serves a set's films to Grid's breadcrumb and studio flag -->
	<include name="Secondary_List">
		<param name="visible" default="false" />
		<param name="left" default="0" />
		<param name="top" default="1080" />
		<param name="width" default="720" />
		<param name="height" default="1080" />
		<definition>
			<control type="fixedlist" id="3100">
				<visible>$PARAM[visible]</visible>
				<visible>Skin.HasSetting(Secondary_List_Enabled) + !$EXP[Content_Switching] + !$EXP[Scrollbar_HasFocus]</visible>
				<visible>String.Contains(ListItem.FolderPath,videodb://) | String.Contains(ListItem.FolderPath,musicdb://)</visible>
				<preloaditems>2</preloaditems>
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<orientation>vertical</orientation>
				<include content="Default_Scrolltime" />
				<include content="Hidden_Layout" />
				<content target="$VAR[Secondary_List_Target]" sortby="$VAR[Secondary_List_Sort]" sortorder="$VAR[Secondary_List_Sort_Order]" browse="never">$VAR[Secondary_List_Path]</content>
			</control>
		</definition>
	</include>

	<include name="Hidden_Layout">
		<itemlayout />
		<focusedlayout />
	</include>

	<include name="Secondary_List_Array">
		<!-- Outside the group below: a hidden group stops updating its children, so 5003/5004 would keep their last state -->
		<include content="User_Scroll_Delay_Template">
			<param name="onnext_id" value="5004" />
			<param name="onnext_trigger" value="Container(3100).OnNext" />
			<param name="onprevious_id" value="5003" />
			<param name="onprevious_trigger" value="Container(3100).OnPrevious" />
		</include>
		<!-- Holds for 1x after the list takes focus (Secondary_List_Taking_Focus), so the details wait for it to slide in; outside the group for the same reason -->
		<control type="group" id="5008">
			<visible>!Control.HasFocus(3100)</visible>
			<animation effect="slide" end="0,0" time="Default_Transition_1x" reversible="false">Hidden</animation>
		</control>
		<include content="prb_secondary_art" />
		<control type="group">
			<visible>!$EXP[Options_Switching] + !$EXP[Container_Switching] + !$EXP[Music_Player_HasFocus]</visible>
			<include content="Visible_Fade_Animation" />
			<!-- Billboard, List, Showcase and Strip: off screen, its art drawn in the view's focus region (secondary.xml) -->
			<include content="ctn_secondary" condition="Window.Is(videos)">
				<param name="visible" value="[[$EXP[BillboardView_Media_IsVisible] | $EXP[ListView_IsVisible] | $EXP[StripView_Display_IsPosters] | $EXP[StripView_Display_IsFanart] | $EXP[ShowcaseView_IsVisible]] + $EXP[Secondary_List_Video_Conditions]] | [$EXP[ShowcaseView_Display_IsSquare] + Container.Content(artists)]" />
			</include>
			<include content="ctn_secondary" condition="Window.Is(music)">
				<param name="visible" value="[$EXP[ListView_Display_IsThumbnails] | $EXP[StripView_Display_IsSquare] | $EXP[ShowcaseView_Display_IsSquare]] + Container.Content(artists)" />
			</include>
			<include content="Secondary_List" condition="Window.Is(videos)">
				<param name="visible" value="Control.HasFocus(505) + ListItem.IsCollection" />
			</include>
		</control>
	</include>

	<include name="Secondary_List_Icons">
		<control type="group">
			<animation effect="slide" start="0,0" end="-120,0" time="0" condition="true">Conditional</animation>
			<visible>$PARAM[visible]</visible>
			<visible>Control.HasFocus(3100)</visible>
			<width>120</width>
			<height>120</height>
			<left>$PARAM[left]</left>
			<centertop>50%</centertop>
			<control type="group">
				<visible>String.IsEqual(Container(3100).ListItem.Overlay,OverlayWatched.png)</visible>
				<include content="Check_focused">
					<param name="color" value="light" />
					<animation effect="slide" start="0,0" end="15,0" time="0" condition="$EXP[ListView_Display_IsThumbnails]">Conditional</animation>
				</include>
			</control>
		</control>
	</include>

</includes>