<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<!-- Color palette -->
	<variable name="Accent_Color">
		<value condition="Skin.String(User_Defined_Accent_Color)">$INFO[Skin.String(User_Defined_Accent_Color)]</value>
		<value>copacetic_accent_color</value>
	</variable>

	<!-- Theme -->
	<variable name="Primary_Color">
		<value condition="Skin.String(Theme,Light)">dark</value>
		<value>light</value>
	</variable>
	<variable name="Secondary_Color">
		<value condition="Skin.String(Theme,Light)">light_background</value>
		<value>dark</value>
	</variable>

	<!-- Diffuses  -->
	<!-- Use solid alpha for dimmed artwork to improve performance -->
	<variable name="Home_Artwork_Diffuse">
		<value condition="Skin.String(Background_Brightness,66)">brightness66</value>
		<value condition="Skin.String(Background_Brightness,50)">brightness50</value>
		<value condition="Skin.String(Background_Brightness,25)">brightness25</value>
		<value>brightness33</value>
	</variable>
	<variable name="Infoscreen_Artwork_Diffuse">
		<value condition="Skin.String(Infoscreen_Brightness,50)">brightness50</value>
		<value condition="Skin.String(Infoscreen_Brightness,25)">brightness25</value>
		<value>brightness33</value>
	</variable>
	<variable name="Dialogs_Artwork_Diffuse">
		<value condition="Window.Is(addonsettings)">brightness15</value>
		<value>brightness50</value>
	</variable>

	<!-- Alpha overlay masks -->
	<variable name="ListView_Panel_Mask">
		<value condition="[Window.IsVisible(addonbrowser) | Window.IsVisible(music) | Window.IsVisible(videos)] + $EXP[ListView_IsVisible] + !$EXP[Background_IsVisible]">dark_grey</value>
		<value condition="Skin.String(Background_Opacity,100)">dark_grey</value>
		<value condition="Skin.String(Background_Opacity,85)">dark_grey85</value>
		<value condition="Skin.String(Background_Opacity,66)">dark_grey66</value>
		<value condition="Skin.String(Background_Opacity,50)">dark_grey50</value>
		<value>dark_grey75</value>
	</variable>
	<variable name="Panel_Mask">
		<value condition="Window.IsVisible(pictureinfo)">dark_grey90</value>
		<value condition="Window.Is(addonbrowser) + Window.Is(filebrowser)">dark_grey75</value>
		<value condition="Window.IsVisible(visualisation) + $EXP[visualisation_Background_IsEmpty]">dark_grey</value>
		<value>$VAR[ListView_Panel_Mask]</value>
	</variable>
	<variable name="OSD_Background_Mask">
		<value condition="Skin.String(OSD_Background_Brightness,50)">dark50</value>
		<value condition="Skin.String(OSD_Background_Brightness,33)">dark66</value>
		<value>dark75</value>
	</variable>
	<variable name="Transparent_Dialog_Mask">
		<value condition="VideoPlayer.IsFullscreen">$VAR[OSD_Background_Mask]</value>
		<value>dark50</value>
	</variable>
	<variable name="visualisation_Mask">
		<value condition="!Skin.HasSetting(visualisation_Disable_Background)">dark</value>
		<value>$VAR[Secondary_Color]</value>
	</variable>

