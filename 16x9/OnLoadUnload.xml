			<defaultcontrol always="true">3002</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(mediasettings)">
			<defaultcontrol always="true">3003</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(playersettings)">
			<defaultcontrol always="true">3004</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(systemsettings)">
			<defaultcontrol always="true">3005</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(servicesettings)">
			<defaultcontrol always="true">3006</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(gamesettings)">
			<defaultcontrol always="true">3007</defaultcontrol>
		</include>
		<include content="Object_Include" condition="Window.Is(pvrsettings)">
			<defaultcontrol always="true">3008</defaultcontrol>
		</include>
	</include>

	<!-- Renamed settings: copy each old value once unless the new name has one (a Skin settings field's mirror writes its own),
	     then clear the old name. From Startup and Home's onload, which a skin update in place reaches without Startup -->
	<include name="Startup_Migrate_Settings">
		<onload condition="Skin.String(Background_Slideshow_Custom_Path) + !Skin.String(slideshow_path)">Skin.SetString(slideshow_path,$ESCINFO[Skin.String(Background_Slideshow_Custom_Path)])</onload>
		<onload condition="Skin.String(Background_Slideshow2_Custom_Path) + !Skin.String(slideshow2_path)">Skin.SetString(slideshow2_path,$ESCINFO[Skin.String(Background_Slideshow2_Custom_Path)])</onload>
		<onload condition="Skin.String(Music_Rating_Like_Threshold)">Skin.Reset(Music_Rating_Like_Threshold)</onload>
		<onload condition="Skin.String(Background_Interval)">Skin.Reset(Background_Interval)</onload>
		<onload condition="Skin.String(Background_Slideshow)">Skin.Reset(Background_Slideshow)</onload>
		<onload condition="Skin.String(Background_Slideshow_Custom_Path)">Skin.Reset(Background_Slideshow_Custom_Path)</onload>
		<onload condition="Skin.String(Background_Slideshow_Timer)">Skin.Reset(Background_Slideshow_Timer)</onload>
		<onload condition="Skin.HasSetting(Background_Slideshow2)">Skin.SetBool(Background_Slideshow2,false)</onload>
		<onload condition="Skin.String(Background_Slideshow2)">Skin.Reset(Background_Slideshow2)</onload>
		<onload condition="Skin.String(Background_Slideshow2_Custom_Path)">Skin.Reset(Background_Slideshow2_Custom_Path)</onload>
		<onload condition="Skin.String(Background_Slideshow2_Timer)">Skin.Reset(Background_Slideshow2_Timer)</onload>
		<onload condition="Skin.HasSetting(Billboard_Ken_Burns_Effect)">Skin.SetBool(Billboard_Ken_Burns_Effect,false)</onload>
		<onload condition="Skin.HasSetting(GlobalSearch_Disabled)">Skin.Reset(GlobalSearch_Disabled)</onload>
		<onload condition="Skin.HasSetting(visualisation_Disable_Background)">Skin.Reset(visualisation_Disable_Background)</onload>
		<!-- Up Next is replaced by the play next card: turn it off once (the helper notifies), after the first build's reload,
			which would close the notification (builder_ready is generated). Both conditions are read before either row runs -->
		<onload condition="System.AddonIsEnabled(service.upnext) + !Skin.HasSetting(upnext_turned_off) + $EXP[builder_ready]">RunScript(script.copacetic.helper,action=toggle_addon,id=service.upnext)</onload>
		<onload condition="!Skin.HasSetting(upnext_turned_off) + $EXP[builder_ready]">Skin.SetBool(upnext_turned_off)</onload>
		<!-- 3.0's note, once, for profiles that ran C1 before 3.0 (its Startup wrote Widget1_View). helper_active is set once the
			helper's build check is done, so another profile's rebuild and reload can't close the note as it opens -->
		<onload condition="Skin.String(Widget1_View) + !Skin.HasSetting(firstrun_3_shown) + $EXP[builder_ready] + !String.IsEmpty(Window(home).Property(helper_active))">RunScript(script.copacetic.helper,action=dialog_textviewer,"heading=$LOCALIZE[24054]","label=Copacetic 3.0 has been rebuilt under the hood, so your menus, Home rows, views and skin settings start again from their defaults, and age rating flags from the UK's BBFC. Choose them again in Skin settings.")</onload>
		<onload condition="Skin.String(Widget1_View) + !Skin.HasSetting(firstrun_3_shown) + $EXP[builder_ready] + !String.IsEmpty(Window(home).Property(helper_active))">Skin.SetBool(firstrun_3_shown)</onload>
	</include>

</includes>