<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- C1's copy of the parts of C2's secondary.xml that the embedded list in a focus region uses, under C2's names so a C2 fix diffs across.
		C1 has no jumpbar, so no entry hold or double tap; its relays are 4107-4111 -->

	<!-- The family the focus region's list art is drawn from (secondary_art_*, Expressions.xml), so the probes compare that art -->
	<variable name="texture_probe_base_secondary">
		<value condition="$EXP[secondary_art_fanart]">$VAR[texture_secondary_fanart_base0]</value>
		<value condition="$EXP[secondary_art_poster]">$VAR[texture_secondary_poster_base0]</value>
		<value>$VAR[texture_secondary_square_base0]</value>
	</variable>
	<variable name="texture_probe_secondary">
		<value condition="$EXP[secondary_art_fanart]">$VAR[texture_secondary_fanart0]</value>
		<value condition="$EXP[secondary_art_poster]">$VAR[texture_secondary_poster0]</value>
		<value>$VAR[texture_secondary_square0]</value>
	</variable>

	<!-- The embedded list in Billboard, List, Showcase and Strip: off screen, its art drawn by blk_secondary_art in the view's focus region -->
	<include name="ctn_secondary">
		<control type="fixedlist" id="3100">
			<visible>$PARAM[visible]</visible>
			<visible>Skin.HasSetting(Secondary_List_Enabled) + !$EXP[Content_Switching] + !$EXP[Scrollbar_HasFocus]</visible>
			<visible>String.Contains(ListItem.FolderPath,videodb://) | String.Contains(ListItem.FolderPath,musicdb://)</visible>
			<left>3840</left>
			<width>1920</width>
			<height>1080</height>
			<orientation>vertical</orientation>
			<preloaditems>2</preloaditems>
			<focusposition>0</focusposition>
			<content target="$VAR[Secondary_List_Target]" sortby="$VAR[Secondary_List_Sort]" sortorder="$VAR[Secondary_List_Sort_Order]" browse="never">$VAR[Secondary_List_Path]</content>
			<focusedlayout width="640" height="360">
				<control type="group"><!-- C1: the hooks wait until the list itself holds focus, not its reset on the way out -->
					<visible>![Control.HasFocus(50) | Control.HasFocus(501) | Control.HasFocus(502) | Control.HasFocus(504)]</visible>
					<include content="HiddenFocusButton">
						<param name="id" value="3100" />
						<param name="ladders" value="true" />
					</include>
					<include content="btn_trailer" condition="$EXP[trailer_include_videos] + Window.Is(videos)">
						<param name="enabled" value="$EXP[trailer_visible_videos]" />
						<param name="focus_ids" value="3100" />
						<param name="id" value="3100" />
						<param name="item" value="Container(3100).ListItem.Label" />
						<param name="source_prefix" value="3100" />
						<param name="trailer" value="Container(3100).ListItem.Trailer" />
					</include>
				</control>
				<include content="img_layout_preload"><!-- C1: warms the list's art while blk_secondary_art is down; the cursor item draws this layout focused or not -->
					<param name="texture" value="$VAR[texture_probe_secondary]" />
				</include>
			</focusedlayout>
			<onfocus condition="!Control.IsVisible(6315) + !$EXP[Options_Switching] + !$EXP[Container_Switching]">SetFocus(4111)</onfocus><!-- C1: focus that skipped the entry (the menu key's return) goes round through it, so the region scrolls to the list's art -->
			<onfocus condition="!Control.IsVisible(6315) + [$EXP[Options_Switching] | $EXP[Container_Switching]]">SetFocus(50)</onfocus><!-- while a switch hides the view, a copy of the list frozen visible can take focus, and 4111 would be hidden too: back to the view -->
			<include content="atr_navigation_secondary_vertical" />
			<include content="Default_Scrolltime" />
			<include content="blk_layouts">
				<param name="fanart" value="$EXP[secondary_art_fanart]" />
				<param name="posters" value="$EXP[secondary_art_poster]" />
			</include>
		</control>
	</include>

	<!-- C1's routes: Up stops, Down off the last item to the scrollbar (List: stops), sides and Back to the view (List's Left: options),
		each through the primary art (btn_secondary_redirect), which scrolls the focus region back -->
	<include name="atr_navigation_secondary_vertical">
		<onup condition="$EXP[trailer_playing]">PlayerControl(Stop)</onup>
		<onup condition="!$EXP[trailer_playing]">0</onup>
		<ondown condition="$EXP[trailer_playing]">PlayerControl(Stop)</ondown>
		<ondown condition="!$EXP[trailer_playing] + $EXP[ListView_IsVisible]">0</ondown><!-- a row that holds stops the list wrapping round to its first item -->
		<ondown condition="!$EXP[trailer_playing] + !$EXP[ListView_IsVisible]">SetFocus(4110)</ondown>
		<onleft condition="$EXP[trailer_playing]">PlayerControl(Stop)</onleft>
		<onleft condition="!$EXP[trailer_playing] + $EXP[ListView_IsVisible]">SetFocus(4110)</onleft>
		<onleft condition="!$EXP[trailer_playing] + !$EXP[ListView_IsVisible]">SetFocus(4107)</onleft>
		<onright condition="$EXP[trailer_playing]">PlayerControl(Stop)</onright>
		<onright condition="!$EXP[trailer_playing]">SetFocus(4107)</onright>
		<include content="atr_trailer_back" />
		<onback condition="!$EXP[trailer_playing]">4107</onback><!-- bare id so Back is consumed: back to the view through the relay, never up a folder -->
	</include>

	<include name="blk_secondary_art">
		<param name="dim" default="false" /><!-- C1: half bright while this holds (Showcase's details over the art); no marks inside to spare -->
		<param name="height" default="720" />
		<param name="id" default="3100" />
		<param name="width" default="480" />
		<definition>
			<control type="group"><!-- C1: up with prb_secondary_art. Hidden, it drops out of the region, which then snaps back to the view's
				art however focus left (menu, a rail's click, a new listing, the mouse, a window exit) -->
				<visible>Control.IsVisible(6315)</visible>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<animation effect="fadediffuse" end="ff808080" time="0" condition="$PARAM[dim]">Conditional</animation>
				<include content="tpl_art_focused"><!-- static -->
					<param name="height" value="$PARAM[height]" />
					<param name="id" value="$PARAM[id]" />
					<param name="position" value="0" />
					<param name="texture_stub" value="$PARAM[texture_stub]_base" />
					<param name="width" value="$PARAM[width]" />
					<control type="button" id="4108"><!-- C2's 4101: last in the focus region, so focusing it scrolls the region to this art -->
						<visible allowhiddenfocus="true">false</visible>
						<hitrect x="0" y="0" w="-1" h="-1" /><!-- as each relay: no mouse target. With no size it would cover the berth, and a pointer over the art would focus it -->
						<onfocus>SetFocus($PARAM[id],0)</onfocus>
					</control>
				</include>
				<include content="tpl_art_transition"><!-- transition -->
					<param name="id" value="$PARAM[id]" />
					<param name="region" value="secondary" />
					<param name="texture_probe_destination" value="6313" />
					<param name="texture_probe_source" value="6314" />
					<param name="texture_stub" value="$PARAM[texture_stub]" />
					<param name="zoom_center_next" value="$PARAM[zoom_center_next]" />
					<param name="zoom_center_prev" value="$PARAM[zoom_center_prev]" />
				</include>
				<include content="prb_texture_secondary" />
			</control>
		</definition>
	</include>

	<include name="btn_secondary_redirect">
		<control type="button" id="4107"><!-- C2's 4100: first in the focus region, so focusing it scrolls the region back. C1: it holds
			focus for the scroll (onfocus runs as its Focus animation ends), then resets the list out of sight -->
			<visible allowhiddenfocus="true">false</visible>
			<hitrect x="0" y="0" w="-1" h="-1" />
			<include content="atr_secondary_hold_back" />
			<onfocus>SetFocus(3100,0,absolute)</onfocus>
			<onfocus>SetFocus(50)</onfocus>
			<animation effect="slide" end="0,0" time="Default_Transition_1x" reversible="false">Focus</animation>
		</control>
		<control type="button" id="4110"><!-- C1: 4107 for the list's other way out: on to the options menu from List's Left, else to the scrollbar from
			Down off the last item -->
			<visible allowhiddenfocus="true">false</visible>
			<hitrect x="0" y="0" w="-1" h="-1" />
			<include content="atr_secondary_hold_back" />
			<onfocus>SetFocus(3100,0,absolute)</onfocus>
			<onfocus condition="$EXP[ListView_IsVisible]">SetFocus(3000,0)</onfocus>
			<onfocus condition="!$EXP[ListView_IsVisible]">SetFocus(4013)</onfocus>
			<animation effect="slide" end="0,0" time="Default_Transition_1x" reversible="false">Focus</animation>
		</control>
		<control type="button" id="4111"><!-- C1: the entry's first step. Its onfocus waits for a Process (the Focus animation), in which prb_secondary_art
			comes up, so 4108 can take focus and scroll the region, and 3100's onfocus never sends focus round again -->
			<visible allowhiddenfocus="true">false</visible>
			<hitrect x="0" y="0" w="-1" h="-1" />
			<include content="atr_secondary_hold_back" />
			<onfocus>SetFocus(4108)</onfocus>
			<animation effect="slide" end="0,0" time="Default_Transition_0x" reversible="false">Focus</animation>
		</control>
	</include>

	<include name="atr_secondary_hold_back"><!-- C1: Back on a relay (4107's or 4110's hold, 4111's frame on the menu key's return) finishes in this window: the reset, then the view.
		A bare id so Back is consumed; the unfocus drops the relay's own onfocus -->
		<onback>SetFocus(3100,0,absolute)</onback>
		<onback>50</onback>
	</include>

	<include name="prb_secondary_art"><!-- C1: up while the list or a relay holds focus. One copy, processed whatever the views show, so
		blk_secondary_art and 3100's onfocus read a current state -->
		<control type="group" id="6315">
			<visible>Control.HasFocus(3100) | Control.HasFocus(4107) | Control.HasFocus(4108) | Control.HasFocus(4110) | Control.HasFocus(4111)</visible>
		</control>
	</include>

	<include name="prb_texture_secondary"><!-- C2's texture probes 6303/6304 (blk_probes) for tpl_art_transition; a hidden label still answers Control.GetLabel -->
		<control type="label" id="6313">
			<visible>false</visible>
			<label>$VAR[texture_probe_secondary]</label>
		</control>
		<control type="label" id="6314">
			<visible>false</visible>
			<label>$VAR[texture_probe_base_secondary]</label>
		</control>
	</include>

</includes>
