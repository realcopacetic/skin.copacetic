				<param name="visible" value="$PARAM[visible] + !$EXP[Container_Addons_NonRepo]" />
				<param name="fadein_animation_condition" value="!$EXP[Background_FadeIn_Exceptions]" />
				<param name="fadeout_animation_condition" value="!$EXP[Background_FadeOut_Exceptions]" />
			</include>
			<!-- Layer 1 -->
			<control type="group">
				<include content="WindowOpenClose_Fade_Delayed_Animation" />
				<include content="Dialog_Over_Artwork_Fadediffuse_Animation" />
				<visible>$PARAM[visible]</visible>
				<include content="Visible_Fade_Delayed_Animation" />
				<include content="ListView_Display">
					<param name="art_icon" value="addonbrowser" />
				</include>
				<include content="ShowcaseView_Container" condition="$EXP[layout_showcase_include_$PARAM[window]]">
					<param name="visible" value="$EXP[layout_showcase_visible_$PARAM[window]]" />
				</include>
				<include content="ShowcaseView_Display" condition="$EXP[layout_showcase_include_$PARAM[window]]">
					<param name="art_icon" value="addonbrowser" />
				</include>
				<include content="StripView_Container" condition="$EXP[layout_strip_include_$PARAM[window]]">
					<param name="visible" value="$EXP[layout_strip_visible_$PARAM[window]]" />
				</include>
				<include content="StripView_Display" condition="$EXP[layout_strip_include_$PARAM[window]]">
					<param name="art_icon" value="addonbrowser" />
				</include>
				<include content="Shared_Dialog_Layouts" condition="Skin.HasSetting(Music_Player_Enabled)" />
				<include content="GridView_Container" condition="$EXP[layout_grid_include_$PARAM[window]]">
					<param name="art_icon" value="addonbrowser" />
					<param name="visible" value="$EXP[layout_grid_visible_$PARAM[window]]" />
				</include>
			</control>
			<!-- Layer 2 -->
			<control type="group">
				<include content="WindowOpenClose_Fade_Delayed_Long_Animation" />
				<visible>$PARAM[visible]</visible>
				<include content="Visible_Fade_Delayed_Long_Animation" />
