					<param name="visible" value="$EXP[layout_list_visible_$PARAM[window]]" />
				</include>
				<include content="ListView_Details" />
				<include content="ShowcaseView_Details" condition="$EXP[layout_showcase_include_$PARAM[window]]" />
				<include content="StripView_Details" condition="$EXP[layout_strip_include_$PARAM[window]]" />
				<include content="GridView_Overlay_Details" condition="$EXP[layout_grid_include_$PARAM[window]]" />
			</control>
		</definition>
	</include>

