<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<variable name="AutoComplete_Path">
		<value condition="System.AddonIsEnabled(plugin.program.autocompletion) + !System.HasHiddenInput">plugin://plugin.program.autocompletion?info=autocomplete&amp;&amp;id=$INFO[Control.GetLabel(312).index(1)]&amp;&amp;limit=9</value>
	</variable>

	<include name="Background_Home_Content">
		<content sortby="random" limit="40" browse="never">$VAR[Background_Home_Path]</content>
	</include>

	<include name="Background_Login_Content">
		<content sortby="random" limit="40" browse="never">$VAR[Background_Login_Path]</content>
	</include>

	<variable name="Background_Home_Path">
		<!-- Item override -->
		<value condition="!String.IsEmpty(Container(3000).ListItem.Property(backgroundPlaylist))">$INFO[Container(3000).ListItem.Property(backgroundPlaylist)]</value>
		<!-- playlists, xml library paths e.g. inprogress or sets, video and music db:// -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),.xsp)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),.xml)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),db://)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<!-- music paths -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedalbums)">musicdb://recentlyaddedalbums/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyplayedalbums)">musicdb://recentlyplayedalbums/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),musicplaylists)">musicdb://artists/?albumartistsonly=true</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),musicdb)">musicdb://artists/?albumartistsonly=true</value>
		<!-- video paths -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedepisodes)">videodb://recentlyaddedepisodes/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),inprogresstvshows)">videodb://inprogresstvshows</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),tvshows)">videodb://tvshows/titles/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedmovies)">videodb://recentlyaddedmovies/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),sets)">videodb://movies/sets/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),movies)">videodb://movies/titles/</value>
		<!-- fallbacks -->
		<value condition="Library.HasContent(Movies)">videodb://movies/titles/</value>
		<value condition="Library.HasContent(TVShows)">videodb://tvshows/titles/</value>
		<value condition="Library.HasContent(Music)">musicdb://artists/?albumartistsonly=true</value>
	</variable>

	<variable name="Background_Login_Path">
		<value condition="Library.HasContent(Movies)">videodb://movies/titles/</value>
		<value condition="Library.HasContent(TVShows)">videodb://tvshows/titles/</value>
		<value condition="Library.HasContent(Music)">musicdb://artists/?albumartistsonly=true</value>
	</variable>

	<variable name="Secondary_List_Path">
		<value condition="Container.Content(movies) + ListItem.HasVideoVersions	">$INFO[ListItem.DBID,videodb://movies/videoversions/0?mediaid=,]</value>
		<value>$INFO[ListItem.FolderPath]</value>
	</variable>

	<variable name="Secondary_List_Sort">
		<value condition="Container.Content(tvshows)">season</value>
		<value>year</value>
	</variable>

	<variable name="Secondary_List_Sort_Order">
		<value condition="Window.Is(music)">descending</value>
		<value>ascending</value>
	</variable>

	<variable name="Secondary_List_Target">
		<value condition="Window.Is(music)">music</value>
		<value>videos</value>
	</variable>

	<!-- Keyed on the item, not its position (bare Container.CurrentItem is empty on Home); 9501 is no control, so nothing moves.
	     No modal dialog: the helper would read the dialog's container instead. -->
	<variable name="Set_Progress_Path">
		<value condition="Container.ListItem.IsCollection + String.IsEqual(Container.ListItem.Overlay,OverlayUnwatched.png) + !System.HasVisibleModalDialog">plugin://script.copacetic.helper/?info=progressbar&amp;focus_guard=$INFO[Container.ListItem.DBType],$INFO[Container.ListItem.DBID]&amp;identity_labels=Container.ListItem.DBType,Container.ListItem.DBID&amp;target_id=9501</value>
	</variable>

	<!-- The focused item's plain clearlogo cropped, and the details' logo (63 + view or widget id) set to its height in its logo_width x 240 box.
	     Any other item leaves the URL empty, which keeps the last crop, so readers match 9300's clean_label with the focused item's logo. -->
	<variable name="Clearlogo_Crop_Path">
		<!-- No serve under a modal dialog (the helper would size its controls there) or while the user scrolls (5001-5004, or this frame's move);
		     the URL coming back afterwards always refires, so a crop that landed unsized under a dialog is sized when it closes -->
		<value condition="System.HasVisibleModalDialog | Control.IsVisible(5001) | Control.IsVisible(5002) | Control.IsVisible(5003) | Control.IsVisible(5004) | Container.OnNext | Container.OnPrevious | Container(3100).OnNext | Container(3100).OnPrevious" />
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Billboard)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=640,240&amp;clearlogo_fit_ids=63501&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100</value>
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Showcase)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=660,240&amp;clearlogo_fit_ids=63502&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100$VAR[Clearlogo_Palette_Secondary]</value>
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Strip)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=600,240&amp;clearlogo_fit_ids=63504&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100$VAR[Clearlogo_Palette_Secondary]</value>
		<!-- The view's serve sizes the logo only if focus held through it, so pass (Clearlogo_Crop_Pass) reruns it as focus comes back to the view.
		     3100's serves abort on a focus move instead; a reopened window refires anyway (its view empties on close, Home lands on its menu) -->
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Billboard)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=640,240&amp;clearlogo_fit_ids=63501&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;pass=$INFO[Window(home).Property(Clearlogo_Crop_Pass)]&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Showcase)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=660,240&amp;clearlogo_fit_ids=63502&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;pass=$INFO[Window(home).Property(Clearlogo_Crop_Pass)]&amp;prop_key=9300$VAR[Clearlogo_Palette_Primary]</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Strip)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=600,240&amp;clearlogo_fit_ids=63504&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;pass=$INFO[Window(home).Property(Clearlogo_Crop_Pass)]&amp;prop_key=9300$VAR[Clearlogo_Palette_Primary]</value>
		<value condition="$EXP[Widget_HasLogo_3201] + $EXP[Widget_Clearlogos_Enabled_3201] + [Skin.String(Widget1_View,Billboard) | Skin.String(Widget1_View,Showcase) | Skin.String(Widget1_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3201).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633201&amp;clearlogo_fit_key=$INFO[Container(3201).ListItem.DBType]:$INFO[Container(3201).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3201).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3201).CurrentItem]&amp;focus_ids=3201&amp;prop_key=9300&amp;target=3201</value>
		<value condition="$EXP[Widget_HasLogo_3202] + $EXP[Widget_Clearlogos_Enabled_3202] + [Skin.String(Widget2_View,Billboard) | Skin.String(Widget2_View,Showcase) | Skin.String(Widget2_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3202).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633202&amp;clearlogo_fit_key=$INFO[Container(3202).ListItem.DBType]:$INFO[Container(3202).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3202).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3202).CurrentItem]&amp;focus_ids=3202&amp;prop_key=9300&amp;target=3202</value>
		<value condition="$EXP[Widget_HasLogo_3203] + $EXP[Widget_Clearlogos_Enabled_3203] + [Skin.String(Widget3_View,Billboard) | Skin.String(Widget3_View,Showcase) | Skin.String(Widget3_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3203).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633203&amp;clearlogo_fit_key=$INFO[Container(3203).ListItem.DBType]:$INFO[Container(3203).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3203).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3203).CurrentItem]&amp;focus_ids=3203&amp;prop_key=9300&amp;target=3203</value>
		<value condition="$EXP[Widget_HasLogo_3204] + $EXP[Widget_Clearlogos_Enabled_3204] + [Skin.String(Widget4_View,Billboard) | Skin.String(Widget4_View,Showcase) | Skin.String(Widget4_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3204).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633204&amp;clearlogo_fit_key=$INFO[Container(3204).ListItem.DBType]:$INFO[Container(3204).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3204).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3204).CurrentItem]&amp;focus_ids=3204&amp;prop_key=9300&amp;target=3204</value>
		<value condition="$EXP[Widget_HasLogo_3205] + $EXP[Widget_Clearlogos_Enabled_3205] + [Skin.String(Widget5_View,Billboard) | Skin.String(Widget5_View,Showcase) | Skin.String(Widget5_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3205).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633205&amp;clearlogo_fit_key=$INFO[Container(3205).ListItem.DBType]:$INFO[Container(3205).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3205).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3205).CurrentItem]&amp;focus_ids=3205&amp;prop_key=9300&amp;target=3205</value>
		<value condition="$EXP[Widget_HasLogo_3206] + $EXP[Widget_Clearlogos_Enabled_3206] + [Skin.String(Widget6_View,Billboard) | Skin.String(Widget6_View,Showcase) | Skin.String(Widget6_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3206).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633206&amp;clearlogo_fit_key=$INFO[Container(3206).ListItem.DBType]:$INFO[Container(3206).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3206).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3206).CurrentItem]&amp;focus_ids=3206&amp;prop_key=9300&amp;target=3206</value>
		<value condition="$EXP[Widget_HasLogo_3207] + $EXP[Widget_Clearlogos_Enabled_3207] + [Skin.String(Widget7_View,Billboard) | Skin.String(Widget7_View,Showcase) | Skin.String(Widget7_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3207).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633207&amp;clearlogo_fit_key=$INFO[Container(3207).ListItem.DBType]:$INFO[Container(3207).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3207).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3207).CurrentItem]&amp;focus_ids=3207&amp;prop_key=9300&amp;target=3207</value>
		<value condition="$EXP[Widget_HasLogo_3208] + $EXP[Widget_Clearlogos_Enabled_3208] + [Skin.String(Widget8_View,Billboard) | Skin.String(Widget8_View,Showcase) | Skin.String(Widget8_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3208).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633208&amp;clearlogo_fit_key=$INFO[Container(3208).ListItem.DBType]:$INFO[Container(3208).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3208).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3208).CurrentItem]&amp;focus_ids=3208&amp;prop_key=9300&amp;target=3208</value>
		<value condition="$EXP[Widget_HasLogo_3209] + $EXP[Widget_Clearlogos_Enabled_3209] + [Skin.String(Widget9_View,Billboard) | Skin.String(Widget9_View,Showcase) | Skin.String(Widget9_View,Strip)] + $EXP[Clearlogo_Crop_Primary]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3209).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=$VAR[Clearlogo_Fit_Home]&amp;clearlogo_fit_ids=633209&amp;clearlogo_fit_key=$INFO[Container(3209).ListItem.DBType]:$INFO[Container(3209).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3209).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3209).CurrentItem]&amp;focus_ids=3209&amp;prop_key=9300&amp;target=3209</value>
	</variable>
	<!-- The focused widget's logo box. Its row is read only once Home_Widget names that widget (Widget_Clearlogos_Enabled_32XX) -->
	<variable name="Clearlogo_Fit_Home">
		<value condition="$EXP[BillboardView_Display_IsFanart_Widget_Home]">640,240</value>
		<value condition="$EXP[ShowcaseView_Widget_Home_IsVisible]">660,240</value>
		<value>600,240</value>
	</variable>
	<!-- Night's colourised flags (Showcase, Strip): the logo's palette colour, which the helper returns only with a background to measure (its fanart).
	     Last in the serve's URL: a "|" in the fanart (Kodi's header options) ends the plugin's params there -->
	<variable name="Clearlogo_Palette_Primary">
		<value condition="Skin.HasSetting(Colorise_Flags) + !Skin.String(Theme,Light)">&amp;background_palette=true&amp;background_url=$INFO[Container.ListItem.Art(fanart)]</value>
	</variable>
	<variable name="Clearlogo_Palette_Secondary">
		<value condition="Skin.HasSetting(Colorise_Flags) + !Skin.String(Theme,Light)">&amp;background_palette=true&amp;background_url=$INFO[Container(3100).ListItem.Art(fanart)]</value>
	</variable>

</includes>