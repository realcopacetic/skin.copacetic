<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<variable name="AutoComplete_Path">
		<value condition="System.AddonIsEnabled(plugin.program.autocompletion) + !System.HasHiddenInput">plugin://plugin.program.autocompletion?info=autocomplete&amp;&amp;id=$INFO[Control.GetLabel(312).index(1)]&amp;&amp;limit=9</value>
	</variable>

	<include name="Background_Home_Content">
		<content sortby="random" limit="40" browse="never">$VAR[Background_Home_Path]</content>
	</include>

	<include name="Background_Login_Content">
		<content sortby="random" limit="40" browse="never">$VAR[Background_Login_Path]</content>
	</include>

	<include name="Background_Global_Content">
		<content sortby="random" browse="never">$VAR[Background_Global_Path]</content>
	</include>

	<include name="Background_Media_Content">
		<content sortby="random" browse="never">$VAR[Background_Media_Path]</content>
	</include>

	<variable name="Background_Home_Path">
		<!-- Global override - script.copacetic.helper -->
		<value condition="Skin.HasSetting(Background_Slideshow2) + String.Contains(Window(home).Property(CurrentSlideshow),2) + Skin.String(Background_Slideshow2,Custom) + Skin.String(Background_Slideshow2_Custom_Path)">$INFO[Skin.String(Background_Slideshow2_Custom_Path)]</value>
		<value condition="Skin.HasSetting(Home_Background_Override_Enabled) + Skin.String(Background_Slideshow_Custom_Path)">$INFO[Skin.String(Background_Slideshow_Custom_Path)]</value>
		<!-- Item override -->
		<value condition="!String.IsEmpty(Container(3000).ListItem.Property(backgroundPlaylist))">$INFO[Container(3000).ListItem.Property(backgroundPlaylist)]</value>
		<!-- playlists, xml library paths e.g. inprogress or sets, video and music db:// -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),.xsp)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),.xml)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),db://)">$INFO[Container(3000).ListItem.Property(list)]</value>
		<!-- music paths -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedalbums)">musicdb://recentlyaddedalbums/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyplayedalbums)">musicdb://recentlyplayedalbums/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),musicplaylists)">musicdb://artists/?albumartistsonly=true</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),musicdb)">musicdb://artists/?albumartistsonly=true</value>
		<!-- video paths -->
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedepisodes)">videodb://recentlyaddedepisodes/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),inprogresstvshows)">videodb://inprogresstvshows</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),tvshows)">videodb://tvshows/titles/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),recentlyaddedmovies)">videodb://recentlyaddedmovies/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),sets)">videodb://movies/sets/</value>
		<value condition="String.Contains(Container(3000).ListItem.Property(list),movies)">videodb://movies/titles/</value>
		<!-- fallbacks -->
		<value condition="Library.HasContent(Movies)">videodb://movies/titles/</value>
		<value condition="Library.HasContent(TVShows)">videodb://tvshows/titles/</value>
		<value condition="Library.HasContent(Music)">musicdb://artists/?albumartistsonly=true</value>
	</variable>

	<variable name="Background_Login_Path">
		<value condition="Library.HasContent(Movies)">videodb://movies/titles/</value>
		<value condition="Library.HasContent(TVShows)">videodb://tvshows/titles/</value>
		<value condition="Library.HasContent(Music)">musicdb://artists/?albumartistsonly=true</value>
	</variable>

	<variable name="Background_Global_Path">
		<value condition="Skin.HasSetting(Background_Slideshow2) + String.Contains(Window(home).Property(CurrentSlideshow),2) + Skin.String(Background_Slideshow2,Custom) + Skin.String(Background_Slideshow2_Custom_Path)">$INFO[Skin.String(Background_Slideshow2_Custom_Path)]</value>
		<value condition="Skin.String(Background_Slideshow,Custom) + Skin.String(Background_Slideshow_Custom_Path)">$INFO[Skin.String(Background_Slideshow_Custom_Path)]</value>
	</variable>

	<variable name="Background_Media_Path">
		<value condition="!String.Contains(Container.FolderPath,plugin://)">$INFO[ListItem.FolderPath]</value>
	</variable>

	<variable name="Secondary_List_Path">
		<value condition="Container.Content(movies) + ListItem.HasVideoVersions	">$INFO[ListItem.DBID,videodb://movies/videoversions/0?mediaid=,]</value>
		<value>$INFO[ListItem.FolderPath]</value>
	</variable>

	<variable name="Secondary_List_Sort">
		<value condition="Container.Content(tvshows)">season</value>
		<value>year</value>
	</variable>

	<variable name="Secondary_List_Sort_Order">
		<value condition="Window.Is(music)">descending</value>
		<value>ascending</value>
	</variable>

	<variable name="Secondary_List_Target">
		<value condition="Window.Is(music)">music</value>
		<value>videos</value>
	</variable>

	<!-- Keyed on the item, not its position (bare Container.CurrentItem is empty on Home); 9501 is no control, so nothing moves.
	     No modal dialog: the helper would read the dialog's container instead. -->
	<variable name="Set_Progress_Path">
		<value condition="Container.ListItem.IsCollection + String.IsEqual(Container.ListItem.Overlay,OverlayUnwatched.png) + !System.HasVisibleModalDialog">plugin://script.copacetic.helper/?info=progressbar&amp;focus_guard=$INFO[Container.ListItem.DBType],$INFO[Container.ListItem.DBID]&amp;identity_labels=Container.ListItem.DBType,Container.ListItem.DBID&amp;target_id=9501</value>
	</variable>

	<!-- The focused item's plain clearlogo cropped, and the details' logo (63 + view or widget id) set to its height in its logo_width x 240 box.
	     Any other item leaves the URL empty, which keeps the last crop, so readers also test Clearlogo_Crop_*. Home is keyed on the item. -->
	<variable name="Clearlogo_Crop_Path">
		<!-- No serve under a modal dialog (the helper would size its controls there) or while the user scrolls (5001-5004, or this frame's move);
		     the URL coming back afterwards always refires, so a crop that landed unsized under a dialog is sized when it closes -->
		<value condition="System.HasVisibleModalDialog | Control.IsVisible(5001) | Control.IsVisible(5002) | Control.IsVisible(5003) | Control.IsVisible(5004) | Container.OnNext | Container.OnPrevious | Container(3100).OnNext | Container(3100).OnPrevious" />
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Billboard)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=640,240&amp;clearlogo_fit_ids=63501&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100</value>
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Showcase)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=660,240&amp;clearlogo_fit_ids=63502&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100</value>
		<value condition="$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Strip)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container(3100).ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=600,240&amp;clearlogo_fit_ids=63504&amp;clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&amp;clearlogo_url=$INFO[Container(3100).ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container(3100).CurrentItem]&amp;focus_ids=3100&amp;prop_key=9300&amp;target=3100</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Billboard)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=640,240&amp;clearlogo_fit_ids=63501&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Showcase)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=660,240&amp;clearlogo_fit_ids=63502&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Strip)">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=600,240&amp;clearlogo_fit_ids=63504&amp;clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.CurrentItem]&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + $EXP[Clearlogo_Crop_Widget] + $EXP[BillboardView_Display_IsFanart_Widget_Home]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=640,240&amp;clearlogo_fit_ids=63$INFO[Window(home).Property(Home_Widget)]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.ListItem.DBType],$INFO[Container.ListItem.DBID]&amp;identity_labels=Container.ListItem.DBType,Container.ListItem.DBID&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + $EXP[Clearlogo_Crop_Widget] + $EXP[ShowcaseView_Widget_Home_IsVisible]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=660,240&amp;clearlogo_fit_ids=63$INFO[Window(home).Property(Home_Widget)]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.ListItem.DBType],$INFO[Container.ListItem.DBID]&amp;identity_labels=Container.ListItem.DBType,Container.ListItem.DBID&amp;prop_key=9300</value>
		<value condition="$EXP[Clearlogo_Crop_Primary] + $EXP[Clearlogo_Crop_Widget] + $EXP[StripView_Widget_Home_IsVisible]">plugin://script.copacetic.helper/?info=artwork&amp;clean_label=Container.ListItem.Art(clearlogo)&amp;clearlogo_crop=true&amp;clearlogo_fit=600,240&amp;clearlogo_fit_ids=63$INFO[Window(home).Property(Home_Widget)]&amp;clearlogo_url=$INFO[Container.ListItem.Art(clearlogo)]&amp;focus_guard=$INFO[Container.ListItem.DBType],$INFO[Container.ListItem.DBID]&amp;identity_labels=Container.ListItem.DBType,Container.ListItem.DBID&amp;prop_key=9300</value>
	</variable>

</includes>