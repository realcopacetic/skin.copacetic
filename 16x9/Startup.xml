<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- Look and feel -->
	<onload condition="!Skin.String(Theme)">Skin.SetString(Theme,Dark)</onload>
	<onload condition="!Skin.String(Background_Brightness)">Skin.SetString(Background_Brightness,33)</onload>
	<onload condition="!Skin.String(slideshow_interval)">Skin.SetString(slideshow_interval,10)</onload>
	<onload condition="!Skin.String(Background_Opacity)">Skin.SetString(Background_Opacity,75)</onload>
	<onload condition="!Skin.String(slideshow_source) + $EXP[Library_Has_Content]">Skin.SetString(slideshow_source,global)</onload>
	<onload condition="!Skin.String(Infoscreen_Brightness)">Skin.SetString(Infoscreen_Brightness,50)</onload>
	<onload condition="!$EXP[Library_Has_Content]">Skin.SetString(slideshow_source,custom)</onload>
	<onload condition="!Skin.String(OSD_Background_Brightness)">Skin.SetString(OSD_Background_Brightness,25)</onload>
	<onload condition="!Skin.String(Time_Widget)">Skin.SetString(Time_Widget,Clock)</onload>
	<onload condition="!Skin.String(script-upnext_Artwork)">Skin.SetString(script-upnext_Artwork,Fanart)</onload>
	<onload condition="!Skin.String(visualisation_Layout)">Skin.SetString(visualisation_Layout,Small)</onload>
	<onload condition="![Skin.HasSetting(Preferred_Rating_BBFC) | Skin.HasSetting(Preferred_Rating_MPAA) | Skin.HasSetting(Preferred_Rating_CHVRS) | Skin.HasSetting(Preferred_Rating_ACB) | Skin.HasSetting(Preferred_Rating_IFCO) | Skin.HasSetting(Preferred_Rating_FSK) | Skin.HasSetting(Preferred_Rating_DJCTQ) | Skin.HasSetting(Preferred_Rating_KIJKWIJZER) | Skin.HasSetting(Preferred_Rating_EIRIN)]">Skin.SetBool(Preferred_Rating_BBFC)</onload>

	<!-- Renamed settings. After the defaults above, so a copy wins: every condition is tested before the first action runs -->
	<include content="Startup_Migrate_Settings" />

	<!-- Layout configuration -->
	<!-- Grid -->
	<onload condition="!Skin.String(GridView_Size)">Skin.SetString(GridView_Size,Large)</onload>
	<!-- Startup -->
	<onload>SetProperty(SkinInitStarted,1,Home)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
</window>