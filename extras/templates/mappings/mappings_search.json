{
  "search": {
    "mode": "dynamic",
    "items": [
      "movies",
      "tvshows",
      "episodes",
      "musicvideos",
      "artists",
      "albums",
      "songs"
    ],
    "placeholders": {
      "key": "search_type"
    },
    "default_order": [ "movies", "tvshows", "episodes", "artists", "albums", "songs" ],
    "tokens": {
      "hasfocus": "[Window.Is(1180) + Control.HasFocus({index})]",
      "rail_id": "{index}",
      "shown": "[Window.Is(1180) + [Control.HasFocus({index}) | $EXP[search_preview_{index}]]]",
      "window": "search"
    },
    "config_fields": {
      "global": {
        "limit": "limit"
      },
      "movies": {
        "query_plot": "query_plot",
        "query_tag": "query_tag"
      },
      "tvshows": {
        "query_plot": "query_plot",
        "query_tag": "query_tag"
      },
      "episodes": {
        "query_plot": "query_plot"
      },
      "musicvideos": {
        "query_plot": "query_plot",
        "query_tag": "query_tag"
      },
      "artists": {
        "query_biography": "query_biography"
      },
      "albums": {
        "query_review": "query_review"
      }
    },
    "metadata": {
      "movies": {
        "label": "$LOCALIZE[342]",
        "target": "videos",
        "content": "videodb://movies/titles/",
        "sortby": "votes",
        "sortorder": "descending",
        "layout": "Strip",
        "art": "Posters",
        "use_custom_click": "true",
        "click_action": "Play_File",
        "xsp": {
          "rules": {
            "or": [
              { "field": "title", "operator": "contains", "value": [ "$ESCINFO[Window(home).Property(search_query)]" ] },
              { "field": "originaltitle", "operator": "contains", "value": [ "$ESCINFO[Window(home).Property(search_query)]" ] },
              { "field": "set", "operator": "contains", "value": [ "$ESCINFO[Window(home).Property(search_query)]" ] },
