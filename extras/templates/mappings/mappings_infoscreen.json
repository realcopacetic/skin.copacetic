{
  "infoscreen": {
    "note": "Info dialog rails, hand-written, in each dialog's Up/Down order. Each names its dialog, its own id (50 is Kodi's own list: cast or a set's movies in video info, screenshots in add-on info; templates name a rail by {id}, {container} or {listitem}, and {index} only names generated families) and the item types it's built for (load, C2's field: today's include conditions, on its container, layout and nib, so a rail of another type isn't built and fires no job; a kept dialog reopened on an item that changes any rail's load reloads, GUIWindow.cpp:739-742, and one that changes none needs the same rails). Cast and a set's movies are Kodi's list 50 under exclusive loads. last marks the item types for which a rail is its dialog's last built one: Up into the rails starts there. label_set picks the rail's rows of the info labels (the rows the old shared ids carried). Keyart and landscape are fixed off (Ash, Z A).",
    "mode": "static",
    "items": [ "next_up", "episodes", "movie_set", "seasons", "cast", "set_movies", "actor_credits", "director_credits", "studio_credits", "similar", "most_played", "discography", "musicvideos", "similar_artists", "similar_albums", "similar_songs", "screenshots" ],
    "placeholders": { "key": "rail" },
    "tokens": {
      "art_keyart": "false",
      "art_landscape": "false",
      "container": "Container({id})",
      "custom": "true",
      "episode_thumbs": "true",
      "listitem": "Container({id}).ListItem",
      "nib": "Control.IsVisible({id})",
      "rail_id": "{id}",
      "region": "infoscreen",
      "row_focus": "{window_is} + String.IsEqual(Window(home).Property(Infoscreen_Widget),{id})",
      "scope": "Infoscreen",
      "slot_filter": "true",
      "texture_prefix": "infoscreen_{index}",
      "window": "infoscreen"
    },
    "metadata": {
