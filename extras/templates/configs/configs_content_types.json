{
  "mapping": "content_types",
  "configs": {
    "{content_type}_layout": {
      "items": {
        "list": "$LOCALIZE[31000]",
        "billboard": "$LOCALIZE[31001]",
        "showcase": "$LOCALIZE[31002]",
        "strip": "$LOCALIZE[31003]",
        "grid": "$LOCALIZE[31004]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [videos, albums, songs, addons, program_folders, images])",
          "value": [ "billboard" ]
        },
        {
          "condition": "In({content_type}, [episodes, videos, musicvideos, songs])",
          "value": [ "showcase" ]
        },
        {
          "condition": "In({content_type}, [songs])",
          "value": [ "strip", "grid" ]
        }
      ],
      "defaults": {
        "*": "list"
      }
    },
    "{layout}_display": {
      "items": {
        "background": "$LOCALIZE[31432]",
        "thumbnails": "$LOCALIZE[31027]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "not In({content_type}, [movies, sets, tvshows, seasons, episodes, artists, albums, songs, musicvideos, program_files])",
          "value": [ "background" ]
        }
      ],
      "defaults": {
        "albums": "thumbnails",
        "songs": "thumbnails",
        "program_files": "thumbnails",
        "*": "background"
      }
    },
    "{layout}_details": {
      "items": {
        "title": "$LOCALIZE[31017]",
        "info": "$LOCALIZE[31018]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [videos, favourites])",
          "value": [ "info" ]
        },
        {
          "condition": "In({content_type}, [addons, images, program_addons, program_folders])",
          "value": [ "title" ]
        }
      ],
      "defaults": {
        "*": "info"
      }
    },
    "billboard_details": {
      "items": {
        "title": "$LOCALIZE[31017]",
        "info": "$LOCALIZE[31018]",
        "plot": "$LOCALIZE[31019]",
        "bio": "$LOCALIZE[31020]",
        "all": "$LOCALIZE[593]",
        "none": ""
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [artists, musicvideos])",
          "value": [ "plot" ]
        },
        {
          "condition": "not In({content_type}, [artists, musicvideos])",
          "value": [ "bio" ]
        },
        {
          "condition": "In({content_type}, [favourites])",
          "value": [ "info", "plot", "bio", "all" ]
        },
        {
          "condition": "In({content_type}, [program_addons])",
          "value": [ "title", "info", "plot", "bio", "all" ]
        },
        {
          "condition": "not In({content_type}, [program_addons])",
          "value": [ "none" ]
        }
      ],
      "defaults": {
        "seasons": "info",
        "artists": "title",
        "musicvideos": "title",
        "*": "all"
      }
    },
    "grid_display": {
      "items": {
        "posters": "$LOCALIZE[31006]",
        "fanart": "$LOCALIZE[31007]",
        "square": "$LOCALIZE[31008]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [movies, sets, tvshows, seasons])",
          "value": [ "square" ]
        },
        {
          "condition": "In({content_type}, [artists])",
          "value": [ "posters" ]
        },
        {
          "condition": "In({content_type}, [program_folders])",
          "value": [ "fanart" ]
        },
        {
          "condition": "In({content_type}, [episodes, videos, musicvideos])",
          "value": [ "posters", "square" ]
        },
        {
          "condition": "In({content_type}, [albums, songs, addons, program_addons, images])",
          "value": [ "posters", "fanart" ]
        }
      ],
      "defaults": {
        "program_folders": "posters",
        "favourites": "square",
        "*": "fanart"
      }
    },
    "grid_details": {
      "items": {
        "off": "$LOCALIZE[591]",
        "breadcrumb": "$LOCALIZE[31030]",
        "title": "$LOCALIZE[31017]",
        "info": "$LOCALIZE[31018]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [videos])",
          "value": [ "off", "title", "info" ]
        },
        {
          "condition": "In({content_type}, [favourites])",
          "value": [ "info" ]
        }
      ],
      "defaults": {
        "albums": "off",
        "addons": "off",
        "program_addons": "off",
        "images": "off",
        "favourites": "title",
        "*": "info"
      }
    },
    "{content_type}_flags": {
      "items": {
        "off": "$LOCALIZE[591]",
        "studio": "$LOCALIZE[31025]",
        "rating": "$LOCALIZE[31026]",
        "all": "$LOCALIZE[593]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "not In({content_type}, [movies, sets, tvshows, seasons, episodes, program_files])",
          "value": [ "studio", "rating", "all" ]
        }
      ],
      "defaults": {
        "*": "all"
      }
    },
    "{content_type}_logo": {
      "items": {
        "off": "$LOCALIZE[591]",
        "on": "$LOCALIZE[34222]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "not In({content_type}, [movies, sets, tvshows, artists, program_files])",
          "value": [ "on" ]
        }
      ],
      "defaults": {
        "*": "off"
      }
    },
    "{content_type}_art_keyart": {
      "items": {
        "true": "$LOCALIZE[186]",
        "false": "$LOCALIZE[106]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "not In({content_type}, [movies, sets, tvshows, seasons])",
          "value": [ "true" ]
        }
      ],
      "defaults": {
        "*": "false"
      }
    },
    "{content_type}_art_landscape": {
      "items": {
        "true": "$LOCALIZE[186]",
        "false": "$LOCALIZE[106]"
      },
      "filter_mode": "exclude",
      "rules": [
        {
          "condition": "In({content_type}, [episodes, videos, musicvideos])",
          "value": [ "true" ]
        }
      ],
      "defaults": {
        "*": "false"
      }
    }
  }
}
