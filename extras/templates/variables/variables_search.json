{
  "mapping": "search",
  "variables": {
    "search_path_{index}": {
      "note": "An empty field asks for nothing (empty.xsp), so no rail loads the library until there is a query.",
      "index": { "start": 3201 },
      "filter": "In({search_type}, [movies, tvshows, episodes, musicvideos, artists, albums, songs])",
      "values": [
        {
          "condition": "String.IsEmpty(Window(home).Property(search_query))",
          "value": "special://skin/extras/playlists/empty.xsp"
        },
        {
          "value": "{content}{xsp}"
        }
      ]
    },
    "search_info_{index}": {
      "note": "The rail's name beside the query; episodes add the focused episode's show.",
      "index": { "start": 3201 },
      "filter": "In({search_type}, [movies, tvshows, episodes, musicvideos, artists, albums, songs])",
      "values": [
        {
          "filter": "equals({search_type}, episodes)",
          "value": "{label}$VAR[Copacetic_Divider_Bold, ]$INFO[Container({index}).ListItem.TVShowTitle, ]"
        },
        {
          "value": "{label}"
        }
      ]
    },
    "search_{index}_Thumbnail({range})Content": {
      "note": "Each rail's Strip art names its rail: the preview draws it while the input has focus, and a bare ListItem reads the focused control.",
      "index": { "start": 3201 },
      "filter": "In({search_type}, [movies, tvshows, episodes, musicvideos, artists, albums, songs])",
      "range": { "start": -3, "end": 3 },
      "values": [
        {
          "filter": "equals({art}, Posters)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(keyart)) + Skin.HasSetting(Infoscreens_Prefer_Keyart)",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(keyart)]"
        },
        {
          "filter": "equals({art}, Posters)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(poster))",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(poster)]"
        },
        {
          "filter": "equals({art}, Posters)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(tvshow.keyart)) + Skin.HasSetting(Infoscreens_Prefer_Keyart)",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(tvshow.keyart)]"
        },
        {
          "filter": "equals({art}, Posters)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(tvshow.poster))",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(tvshow.poster)]"
        },
        {
          "filter": "equals({art}, Fanart) + not equals({search_type}, episodes)",
          "condition": "Skin.HasSetting(Infoscreens_Prefer_Landscape) + !String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(landscape))",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(landscape)]"
        },
        {
          "filter": "equals({art}, Fanart) + not equals({search_type}, episodes)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(fanart))",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(fanart)]"
        },
        {
          "filter": "equals({art}, Fanart) + not equals({search_type}, episodes)",
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Art(thumb))",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Art(thumb)]"
        },
        {
          "condition": "!String.IsEmpty(Container({index}).ListItemNoWrap({range}).Icon)",
          "value": "$INFO[Container({index}).ListItemNoWrap({range}).Icon]"
        }
      ]
    },
    "_search_scroll_nib_cluster": {
      "note": "Light nibs on a Strip's art with a focused or previewed rail, otherwise as the theme.",
      "index": { "start": 3201 },
      "filter": "In({search_type}, [movies, tvshows, episodes, musicvideos, artists, albums, songs])",
      "outputs": {
        "background": "search_Scroll_Widget_Background_Color",
        "focused": "search_Scroll_Widget_Focused_Color"
      },
      "rows": [
        {
          "filter": "In({art}, [Posters, Square])",
          "condition": "[Control.HasFocus({index}) | $EXP[search_preview_{index}]] + Skin.String(Theme,Light) + !String.IsEmpty(Container({index}).ListItemNoWrap(2).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({art}, Fanart)",
          "condition": "[Control.HasFocus({index}) | $EXP[search_preview_{index}]] + Skin.String(Theme,Light) + !String.IsEmpty(Container({index}).ListItemNoWrap(1).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "condition": "Skin.String(Theme,Light)",
          "background": "dark15",
          "focused": "dark_grey"
        },
        {
          "background": "light15",
          "focused": "light"
        }
      ]
    }
  }
}
