{
  "mapping": "widgets",
  "variables": {
    "label_multiart": {
      "note": "Label 6400 (MyViews_Multiart_Labels): the family the focused item's multiart cycles, the focused Home row's or else the view's. A custom Fanart or Spotlight row showing episode thumbs (episode_thumbs) shows an episode's or video's own thumb when it has one, so that one cycles its thumbs (thumb1 on) or nothing.",
      "index": {
        "start": 3201
      },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "values": [
        [
          {
            "filter": "equals({episode_thumbs}, true) + In({art}, [Fanart, Spotlight])",
            "condition": "Control.HasFocus({index}) + [String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,video)] + !String.IsEmpty({listitem}.Art(thumb)) + String.IsEmpty({listitem}.Art(thumb1))",
            "value": ""
          },
          {
            "filter": "equals({episode_thumbs}, true) + In({art}, [Fanart, Spotlight])",
            "condition": "Control.HasFocus({index}) + String.IsEqual({listitem}.DBType,video) + !String.IsEmpty({listitem}.Art(thumb)) + !String.IsEmpty({listitem}.Art(thumb1))",
            "value": "thumb"
          },
          {
            "condition": "Control.HasFocus({index})",
            "value": "$VAR[label_multiart_{texture_prefix}]"
          }
        ],
        {
          "value": "$VAR[label_multiart_primary]"
        }
      ]
    },
    "label_multiart_{texture_prefix}": {
      "note": "C2's rows (C2 variables_content.json), each family read through its context's art aggregates: art_*_visible for the views, art_*_visible_home for the focused row. C2's TMDb and favourite rows are left out: C1 has neither. The embedded list serves no multiart. C1's own row: a Home row's fanart tile draws an album's or song's cover, never its or its artist's fanart (texture_widgets_*_fanart*), so neither cycles any. And Showcase Posters' tile beside its logo is the keyart of an item with a clearlogo (art_keyart_logo_visible), so that item cycles keyart, or nothing.",
      "templates_from": [ "regions", "widgets" ],
      "index": {
        "start": 3201
      },
      "filter": "not equals({region}, secondary)",
      "values": [
        [
          {
            "condition": "!String.IsEmpty({listitem}.Art(thumb1)) + [String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,album) | String.IsEqual({listitem}.DBType,song) | [String.IsEqual({listitem}.DBType,artist) + $EXP[art_square_{art_context}]]]",
            "value": "thumb"
          },
          {
            "filter": "equals({region}, primary)",
            "condition": "!String.IsEmpty({listitem}.Art(keyart1)) + !String.IsEmpty({listitem}.Art(keyart)) + !String.IsEmpty({listitem}.Art(clearlogo)) + $EXP[art_keyart_logo_visible]",
            "value": "keyart"
          },
          {
            "filter": "equals({region}, primary)",
            "condition": "!String.IsEmpty({listitem}.Art(keyart)) + !String.IsEmpty({listitem}.Art(clearlogo)) + $EXP[art_keyart_logo_visible]",
            "value": ""
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(keyart1)) + $EXP[art_poster_{art_context}] + $EXP[art_keyart_{art_context}]",
            "value": "keyart"
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(poster1)) + $EXP[art_poster_{art_context}] + [!$EXP[art_keyart_{art_context}] | String.IsEmpty({listitem}.Art(keyart))]",
            "value": "poster"
          },
          {
            "condition": "[Window.Is(home) | ![String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,season)]] + !String.IsEmpty({listitem}.Art(tvshow.keyart1)) + $EXP[art_poster_{art_context}] + $EXP[art_keyart_{art_context}]",
            "value": "tvshow.keyart"
          },
          {
            "condition": "[Window.Is(home) | ![String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,season)]] + !String.IsEmpty({listitem}.Art(tvshow.poster1)) + $EXP[art_poster_{art_context}] + [!$EXP[art_keyart_{art_context}] | String.IsEmpty({listitem}.Art(tvshow.keyart))]",
            "value": "tvshow.poster"
          },
          {
            "filter": "equals({region}, widgets)",
            "condition": "[String.IsEqual({listitem}.DBType,album) | String.IsEqual({listitem}.DBType,song)] + $EXP[art_fanart_{art_context}]",
            "value": ""
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(landscape1)) + $EXP[art_fanart_{art_context}] + $EXP[art_landscape_{art_context}]",
            "value": "landscape"
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(fanart1)) + $EXP[art_fanart_{art_context}] + [!$EXP[art_landscape_{art_context}] | String.IsEmpty({listitem}.Art(landscape))]",
            "value": "fanart"
          },
          {
            "condition": "[Window.Is(home) | ![String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,season)]] + !String.IsEmpty({listitem}.Art(tvshow.landscape1)) + $EXP[art_fanart_{art_context}] + $EXP[art_landscape_{art_context}]",
            "value": "tvshow.landscape"
          },
          {
            "condition": "[Window.Is(home) | ![String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,season)]] + !String.IsEmpty({listitem}.Art(tvshow.fanart1)) + $EXP[art_fanart_{art_context}] + [!$EXP[art_landscape_{art_context}] | String.IsEmpty({listitem}.Art(tvshow.landscape))]",
            "value": "tvshow.fanart"
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(artist.landscape1)) + $EXP[art_fanart_{art_context}] + $EXP[art_landscape_{art_context}]",
            "value": "artist.landscape"
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(artist.fanart1)) + $EXP[art_fanart_{art_context}] + [!$EXP[art_landscape_{art_context}] | String.IsEmpty({listitem}.Art(landscape))]",
            "value": "artist.fanart"
          },
          {
            "condition": "!String.IsEmpty({listitem}.Art(square1)) + $EXP[art_square_{art_context}]",
            "value": "square"
          },
          {
            "condition": "[Window.Is(home) | ![String.IsEqual({listitem}.DBType,episode) | String.IsEqual({listitem}.DBType,season)]] + !String.IsEmpty({listitem}.Art(tvshow.square1)) + $EXP[art_square_{art_context}]",
            "value": "tvshow.square"
          }
        ]
      ]
    },
    "Artwork_Serve": {
      "note": "Probe 6930 (Clearlogo_Crop_List), read by the helper's service at 9300's turn of the ring: the focused item's clearlogo crop and multiart, params with no plugin prefix. Each image is read whole by its source (clearlogo_source, icon_source, background_source), so a row carries no URL. none on a scrollbar, whose paging moves the item with no arrival (the cursor is cleared there), so the net stays quiet. wait (C2's) while Kodi hasn't filled a video library item's art (libraryartfilled), so an arrival before the loader is served once it has, not with no art. The view's logo rows name the view (focus_ids): a serve that focus leaves stops unbound rather than landing unsized, as a return keeps the visit and repeats the cursor. The multiart rows' icon_source is only there so artwork() runs and binds the family of an item with no logo, which the service turns on 9400 (Params_Multiart's slides). none for anything else, last of all, so a mounted 9300 always answers.",
      "index": {
        "start": 3201
      },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "values": [
        {
          "condition": "$EXP[Scrollbar_HasFocus]",
          "value": "none"
        },
        {
          "condition": "Control.HasFocus(3100) + String.IsEmpty(Container(3100).ListItem.Property(libraryartfilled)) + Integer.IsGreater(Container(3100).ListItem.DBID,0) + [String.IsEqual(Container(3100).ListItem.DBType,movie) | String.IsEqual(Container(3100).ListItem.DBType,set) | String.IsEqual(Container(3100).ListItem.DBType,tvshow) | String.IsEqual(Container(3100).ListItem.DBType,season) | String.IsEqual(Container(3100).ListItem.DBType,episode) | String.IsEqual(Container(3100).ListItem.DBType,musicvideo)]",
          "value": "wait"
        },
        {
          "condition": "[Window.Is(videos) | Window.Is(music)] + !Control.HasFocus(3100) + String.IsEmpty(Container.ListItem.Property(libraryartfilled)) + Integer.IsGreater(Container.ListItem.DBID,0) + [String.IsEqual(Container.ListItem.DBType,movie) | String.IsEqual(Container.ListItem.DBType,set) | String.IsEqual(Container.ListItem.DBType,tvshow) | String.IsEqual(Container.ListItem.DBType,season) | String.IsEqual(Container.ListItem.DBType,episode) | String.IsEqual(Container.ListItem.DBType,musicvideo)]",
          "value": "wait"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Billboard)",
          "value": "info=artwork&clean_label=Container(3100).ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=640,240&clearlogo_fit_ids=63501&clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&cursor_key=primary&focus_guard=$INFO[Container(3100).CurrentItem]&focus_ids=3100&target=3100&clearlogo_source=Container(3100).ListItem.Art(clearlogo)"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Showcase)",
          "value": "info=artwork&clean_label=Container(3100).ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=660,240&clearlogo_fit_ids=63502&clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&cursor_key=primary&focus_guard=$INFO[Container(3100).CurrentItem]&focus_ids=3100&target=3100&clearlogo_source=Container(3100).ListItem.Art(clearlogo)$VAR[Clearlogo_Palette_Secondary]"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Secondary] + String.IsEqual(Container.ViewMode,Strip)",
          "value": "info=artwork&clean_label=Container(3100).ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=600,240&clearlogo_fit_ids=63504&clearlogo_fit_key=$INFO[Container(3100).ListItem.DBType]:$INFO[Container(3100).ListItem.DBID]&cursor_key=primary&focus_guard=$INFO[Container(3100).CurrentItem]&focus_ids=3100&target=3100&clearlogo_source=Container(3100).ListItem.Art(clearlogo)$VAR[Clearlogo_Palette_Secondary]"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Billboard)",
          "value": "info=artwork&clean_label=Container.ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=640,240&clearlogo_fit_ids=63501&clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&focus_guard=$INFO[Container.CurrentItem]&focus_ids=501$VAR[Params_Multiart]&clearlogo_source=Container.ListItem.Art(clearlogo)"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Showcase)",
          "value": "info=artwork&clean_label=Container.ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=660,240&clearlogo_fit_ids=63502&clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&focus_guard=$INFO[Container.CurrentItem]&focus_ids=502$VAR[Params_Multiart]&clearlogo_source=Container.ListItem.Art(clearlogo)$VAR[Clearlogo_Palette_Primary]"
        },
        {
          "condition": "$EXP[Clearlogo_Crop_Primary] + String.IsEqual(Container.ViewMode,Strip)",
          "value": "info=artwork&clean_label=Container.ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=600,240&clearlogo_fit_ids=63504&clearlogo_fit_key=$INFO[Container.ListItem.DBType]:$INFO[Container.ListItem.DBID]&focus_guard=$INFO[Container.CurrentItem]&focus_ids=504$VAR[Params_Multiart]&clearlogo_source=Container.ListItem.Art(clearlogo)$VAR[Clearlogo_Palette_Primary]"
        },
        [
          {
            "condition": "Control.HasFocus({index}) + {focused} + String.IsEmpty(Container({index}).ListItem.Property(libraryartfilled)) + Integer.IsGreater(Container({index}).ListItem.DBID,0) + [String.IsEqual(Container({index}).ListItem.DBType,movie) | String.IsEqual(Container({index}).ListItem.DBType,set) | String.IsEqual(Container({index}).ListItem.DBType,tvshow) | String.IsEqual(Container({index}).ListItem.DBType,season) | String.IsEqual(Container({index}).ListItem.DBType,episode) | String.IsEqual(Container({index}).ListItem.DBType,musicvideo)]",
            "value": "wait"
          },
          {
            "filter": "equals({art_clearlogo}, true) + In({layout}, [Billboard, Showcase, Strip])",
            "condition": "$EXP[Widget_HasLogo_{window}_{index}] + {focused} + $EXP[Clearlogo_Crop_Primary]",
            "value": "info=artwork&clean_label=Container({index}).ListItem.Art(clearlogo)&clearlogo_crop=true&clearlogo_fit=$VAR[Clearlogo_Fit_Home]&clearlogo_fit_ids=63{index}&clearlogo_fit_key=$INFO[Container({index}).ListItem.DBType]:$INFO[Container({index}).ListItem.DBID]&focus_guard=$INFO[Container({index}).CurrentItem]&focus_ids={index}&target={index}$VAR[Params_Multiart]&clearlogo_source=Container({index}).ListItem.Art(clearlogo)"
          },
          {
            "condition": "Control.HasFocus({index}) + {focused} + $EXP[multiart_serve]",
            "value": "info=artwork&focus_guard=$INFO[Container({index}).CurrentItem]&focus_ids={index}&target={index}$VAR[Params_Multiart]&icon_source=Container({index}).ListItem.Icon"
          }
        ],
        {
          "condition": "[Window.Is(videos) | Window.Is(music)] + !Control.HasFocus(3100) + $EXP[multiart_serve]",
          "value": "info=artwork&focus_guard=$INFO[Container.CurrentItem]$VAR[Params_Multiart]&icon_source=Container.ListItem.Icon"
        },
        {
          "value": "none"
        }
      ]
    },
    "_scroll_nib_cluster": {
      "note": "The nib colours follow the focused row's layout and art: dark nibs only over a light Showcase, light nibs on art.",
      "index": {
        "start": 3201
      },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "outputs": {
        "background": "Home_Scroll_Widget_Background_Color",
        "focused": "Home_Scroll_Widget_Focused_Color"
      },
      "rows": [
        {
          "condition": "Control.HasFocus(3000) | $EXP[Music_Player_HasFocus] | $EXP[Container_HasBackground] | Control.HasFocus(4201)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Showcase)",
          "condition": "Control.HasFocus({index}) + Skin.String(Theme,Light)",
          "background": "dark15",
          "focused": "dark_grey"
        },
        {
          "filter": "equals({layout}, Strip) + equals({art}, Posters)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(2).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Strip) + equals({art}, Square)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(1).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Strip) + equals({art}, Fanart)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(1).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Grid) + equals({art}, Posters)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(5).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Grid) + equals({art}, Square)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(5).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "filter": "equals({layout}, Grid) + equals({art}, Fanart)",
          "condition": "Control.HasFocus({index}) + !String.IsEmpty(Container({index}).ListItemNoWrap(3).Label)",
          "background": "light15",
          "focused": "light"
        },
        {
          "condition": "Skin.String(Theme,Light)",
          "background": "dark15"
        },
        {
          "background": "light15",
          "focused": "$VAR[Primary_Color]"
        }
      ]
    }
  }
}
