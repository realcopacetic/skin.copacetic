{
  "mapping": "none",
  "variables": {
    "texture_{texture_prefix}_fanart{range}": {
      "note": "Billboard (slot 0) shows a program add-on's fanart before its icon, as it always has, so the thumb row skips it there; List's Background shows an album's fanart, not its cover.",
      "templates_from": [ "regions" ],
      "range": { "start": -3, "end": 3 },
      "filter": "In({range}, {slot_range}) + not In({range}, [-3, 3])",
      "values": [
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(thumb)) + [String.IsEqual({listitem}({range}).DBType,episode) | [String.IsEqual({listitem}({range}).DBType,album) + !$EXP[ListView_Display_IsBackground_Albums]] | [Container.Content(addons) + !$EXP[layout_billboard_visible_programs]] | Container.Content(videos)]", "value": "$INFO[{listitem}({range}).Art(thumb)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(landscape)) + $EXP[art_landscape_{art_context}]", "value": "$INFO[{listitem}({range}).Art(landscape)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(fanart))", "value": "$INFO[{listitem}({range}).Art(fanart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.landscape)) + $EXP[art_landscape_{art_context}]", "value": "$INFO[{listitem}({range}).Art(tvshow.landscape)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.fanart))", "value": "$INFO[{listitem}({range}).Art(tvshow.fanart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.square))", "value": "$INFO[{listitem}({range}).Art(tvshow.square)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(keyart)) + $EXP[art_keyart_{art_context}]", "value": "$INFO[{listitem}({range}).Art(keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(poster))", "value": "$INFO[{listitem}({range}).Art(poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(boxfront))", "value": "$INFO[{listitem}({range}).Art(boxfront)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.keyart)) + $EXP[art_keyart_{art_context}]", "value": "$INFO[{listitem}({range}).Art(tvshow.keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.poster))", "value": "$INFO[{listitem}({range}).Art(tvshow.poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Icon)", "value": "$INFO[{listitem}({range}).Icon]" }
      ]
    },
    "texture_{texture_prefix}_poster{range}": {
      "note": "Keyart also under Showcase's details over the art (Title or Info over the art), where the poster's own title would clash.",
      "templates_from": [ "regions" ],
      "range": { "start": -3, "end": 3 },
      "filter": "In({range}, {slot_range})",
      "values": [
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(thumb)) + [String.IsEqual({listitem}({range}).DBType,episode) | String.IsEqual({listitem}({range}).DBType,album) | Container.Content(addons) | Container.Content(videos)]", "value": "$INFO[{listitem}({range}).Art(thumb)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(keyart)) + [$EXP[art_keyart_{art_context}] | $EXP[details_title_overlay_visible] | $EXP[details_info_overlay_visible]]", "value": "$INFO[{listitem}({range}).Art(keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(poster))", "value": "$INFO[{listitem}({range}).Art(poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(boxfront))", "value": "$INFO[{listitem}({range}).Art(boxfront)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.keyart)) + [$EXP[art_keyart_{art_context}] | $EXP[details_title_overlay_visible] | $EXP[details_info_overlay_visible]]", "value": "$INFO[{listitem}({range}).Art(tvshow.keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.poster))", "value": "$INFO[{listitem}({range}).Art(tvshow.poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Icon)", "value": "$INFO[{listitem}({range}).Icon]" }
      ]
    },
    "texture_{texture_prefix}_square{range}": {
      "templates_from": [ "regions" ],
      "range": { "start": -3, "end": 3 },
      "filter": "In({range}, {slot_range})",
      "values": [
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(square))", "value": "$INFO[{listitem}({range}).Art(square)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(snap))", "value": "$INFO[{listitem}({range}).Art(snap)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(icon)) + $EXP[Container_Programs_IsFolders]", "value": "$INFO[{listitem}({range}).Art(icon)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(thumb)) + [String.IsEqual({listitem}({range}).DBType,artist) | String.IsEqual({listitem}({range}).DBType,episode) | String.IsEqual({listitem}({range}).DBType,album) | String.IsEqual({listitem}({range}).DBType,song) | Container.Content(addons) | Container.Content(videos)]", "value": "$INFO[{listitem}({range}).Art(thumb)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Icon) + [[Container.Content(addons) + !Window.IsVisible(programs)] | Container.Content(images)]", "value": "$INFO[{listitem}({range}).Icon]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(landscape)) + $EXP[art_landscape_{art_context}]", "value": "$INFO[{listitem}({range}).Art(landscape)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(fanart))", "value": "$INFO[{listitem}({range}).Art(fanart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.landscape)) + $EXP[art_landscape_{art_context}]", "value": "$INFO[{listitem}({range}).Art(tvshow.landscape)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.fanart))", "value": "$INFO[{listitem}({range}).Art(tvshow.fanart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.square))", "value": "$INFO[{listitem}({range}).Art(tvshow.square)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(keyart)) + $EXP[art_keyart_{art_context}]", "value": "$INFO[{listitem}({range}).Art(keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(poster))", "value": "$INFO[{listitem}({range}).Art(poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(boxfront))", "value": "$INFO[{listitem}({range}).Art(boxfront)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.keyart)) + $EXP[art_keyart_{art_context}]", "value": "$INFO[{listitem}({range}).Art(tvshow.keyart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.poster))", "value": "$INFO[{listitem}({range}).Art(tvshow.poster)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Icon)", "value": "$INFO[{listitem}({range}).Icon]" }
      ]
    },
    "texture_{texture_prefix}_{item}{range}": {
      "note": "A Strip rail's slots (Home rows, search rails and the preview, info screen rails): its own art, in each scope's order of old: a Home row's chain, keyart and landscape on its fields; search and info rails fanart (not for an episode), then Icon, which hides an unwatched episode's thumb as Kodi's setting asks. A Home row never shows the slots left of its focus, so -3 and -2 stay empty.",
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "items": [ "poster", "fanart", "square" ],
      "range": { "start": -3, "end": 3 },
      "filter": "{slot_filter} + equals({layout}, Strip) + In({art}_{item}, [Posters_poster, Fanart_fanart, Square_square]) + not In({item}{range}, [fanart-3, fanart3])",
      "values": [
        { "filter": "equals({window}, home) + In({range}, [-3, -2])", "value": "" },
        { "filter": "equals({item}, poster) + equals({art_keyart}, true)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.keyart))", "value": "$INFO[{listitem}({range}).Art(tvshow.keyart)]" },
        { "filter": "equals({item}, poster) + equals({art_keyart}, true)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(keyart))", "value": "$INFO[{listitem}({range}).Art(keyart)]" },
        { "filter": "equals({item}, poster) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.poster))", "value": "$INFO[{listitem}({range}).Art(tvshow.poster)]" },
        { "filter": "equals({item}, poster)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(poster))", "value": "$INFO[{listitem}({range}).Art(poster)]" },
        { "filter": "equals({item}, poster) + not equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.poster))", "value": "$INFO[{listitem}({range}).Art(tvshow.poster)]" },
        { "filter": "equals({item}, fanart) + equals({episode_thumbs}, true)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(thumb)) + [String.IsEqual({listitem}NoWrap({range}).DBType,episode) | String.IsEqual({listitem}NoWrap({range}).DBType,video)]", "value": "$INFO[{listitem}({range}).Art(thumb)]" },
        { "filter": "equals({item}, square) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.square))", "value": "$INFO[{listitem}({range}).Art(tvshow.square)]" },
        { "filter": "equals({item}, square) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(square))", "value": "$INFO[{listitem}({range}).Art(square)]" },
        { "filter": "equals({item}, square) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(thumb))", "value": "$INFO[{listitem}({range}).Art(thumb)]" },
        { "filter": "not equals({item}, poster) + equals({art_landscape}, true)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.landscape))", "value": "$INFO[{listitem}({range}).Art(tvshow.landscape)]" },
        { "filter": "not equals({item}, poster) + equals({art_landscape}, true)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(landscape)) + !String.IsEqual({listitem}NoWrap({range}).DBType,album) + !String.IsEqual({listitem}NoWrap({range}).DBType,song)", "value": "$INFO[{listitem}({range}).Art(landscape)]" },
        { "filter": "not equals({item}, poster) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(tvshow.fanart))", "value": "$INFO[{listitem}({range}).Art(tvshow.fanart)]" },
        { "filter": "not equals({item}, poster) + equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(fanart)) + !String.IsEqual({listitem}NoWrap({range}).DBType,album) + !String.IsEqual({listitem}NoWrap({range}).DBType,song)", "value": "$INFO[{listitem}({range}).Art(fanart)]" },
        { "filter": "equals({item}, fanart) + not equals({window}, home)", "condition": "!String.IsEmpty({listitem}NoWrap({range}).Art(fanart)) + !String.IsEqual({listitem}NoWrap({range}).DBType,episode)", "value": "$INFO[{listitem}({range}).Art(fanart)]" },
        { "condition": "!String.IsEmpty({listitem}NoWrap({range}).Icon)", "value": "$INFO[{listitem}({range}).Icon]" }
      ]
    },
    "texture_{texture_prefix}_{item}_base0": {
      "note": "C2's base art, for the embedded list only: while a move's latch holds it keeps the item left, so tpl_art_transition fades the new one in over it.",
      "templates_from": [ "regions" ],
      "items": [ "poster", "fanart", "square" ],
      "filter": "equals({region}, secondary)",
      "values": [
        { "condition": "$EXP[base_lag_{texture_prefix}_prev]", "value": "$VAR[texture_{texture_prefix}_{item}1]" },
        { "condition": "$EXP[base_lag_{texture_prefix}_next]", "value": "$VAR[texture_{texture_prefix}_{item}-1]" },
        { "value": "$VAR[texture_{texture_prefix}_{item}0]" }
      ]
    }
  }
}
