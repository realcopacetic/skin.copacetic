{
  "mapping": "copacetic1",
  "controls": {
    "category_item": {
      "control_type": "listitem",
      "label": "{label}",
      "description": "{description}"
    },
    "mainmenu": {
      "id": 1201,
      "control_type": "button",
      "visible": "equals({settings_category}, menus)",
      "label": "$LOCALIZE[31417]",
      "onclick": {
        "type": "custom",
        "action": "RunScript(script.copacetic.helper,action=dynamic_settings_window,name=menusettings,mapping=mainmenu)"
      }
    },
    "shutdownmenu": {
      "id": 1202,
      "control_type": "button",
