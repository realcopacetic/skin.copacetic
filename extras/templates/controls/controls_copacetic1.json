{
  "mapping": "copacetic1",
  "controls": {
    "category_item": {
      "control_type": "listitem",
      "label": "{label}"
    },
    "slideshow_path": {
      "field": "slideshow_path",
      "id": 201,
      "control_type": "button",
      "visible": "equals({settings_category}, background)",
      "label": "$LOCALIZE[108] 1",
      "onclick": {
        "type": "browse_content",
        "heading": "$LOCALIZE[31439]",
        "mode": "widget"
      }
    },
    "slideshow2_path": {
      "field": "slideshow2_path",
      "id": 202,
      "control_type": "button",
      "visible": "equals({settings_category}, background) + xml(Skin.HasSetting(slideshow2))",
      "label": "$LOCALIZE[108] 2",
      "onclick": {
        "type": "browse_content",
        "heading": "$LOCALIZE[31439]",
        "mode": "widget"
      }
    },
    "playnext_lead": {
      "field": "playnext_lead",
      "id": 203,
      "control_type": "cycle",
      "visible": "equals({settings_category}, player)",
      "label": "Show the card before the end"
    },
    "still_watching": {
      "field": "still_watching",
      "id": 204,
      "control_type": "cycle",
      "visible": "equals({settings_category}, player)",
      "label": "Still there?"
    },
    "search_optimise": {
      "field": "search_optimise",
      "id": 205,
      "control_type": "cycle",
      "visible": "equals({settings_category}, search)",
      "label": "Optimise for"
    },
    "keyboard_layout": {
      "id": 206,
      "control_type": "button",
      "visible": "equals({settings_category}, search) + equals({search_optimise}, remote)",
      "label": "Onscreen keyboard layout",
      "onclick": {
        "type": "runtime_script",
        "action": "seed_keyboard_layout"
      }
    },
    "keyboardsettings": {
      "id": 207,
      "control_type": "button",
      "visible": "equals({settings_category}, search) + equals({search_optimise}, remote)",
      "label": "Onscreen keyboard",
      "onclick": {
        "type": "custom",
        "action": "RunScript(script.copacetic.helper,action=dynamic_settings_window,name=keyboardsettings,mapping=keyboard)"
      }
    }
  }
}
