      "label": "$LOCALIZE[21427]"
    },
    "search_query_plot": {
      "field": "query_plot",
      "id": 222,
      "control_type": "radiobutton",
      "visible": "In({search_type}, [movies, tvshows, episodes, musicvideos])",
      "label": "$LOCALIZE[31707]"
    },
    "search_query_tag": {
      "field": "query_tag",
      "id": 223,
      "control_type": "radiobutton",
      "visible": "In({search_type}, [movies, tvshows, musicvideos])",
      "label": "$LOCALIZE[31708]"
    },
    "search_query_biography": {
      "field": "query_biography",
      "id": 224,
