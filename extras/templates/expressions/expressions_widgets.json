{
  "mapping": "widgets",
  "expressions": {
    "BillboardView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Billboard)", "type": "append", "value": "{row_focus}" } ]
    },
    "ShowcaseView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Showcase) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "ShowcaseView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Showcase) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Fanart)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Fanart)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsSpotlight_Widget": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Spotlight)", "type": "append", "value": "{row_focus}" } ]
    },
    "widget_grid_spotlight_{index}": {
      "note": "Include conditions (Home_Row_Layout, Grid details): true when this row is Grid in Spotlight display.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Spotlight)", "type": "assign", "value": "true" } ]
    },
    "widget_landscape_{index}": {
      "note": "Include conditions (Grid's Spotlight overlay): this row prefers landscape art.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_landscape}, true)", "type": "assign", "value": "true" } ]
    },
    "trailer_include_{window}": {
      "note": "Include conditions on Home (the black cover, the fades): some row plays trailers.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({autoplay}, true)", "type": "assign", "value": "true" } ]
    },
    "art_clearlogo_visible_{window}": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_clearlogo}, true)", "type": "append", "value": "{focused}" } ]
    },
    "art_keyart_visible_{window}": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_keyart}, true)", "type": "append", "value": "{focused}" } ]
    },
    "art_landscape_visible_{window}": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_landscape}, true)", "type": "append", "value": "{focused}" } ]
    },
    "Widget_HasLogo_{window}": {
      "note": "Kodi's list 50 in the info dialogs never had a row here.",
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "filter": "not equals({rail_id}, 50)",
      "rules": [ { "type": "append", "value": "$EXP[Widget_HasLogo_{window}_{index}]" } ]
    },
    "Widget_HasLogo_{window}_{index}": {
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "filter": "not equals({rail_id}, 50)",
      "rules": [
        {
          "type": "assign",
          "value": "Control.HasFocus({rail_id}) + [String.IsEqual(Container({rail_id}).ListItem.DBType,movie) | String.IsEqual(Container({rail_id}).ListItem.DBType,set) | String.IsEqual(Container({rail_id}).ListItem.DBType,tvshow) | String.IsEqual(Container({rail_id}).ListItem.DBType,artist)] + !String.IsEmpty(Container({rail_id}).ListItem.Art(clearlogo))"
        }
      ]
    },
    "Clearlogo_Served_Home": {
      "index": { "start": 3201 },
      "rules": [
        { "type": "append", "value": "[Control.HasFocus({index}) + String.StartsWith(Container(9300).ListItem.Property(current),{index}/)]" }
      ]
    },
    "Multiart_Container_Switching": {
      "note": "The focused row was reached less than 2.5 s ago (its latch, widgets_latches).",
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "[{focused} + Control.IsVisible({index+2002})]" } ]
    },
    "widgets_container_switching": {
      "note": "The probe 5200 reads this, so Timers.xml can (Timers.xml takes no $EXP): SkinTimerManager.cpp:73 registers the raw text.",
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "[Control.HasFocus({index}) + Control.IsVisible({index+2002})]" } ]
    },
    "widgets_home_hasfocus": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Control.HasFocus({index})" } ]
    },
    "widgets_home_onprevious": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Container({index}).OnPrevious" } ]
    },
    "widgets_home_onnext": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Container({index}).OnNext" } ]
    }
  }
}
