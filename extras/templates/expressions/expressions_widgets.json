{
  "mapping": "widgets",
  "expressions": {
    "BillboardView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Billboard)", "type": "append", "value": "{row_focus}" } ]
    },
    "ShowcaseView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Showcase) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "ShowcaseView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Showcase) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Fanart)", "type": "append", "value": "{row_focus}" } ]
    },
    "StripView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Strip) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsPosters_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Posters)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsFanart_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Fanart)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsSquare_Widget_{scope}": {
      "templates_from": [ "widgets", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Square)", "type": "append", "value": "{row_focus}" } ]
    },
    "GridView_Display_IsSpotlight_Widget": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Spotlight)", "type": "append", "value": "{row_focus}" } ]
    },
    "widget_grid_spotlight_{index}": {
      "note": "Include conditions (Home_Row_Layout, Grid details): true when this row is Grid in Spotlight display.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({layout}, Grid) + equals({art}, Spotlight)", "type": "assign", "value": "true" } ]
    },
    "widget_landscape_{index}": {
      "note": "Include conditions (Grid's Spotlight overlay): this row prefers landscape art.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_landscape}, true)", "type": "assign", "value": "true" } ]
    },
    "trailer_include_{window}": {
      "note": "Include conditions on Home (the black cover, the fades): some row plays trailers.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({autoplay}, true)", "type": "assign", "value": "true" } ]
    },
    "art_clearlogo_visible_{window}": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_clearlogo}, true)", "type": "append", "value": "{focused}" } ]
    },
    "art_{item}_visible_{window}": {
      "note": "C2's names: the focused row's art (label_multiart_widgets_*); Billboard's is Fanart, Spotlight draws the fanart chain.",
      "index": { "start": 3201 },
      "items": [ "poster", "fanart", "square" ],
      "rules": [ { "condition": "In({art}_{item}, [Posters_poster, Fanart_fanart, Spotlight_fanart, Square_square])", "type": "append", "value": "{focused}" } ]
    },
    "art_keyart_visible_{window}": {
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_keyart}, true)", "type": "append", "value": "{focused}" } ]
    },
    "art_landscape_visible_{window}": {
      "note": "Not Billboard, which never draws landscape (its slot, texture_widgets_*_fanart0): the switch is hidden there but keeps a value set on another layout.",
      "index": { "start": 3201 },
      "rules": [ { "condition": "equals({art_landscape}, true) + not equals({layout}, Billboard)", "type": "append", "value": "{focused}" } ]
    },
    "container_scrolling_{region}": {
      "note": "A Strip rail's scroll names (strip.xml): each rail window's User_Scroll_Delay latches, 5001 prev and 5002 next, as container_scrolling_primary reads them.",
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [
        { "condition": "equals({region}, infoscreen)", "type": "append", "value": "[Control.IsVisible(5001) | Control.IsVisible(5002)] + !Window.IsVisible(managevideoversions) + !Window.IsVisible(managevideoextras)" },
        { "condition": "not equals({region}, infoscreen)", "type": "append", "value": "[Control.IsVisible(5001) | Control.IsVisible(5002)] + !Window.IsVisible(managevideoversions) + !Window.IsVisible(managevideoextras) + !$EXP[container_single_{region}]" }
      ]
    },
    "container_single_{region}": {
      "note": "The focused Home row or search rail holds one item: a press or an autoscroll step wraps it onto itself and pulses OnNext, which moves nothing.",
      "templates_from": [ "widgets", "search" ],
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "[Control.HasFocus({rail_id}) + Integer.IsEqual(Container({rail_id}).NumItems,1)]" } ]
    },
    "container_scrolling_widgets_{index}": {
      "note": "A Home row's own scroll names (strip.xml, billboard.xml, reel.xml, through Home_Row_Layout's region): Home's latches, held for every row, while the row's own move latch holds too (widgets_move_latches), so a row reached during another row's latch stays still.",
      "index": { "start": 3201 },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "rules": [ { "type": "append", "value": "$EXP[container_scrolling_widgets] + Control.IsVisible({index+2102})" } ]
    },
    "container_scrolling_widgets_{index}_next": {
      "index": { "start": 3201 },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "rules": [ { "type": "append", "value": "Control.IsVisible(5002) + Control.IsVisible({index+2102})" } ]
    },
    "container_scrolling_widgets_{index}_prev": {
      "index": { "start": 3201 },
      "filter": "In({widget_preset}, [in_progress, next_up, latest_movies, random_movies, latest_tvshows, random_tvshows, latest_albums, recent_albums, random_albums, liked_songs, favourites, custom])",
      "rules": [ { "type": "append", "value": "Control.IsVisible(5001) + Control.IsVisible({index+2102})" } ]
    },
    "container_scrolling_{region}_next": {
      "note": "Home's rows read their own (container_scrolling_widgets_{index}_next, _prev).",
      "templates_from": [ "search", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Control.IsVisible(5002)" } ]
    },
    "container_scrolling_{region}_prev": {
      "templates_from": [ "search", "infoscreen" ],
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Control.IsVisible(5001)" } ]
    },
    "Widget_HasLogo_{window}": {
      "note": "Kodi's list 50 in the info dialogs never had a row here.",
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "filter": "not equals({rail_id}, 50)",
      "rules": [ { "type": "append", "value": "$EXP[Widget_HasLogo_{window}_{index}]" } ]
    },
    "Widget_HasLogo_{window}_{index}": {
      "templates_from": [ "widgets", "search", "infoscreen" ],
      "index": { "start": 3201 },
      "filter": "not equals({rail_id}, 50)",
      "rules": [
        {
          "type": "assign",
          "value": "Control.HasFocus({rail_id}) + [String.IsEqual(Container({rail_id}).ListItem.DBType,movie) | String.IsEqual(Container({rail_id}).ListItem.DBType,set) | String.IsEqual(Container({rail_id}).ListItem.DBType,tvshow) | String.IsEqual(Container({rail_id}).ListItem.DBType,artist)] + !String.IsEmpty(Container({rail_id}).ListItem.Art(clearlogo))"
        }
      ]
    },
    "Clearlogo_Served_Home": {
      "note": "9300 was served for the focused row: its bind names the item it served (Property(item)), as an info dialog's close ring does too, whose current is its token; or (C2's) a load ring's serve, which names no item, while its token stands.",
      "index": { "start": 3201 },
      "rules": [
        { "type": "append", "value": "[Control.HasFocus({index}) + [String.StartsWith(Container(9300).ListItem.Property(item),{index}/) | [String.IsEmpty(Container(9300).ListItem.Property(item)) + !String.IsEmpty(Window(home).Property(artwork_item_primary)) + !String.IsEmpty(Window(home).Property(moved_primary)) + String.IsEqual(Container(9300).ListItem.Property(current),Window(home).Property(moved_primary))]]]" }
      ]
    },
    "widgets_container_switching": {
      "note": "The probe 5200 reads this, so Timers.xml can (Timers.xml takes no $EXP): SkinTimerManager.cpp:73 registers the raw text.",
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "[Control.HasFocus({index}) + Control.IsVisible({index+2002})]" } ]
    },
    "widgets_home_hasfocus": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Control.HasFocus({index})" } ]
    },
    "widgets_home_onprevious": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Container({index}).OnPrevious" } ]
    },
    "widgets_home_onnext": {
      "index": { "start": 3201 },
      "rules": [ { "type": "append", "value": "Container({index}).OnNext" } ]
    }
  }
}
