{
  "mapping": "content_types",
  "expressions": {
    "layout_{item}_include_{window}": {
      "items": [ "list", "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "assign",
          "value": "true"
        }
      ],
      "fallback_key": "window",
      "fallbacks": {
        "*": {
          "target_item": "list",
          "value": "true"
        }
      }
    },
    "layout_{item}_include_media": {
      "items": [ "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "append",
          "value": "{@windows:{window}.window_visible}"
        }
      ]
    },
    "layout_{item}_visible_{window}": {
      "items": [ "list", "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "append",
          "value": "{condition}"
        }
      ],
      "fallback_key": "window",
      "fallbacks": {
        "*": {
          "target_item": "list",
          "value": "invert()"
        }
      }
    },
    "display_{item}_include_strip_{window}": {
      "note": "Include conditions: some content type in this window shows Strip with this art (vue_strip), so only that art's vue loads.",
      "items": [ "posters", "fanart", "square" ],
      "rules": [
        {
          "condition": "equals({layout}, strip) + equals({display}, {item})",
          "type": "assign",
          "value": "true"
        }
      ]
    },
    "display_{item}_visible": {
      "items": [ "background", "thumbnails", "posters", "fanart", "square" ],
      "rules": [
        {
          "condition": "equals({display}, {item})",
          "type": "append",
          "value": "{condition}"
        },
        {
          "condition": "In({display}, [posters, fanart, square]) + equals({item}, background) + In({content_type}, [movies, sets, tvshows, seasons, episodes, artists, musicvideos])",
          "type": "append",
          "value": "{condition}"
        },
        {
          "condition": "In({display}, [posters, fanart, square]) + equals({item}, thumbnails) + not In({content_type}, [movies, sets, tvshows, seasons, episodes, artists, musicvideos])",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "details_{item}_visible": {
      "items": [ "off", "breadcrumb", "title", "info", "plot", "all", "title_overlay", "info_overlay" ],
      "rules": [
        {
          "condition": "equals({details}, {item})",
          "type": "append",
          "value": "{condition}"
        },
        {
          "condition": "In({details}, [bio, review, description]) + equals({item}, plot)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "details_list_info_visible": {
      "rules": [
        {
          "condition": "equals({details}, info)",
          "type": "append",
          "value": "{condition}"
        },
        {
          "condition": "not equals({layout}, list) + equals({content_type}, musicvideos)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "flags_{item}_visible": {
      "items": [ "studio", "rating", "all" ],
      "rules": [
        {
          "condition": "equals({flags}, {item})",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "logo_on_visible": {
      "rules": [
        {
          "condition": "equals({logo}, on)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "art_keyart_visible": {
      "note": "The visible window's art_keyart_visible_{window}, for art shared by every media window (texture_primary_*).",
      "rules": [
        {
          "condition": "equals({art_keyart}, true) + In({layout}, [list, showcase, strip, grid])",
          "type": "append",
          "value": "[{@windows:{window}.window_visible} + $EXP[art_keyart_visible_{window}]]"
        }
      ]
    },
    "art_keyart_visible_{window}": {
      "rules": [
        {
          "condition": "equals({art_keyart}, true) + In({layout}, [list, showcase, strip, grid])",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "art_landscape_visible": {
      "note": "The visible window's art_landscape_visible_{window}, for art shared by every media window (texture_primary_*).",
      "rules": [
        {
          "condition": "equals({art_landscape}, true) + In({layout}, [strip, grid])",
          "type": "append",
          "value": "[{@windows:{window}.window_visible} + $EXP[art_landscape_visible_{window}]]"
        }
      ]
    },
    "art_landscape_visible_{window}": {
      "rules": [
        {
          "condition": "equals({art_landscape}, true) + In({layout}, [strip, grid])",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "trailer_include_{window}": {
      "note": "Include conditions: some kind of item in this window plays trailers (btn_trailer, the black cover, the fades).",
      "rules": [
        {
          "condition": "equals({trailer}, true)",
          "type": "assign",
          "value": "true"
        }
      ]
    },
    "trailer_visible_{window}": {
      "note": "btn_trailer's enabled: the shown kind of item plays trailers.",
      "rules": [
        {
          "condition": "equals({trailer}, true)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    }
  }
}
