{
  "mapping": "content_types",
  "expressions": {
    "layout_{item}_include_{window}": {
      "items": [ "list", "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "assign",
          "value": "true"
        }
      ],
      "fallback_key": "window",
      "fallbacks": {
        "*": {
          "target_item": "list",
          "value": "true"
        }
      }
    },
    "layout_{item}_include_media": {
      "items": [ "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "append",
          "value": "{@windows:{window}.window_visible}"
        }
      ]
    },
    "layout_{item}_visible_{window}": {
      "items": [ "list", "billboard", "showcase", "strip", "grid" ],
      "rules": [
        {
          "condition": "equals({layout}, {item})",
          "type": "append",
          "value": "{condition}"
        }
      ],
      "fallback_key": "window",
      "fallbacks": {
        "*": {
          "target_item": "list",
          "value": "invert()"
        }
      }
    },
    "display_{item}_visible": {
      "items": [ "background", "thumbnails" ],
      "rules": [
        {
          "condition": "equals({display}, {item})",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "details_{item}_visible": {
      "items": [ "title", "info", "plot", "all" ],
      "rules": [
        {
          "condition": "equals({details}, {item})",
          "type": "append",
          "value": "{condition}"
        },
        {
          "condition": "equals({details}, bio) + equals({item}, plot)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "flags_{item}_visible": {
      "items": [ "studio", "rating", "all" ],
      "rules": [
        {
          "condition": "equals({flags}, {item})",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "logo_on_visible": {
      "rules": [
        {
          "condition": "equals({logo}, on)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "art_keyart_visible_{window}": {
      "rules": [
        {
          "condition": "equals({art_keyart}, true)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    },
    "art_landscape_visible_{window}": {
      "rules": [
        {
          "condition": "equals({art_landscape}, true)",
          "type": "append",
          "value": "{condition}"
        }
      ]
    }
  }
}
